\"","kind":"punctuation"},{"text":": ","kind":"punctuation"},{"text":"\"/formule/pause-cafe\"","kind":"punctuation"},{"text":" },","kind":"punctuation"}]},{"tokens":[{"text":"    {","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"\"type\"","kind":"punctuation"},{"text":": ","kind":"punctuation"},{"text":"\"expect\"","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"\"level\"","kind":"punctuation"},{"text":": ","kind":"punctuation"},{"text":"\"essential\"","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"\"condition\"","kind":"punctuation"},{"text":": {","kind":"punctuation"}]},{"tokens":[{"text":"        "},{"text":"\"address\"","kind":"punctuation"},{"text":": ","kind":"punctuation"},{"text":"\"service:composition / state:selection\"","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"        "},{"text":"\"path\"","kind":"punctuation"},{"text":": ","kind":"punctuation"},{"text":"\"items\"","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"        "},{"text":"\"equals\"","kind":"punctuation"},{"text":": [","kind":"punctuation"},{"text":"\"croissant\"","kind":"punctuation"},{"text":", ","kind":"punctuation"},{"text":"\"donut\"","kind":"punctuation"},{"text":"]","kind":"punctuation"}]},{"tokens":[{"text":"      }","kind":"punctuation"}]},{"tokens":[{"text":"    },","kind":"punctuation"}]},{"tokens":[{"text":"    {","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"\"type\"","kind":"punctuation"},{"text":": ","kind":"punctuation"},{"text":"\"checkpoint\"","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"\"ttlMs\"","kind":"punctuation"},{"text":": ","kind":"punctuation"},{"text":"1800000","kind":"number"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"\"ttlReason\"","kind":"punctuation"},{"text":": ","kind":"punctuation"},{"text":"\"Le point dépend de la session de connexion.\"","kind":"punctuation"}]},{"tokens":[{"text":"    }","kind":"punctuation"}]},{"tokens":[{"text":"  ]","kind":"punctuation"}]},{"tokens":[{"text":"}","kind":"punctuation"}]}],"filename":"","language":"json","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The checkpoint step captures the successful result and links it to the saved"},{"t":"text","text":" "},{"t":"text","text":"recipe automatically. On a later open, a valid snapshot restores immediately;"},{"t":"text","text":" "},{"t":"text","text":"an expired session starts the same recipe at "},{"t":"code","text":"/connexion"},{"t":"text","text":", waits for the person,"},{"t":"text","text":" "},{"t":"text","text":"then verifies the selected items again."}]},{"t":"paragraph","children":[{"t":"text","text":"Limits: "},{"t":"code","text":"HttpOnly"},{"t":"text","text":" cookies are not captured, and a value that is not JSON"},{"t":"text","text":" "},{"t":"text","text":"("},{"t":"code","text":"Date"},{"t":"text","text":", "},{"t":"code","text":"Map"},{"t":"text","text":") loses its shape in a point."}]},{"t":"paragraph","children":[{"t":"text","text":"The end-to-end demonstration in "},{"t":"code","text":"apps/demo-ecommerce/e2e/guided-resume.spec.ts"},{"t":"text","text":" "},{"t":"text","text":"uses this full path: the recipe opens the login page, pauses for a human sign-in,"},{"t":"text","text":" "},{"t":"text","text":"continues the admin scenario, checks its essential state, and creates a linked"},{"t":"text","text":" "},{"t":"text","text":"checkpoint. It also runs the recipe again without another sign-in, reopens the"},{"t":"text","text":" "},{"t":"text","text":"valid snapshot without an agent, reports a failed probe, and simulates expiry"},{"t":"text","text":" "},{"t":"text","text":"to show the linked recipe returning to the login hand-off before it continues."}]}],"outline":[{"level":2,"id":"what-the-person-does","text":"What the person does"},{"level":2,"id":"install","text":"Install"},{"level":2,"id":"tools","text":"Tools"},{"level":2,"id":"safety","text":"Safety"},{"level":2,"id":"resume-points","text":"Resume points"},{"level":2,"id":"resume-recipes","text":"Resume recipes"}]}