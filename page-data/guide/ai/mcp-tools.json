{"kind":"doc","route":"/guide/ai/mcp-tools","title":"MCP tools","blocks":[{"t":"heading","level":1,"id":"mcp-tools","children":[{"t":"text","text":"MCP tools"}]},{"t":"paragraph","children":[{"t":"text","text":"CraftTS exposes separate MCP servers for documentation, a running application,"},{"t":"text","text":" "},{"t":"text","text":"local logs, and the static dependency graph. Connect only the server required"},{"t":"text","text":" "},{"t":"text","text":"for the task."}]},{"t":"heading","level":2,"id":"documentation-mcp-craft-ts-mcp","children":[{"t":"text","text":"Documentation MCP: "},{"t":"code","text":"@craft-ts/mcp"}]},{"t":"paragraph","children":[{"t":"text","text":"Install it in an application or run it without adding a dependency:"}]},{"t":"code","lines":[{"tokens":[{"text":"npm","kind":"function"},{"text":" "},{"text":"install","kind":"string"},{"text":" "},{"text":"-D","kind":"string"},{"text":" "},{"text":"@craft-ts/mcp@beta","kind":"string"}]},{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"-y","kind":"string"},{"text":" "},{"text":"@craft-ts/mcp@beta","kind":"string"}]}],"filename":"","language":"bash","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Register it in "},{"t":"code","text":".mcp.json"},{"t":"text","text":":"}]},{"t":"code","lines":[{"tokens":[{"text":"{","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"\"mcpServers\"","kind":"punctuation"},{"text":": {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"\"craft-ts\"","kind":"punctuation"},{"text":": {","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"\"command\"","kind":"punctuation"},{"text":": ","kind":"punctuation"},{"text":"\"npx\"","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"\"args\"","kind":"punctuation"},{"text":": [","kind":"punctuation"},{"text":"\"-y\"","kind":"punctuation"},{"text":", ","kind":"punctuation"},{"text":"\"@craft-ts/mcp@beta\"","kind":"punctuation"},{"text":"]","kind":"punctuation"}]},{"tokens":[{"text":"    }","kind":"punctuation"}]},{"tokens":[{"text":"  }","kind":"punctuation"}]},{"tokens":[{"text":"}","kind":"punctuation"}]}],"filename":"","language":"json","numbered":false,"firstLine":1},{"t":"table","head":[[{"t":"text","text":"Tool"}],[{"t":"text","text":"Purpose"}]],"rows":[[[{"t":"code","text":"get_best_practices"}],[{"t":"text","text":"Load CraftTS rules and the "},{"t":"code","text":"AGENTS.md"},{"t":"text","text":" snippet"}]],[[{"t":"code","text":"search_documentation"}],[{"t":"text","text":"Search Learn, Guide, Reference, Resources, or examples"}]],[[{"t":"code","text":"get_documentation_page"}],[{"t":"text","text":"Read one documentation page as Markdown"}]],[[{"t":"code","text":"find_examples"}],[{"t":"text","text":"Find tutorial and demo examples for a task"}]],[[{"t":"code","text":"list_skills"}],[{"t":"text","text":"List the Agent Skills shipped with the package"}]],[[{"t":"code","text":"get_skill"}],[{"t":"text","text":"Load a skill or one of its reference files"}]],[[{"t":"code","text":"get_llms_txt"}],[{"t":"text","text":"Get the public "},{"t":"code","text":"llms.txt"},{"t":"text","text":" URLs and bundled page index"}]]]},{"t":"paragraph","children":[{"t":"text","text":"This server is read-only and searches the documentation bundled at publish"},{"t":"text","text":" "},{"t":"text","text":"time. It is the right starting point when an agent needs to understand the"},{"t":"text","text":" "},{"t":"text","text":"CraftTS API or conventions."}]},{"t":"heading","level":2,"id":"live-page-and-registry-mcp","children":[{"t":"text","text":"Live page and registry MCP"}]},{"t":"paragraph","children":[{"t":"code","text":"@craft-ts/function-registry-mcp"},{"t":"text","text":" connects over stdio to an MCP client and over"},{"t":"text","text":" "},{"t":"text","text":"WebSocket to the running development tab:"}]},{"t":"code","lines":[{"tokens":[{"text":"npm","kind":"function"},{"text":" "},{"text":"run","kind":"string"},{"text":" "},{"text":"registry:mcp","kind":"string"}]}],"filename":"","language":"bash","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The "},{"t":"link","href":"/craft/guide/ai/dev-page","external":false,"children":[{"t":"text","text":"Live page MCP"}]},{"t":"text","text":" page explains the named-control"},{"t":"text","text":" "},{"t":"text","text":"contract, client selection, and "},{"t":"code","text":"page"},{"t":"text","text":" actions."}]},{"t":"heading","level":3,"id":"browser-surface","children":[{"t":"text","text":"Browser surface"}]},{"t":"table","head":[[{"t":"text","text":"Tool"}],[{"t":"text","text":"Purpose"}]],"rows":[[[{"t":"code","text":"page"}],[{"t":"text","text":"Read named controls, then "},{"t":"code","text":"goto"},{"t":"text","text":", "},{"t":"code","text":"fill"},{"t":"text","text":", "},{"t":"code","text":"click"},{"t":"text","text":", or "},{"t":"code","text":"press"},{"t":"text","text":" and return the new state"}]],[[{"t":"code","text":"registry.clients"}],[{"t":"text","text":"List connected tabs and their "},{"t":"code","text":"ready"},{"t":"text","text":", "},{"t":"code","text":"connecting"},{"t":"text","text":", or "},{"t":"code","text":"reloading"},{"t":"text","text":" state"}]]]},{"t":"paragraph","children":[{"t":"text","text":"If multiple tabs are ready, pass the explicit "},{"t":"code","text":"clientId"},{"t":"text","text":". Never guess based on"},{"t":"text","text":" "},{"t":"text","text":"which tab connected most recently."}]},{"t":"heading","level":3,"id":"registry-surface","children":[{"t":"text","text":"Registry surface"}]},{"t":"table","head":[[{"t":"text","text":"Tool"}],[{"t":"text","text":"Purpose"}]],"rows":[[[{"t":"code","text":"registry.list"}],[{"t":"text","text":"List active registry entries"}]],[[{"t":"code","text":"registry.get"}],[{"t":"text","text":"Read one registry entry"}]],[[{"t":"code","text":"registry.call"}],[{"t":"text","text":"Invoke an active registry entry"}]],[[{"t":"code","text":"registry.logs"}],[{"t":"text","text":"Read registry and bridge events"}]],[[{"t":"code","text":"registry.override"}],[{"t":"text","text":"Replace a primitive method at runtime for development"}]],[[{"t":"code","text":"registry.restore"}],[{"t":"text","text":"Remove a runtime override"}]],[[{"t":"code","text":"registry.<primitive>.*"}],[{"t":"text","text":"Read or mutate "},{"t":"code","text":"query"},{"t":"text","text":", "},{"t":"code","text":"mutation"},{"t":"text","text":", "},{"t":"code","text":"asyncProcess"},{"t":"text","text":", and "},{"t":"code","text":"queryParams"},{"t":"text","text":" values"}]]]},{"t":"paragraph","children":[{"t":"text","text":"The primitive-specific tools are:"}]},{"t":"code","lines":[{"tokens":[{"text":"registry.query.get / set / update / patch"}]},{"tokens":[{"text":"registry.mutation.get / set / update / patch"}]},{"tokens":[{"text":"registry.asyncProcess.get / set / update / patch"}]},{"tokens":[{"text":"registry.queryParams.get / set / update / patch"}]}],"filename":"","language":"","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"query"},{"t":"text","text":", "},{"t":"code","text":"mutation"},{"t":"text","text":", and "},{"t":"code","text":"asyncProcess"},{"t":"text","text":" support an optional "},{"t":"code","text":"id"},{"t":"text","text":" for grouped"},{"t":"text","text":" "},{"t":"text","text":"instances. "},{"t":"code","text":"queryParams"},{"t":"text","text":" does not use grouped instance IDs. Runtime overrides"},{"t":"text","text":" "},{"t":"text","text":"and mutating value tools are development-only operations and should never be"},{"t":"text","text":" "},{"t":"text","text":"connected to an untrusted or production browser."}]},{"t":"heading","level":2,"id":"logs-mcp-craft-ts-log-mcp","children":[{"t":"text","text":"Logs MCP: "},{"t":"code","text":"@craft-ts/log-mcp"}]},{"t":"paragraph","children":[{"t":"text","text":"The logs server reads JSONL files written by the Craft log server. It does not"},{"t":"text","text":" "},{"t":"text","text":"talk to the browser or ingest logs itself:"}]},{"t":"code","lines":[{"tokens":[{"text":"npm","kind":"function"},{"text":" "},{"text":"run","kind":"string"},{"text":" "},{"text":"logs:mcp","kind":"string"}]}],"filename":"","language":"bash","numbered":false,"firstLine":1},{"t":"table","head":[[{"t":"text","text":"Tool"}],[{"t":"text","text":"Purpose"}]],"rows":[[[{"t":"code","text":"logs.stats"}],[{"t":"text","text":"Summarise levels, host tags, client IDs, files, and time range"}]],[[{"t":"code","text":"logs.search"}],[{"t":"text","text":"Filter by text, level, host ancestry, correlation ID, client, or time range"}]],[[{"t":"code","text":"logs.tail"}],[{"t":"text","text":"Read the most recent entries"}]],[[{"t":"code","text":"logs.clear"}],[{"t":"text","text":"Delete all active and rotated log files"}]]]},{"t":"paragraph","children":[{"t":"text","text":"Use "},{"t":"code","text":"logs.stats"},{"t":"text","text":" before "},{"t":"code","text":"logs.search"},{"t":"text","text":" to understand what is available. The"},{"t":"text","text":" "},{"t":"code","text":"from"},{"t":"text","text":" filter follows Craft host-tag ancestry, and "},{"t":"code","text":"correlationId"},{"t":"text","text":" finds all"},{"t":"text","text":" "},{"t":"text","text":"entries from one correlated flow."}]},{"t":"paragraph","children":[{"t":"code","text":"logs.clear"},{"t":"text","text":" is the only destructive tool in this server. Use it only when a"},{"t":"text","text":" "},{"t":"text","text":"clean reproduction is intentional."}]},{"t":"heading","level":2,"id":"graph-mcp-craft-ts-graph-mcp","children":[{"t":"text","text":"Graph MCP: "},{"t":"code","text":"@craft-ts/graph-mcp"}]},{"t":"paragraph","children":[{"t":"text","text":"The graph server answers architecture questions about "},{"t":"strong","children":[{"t":"text","text":"your"}]},{"t":"text","text":" project from the"},{"t":"text","text":" "},{"t":"text","text":"same static analysis as the "},{"t":"link","href":"/craft/guide/testing/architecture","external":false,"children":[{"t":"text","text":"architecture rules"}]},{"t":"text","text":":"},{"t":"text","text":" "},{"t":"text","text":"routes, components, services, primitives and the proven relations between them."},{"t":"text","text":" "},{"t":"text","text":"It needs no running application. It reads "},{"t":"code","text":"craft-dependency-graph.json"},{"t":"text","text":" when the"},{"t":"text","text":" "},{"t":"text","text":"file exists and otherwise analyses the TypeScript program."}]},{"t":"code","lines":[{"tokens":[{"text":"npm","kind":"function"},{"text":" "},{"text":"install","kind":"string"},{"text":" "},{"text":"-D","kind":"string"},{"text":" "},{"text":"@craft-ts/graph-mcp","kind":"string"}]}],"filename":"","language":"bash","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Projects created with "},{"t":"code","text":"craft create"},{"t":"text","text":" already register it. In an existing"},{"t":"text","text":" "},{"t":"text","text":"project, add it to "},{"t":"code","text":".mcp.json"},{"t":"text","text":":"}]},{"t":"code","lines":[{"tokens":[{"text":"{","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"\"mcpServers\"","kind":"punctuation"},{"text":": {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"\"craft-ts-graph\"","kind":"punctuation"},{"text":": { ","kind":"punctuation"},{"text":"\"command\"","kind":"punctuation"},{"text":": ","kind":"punctuation"},{"text":"\"npx\"","kind":"punctuation"},{"text":", ","kind":"punctuation"},{"text":"\"args\"","kind":"punctuation"},{"text":": [","kind":"punctuation"},{"text":"\"craft-ts-graph-mcp\"","kind":"punctuation"},{"text":"] }","kind":"punctuation"}]},{"tokens":[{"text":"  }","kind":"punctuation"}]},{"tokens":[{"text":"}","kind":"punctuation"}]}],"filename":"","language":"json","numbered":false,"firstLine":1},{"t":"table","head":[[{"t":"text","text":"Tool"}],[{"t":"text","text":"Purpose"}]],"rows":[[[{"t":"code","text":"graph.status"}],[{"t":"text","text":"Source and build time of the graph, counts per kind, diagnostics"}]],[[{"t":"code","text":"graph.rebuild"}],[{"t":"text","text":"Re-analyse the program and overwrite the graph file"}]],[[{"t":"code","text":"graph.search"}],[{"t":"text","text":"Find nodes by label or id"}]],[[{"t":"code","text":"graph.node"}],[{"t":"text","text":"One node: metrics, relations with their proofs, optionally its source"}]],[[{"t":"code","text":"graph.neighbors"}],[{"t":"text","text":"The subgraph around a node, up to three relations away"}]],[[{"t":"code","text":"graph.path"}],[{"t":"text","text":"The shortest relation chains between two nodes"}]],[[{"t":"code","text":"graph.impact"}],[{"t":"text","text":"Every node whose output may change when this node changes"}]],[[{"t":"code","text":"graph.hotspots"}],[{"t":"text","text":"God nodes and hotspots, optionally weighted by git churn"}]],[[{"t":"code","text":"graph.report"}],[{"t":"text","text":"The "},{"t":"link","href":"/craft/guide/testing/graph-insights#report","external":false,"children":[{"t":"text","text":"graph report"}]},{"t":"text","text":" as JSON"}]],[[{"t":"code","text":"graph.violations"}],[{"t":"text","text":"The rules "},{"t":"code","text":"assertArchitecture"},{"t":"text","text":" enforces, by name, with their messages"}]]]},{"t":"paragraph","children":[{"t":"text","text":"Every answer carries "},{"t":"code","text":"stale"},{"t":"text","text":": "},{"t":"code","text":"true"},{"t":"text","text":" when a source file changed after the graph"},{"t":"text","text":" "},{"t":"text","text":"was built, "},{"t":"code","text":"unknown"},{"t":"text","text":" when no tsconfig is available to check. An agent calls"},{"t":"text","text":" "},{"t":"code","text":"graph.rebuild"},{"t":"text","text":" before answering about recent code."}]},{"t":"table","head":[[{"t":"text","text":"Variable"}],[{"t":"text","text":"Default"}]],"rows":[[[{"t":"code","text":"CRAFT_GRAPH_ROOT"}],[{"t":"text","text":"The current directory"}]],[[{"t":"code","text":"CRAFT_GRAPH_TSCONFIG"}],[{"t":"text","text":"First of "},{"t":"code","text":"tsconfig.graph.json"},{"t":"text","text":", "},{"t":"code","text":"tsconfig.app.json"},{"t":"text","text":", "},{"t":"code","text":"tsconfig.json"}]],[[{"t":"code","text":"CRAFT_GRAPH_FILE"}],[{"t":"code","text":"craft-dependency-graph.json"}]],[[{"t":"code","text":"CRAFT_GRAPH_COVERAGE"}],[{"t":"text","text":"Unset; a "},{"t":"code","text":"coverage-final.json"},{"t":"text","text":" to attach coverage per node and route"}]],[[{"t":"code","text":"CRAFT_GRAPH_DOCS"}],[{"t":"text","text":"Unset; comma-separated Markdown globs linked to the nodes they cite"}]],[[{"t":"code","text":"CRAFT_GRAPH_READONLY"}],[{"t":"text","text":"Unset; "},{"t":"code","text":"1"},{"t":"text","text":" removes "},{"t":"code","text":"graph.rebuild"},{"t":"text","text":", for CI or shared environments"}]]]},{"t":"paragraph","children":[{"t":"text","text":"All tools except "},{"t":"code","text":"graph.rebuild"},{"t":"text","text":" are read-only, and "},{"t":"code","text":"graph.rebuild"},{"t":"text","text":" only writes"},{"t":"text","text":" "},{"t":"text","text":"the graph file."}]},{"t":"heading","level":3,"id":"projects-created-earlier","children":[{"t":"text","text":"Projects created earlier"}]},{"t":"paragraph","children":[{"t":"code","text":"craft agents sync"},{"t":"text","text":" adds today's agent wiring to a project generated by an"},{"t":"text","text":" "},{"t":"text","text":"older CraftTS:"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft","kind":"string"},{"text":" "},{"text":"agents","kind":"string"},{"text":" "},{"text":"sync","kind":"string"},{"text":" "},{"text":"--dry-run","kind":"string"},{"text":"   "},{"text":"# list what would change","kind":"comment"}]},{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft","kind":"string"},{"text":" "},{"text":"agents","kind":"string"},{"text":" "},{"text":"sync","kind":"string"}]},{"tokens":[{"text":"npm","kind":"function"},{"text":" "},{"text":"install","kind":"string"},{"text":" && ","kind":"punctuation"},{"text":"npm","kind":"function"},{"text":" "},{"text":"run","kind":"string"},{"text":" "},{"text":"graph","kind":"string"}]}],"filename":"","language":"bash","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"It adds the skills and hooks of the agents the project already uses (detected"},{"t":"text","text":" "},{"t":"text","text":"from "},{"t":"code","text":".agents/"},{"t":"text","text":", "},{"t":"code","text":".claude/"},{"t":"text","text":", "},{"t":"code","text":".cursor/"},{"t":"text","text":" and "},{"t":"code","text":".gemini/"},{"t":"text","text":", or named with"},{"t":"text","text":" "},{"t":"code","text":"--agents"},{"t":"text","text":"), registers the graph server in "},{"t":"code","text":".mcp.json"},{"t":"text","text":" without touching the"},{"t":"text","text":" "},{"t":"text","text":"servers already there, adds the "},{"t":"code","text":"graph"},{"t":"text","text":" and "},{"t":"code","text":"graph:mcp"},{"t":"text","text":" scripts and the"},{"t":"text","text":" "},{"t":"text","text":"dependency, and ignores the graph output. It never writes application code, and"},{"t":"text","text":" "},{"t":"text","text":"a second run reports that nothing changed."}]},{"t":"paragraph","children":[{"t":"text","text":"Do not use "},{"t":"code","text":"craft create --force"},{"t":"text","text":" for this: it rewrites every generated file,"},{"t":"text","text":" "},{"t":"code","text":"src/"},{"t":"text","text":" included."}]},{"t":"heading","level":2,"id":"which-server-should-an-agent-use","children":[{"t":"text","text":"Which server should an agent use?"}]},{"t":"table","head":[[{"t":"text","text":"Situation"}],[{"t":"text","text":"Server"}]],"rows":[[[{"t":"text","text":"“How should I write this Craft code?”"}],[{"t":"text","text":"Documentation MCP"}]],[[{"t":"text","text":"“What is visible on the running page?”"}],[{"t":"text","text":"Function registry MCP → "},{"t":"code","text":"page"}]],[[{"t":"text","text":"“What value does this query have?”"}],[{"t":"text","text":"Function registry MCP → "},{"t":"code","text":"registry.query.get"}]],[[{"t":"text","text":"“What happened during this flow?”"}],[{"t":"text","text":"Logs MCP → "},{"t":"code","text":"logs.stats"},{"t":"text","text":", then "},{"t":"code","text":"logs.search"}]],[[{"t":"text","text":"“What does this service depend on?”"}],[{"t":"text","text":"Graph MCP → "},{"t":"code","text":"graph.search"},{"t":"text","text":", then "},{"t":"code","text":"graph.node"}]],[[{"t":"text","text":"“What can this change break?”"}],[{"t":"text","text":"Graph MCP → "},{"t":"code","text":"graph.impact"}]],[[{"t":"text","text":"“What context should I send to an AI?”"}],[{"t":"code","text":"provideSendContextToAi"},{"t":"text","text":", then copy or send the payload"}]]]}],"outline":[{"level":2,"id":"documentation-mcp-craft-ts-mcp","text":"Documentation MCP: @craft-ts/mcp"},{"level":2,"id":"live-page-and-registry-mcp","text":"Live page and registry MCP"},{"level":3,"id":"browser-surface","text":"Browser surface"},{"level":3,"id":"registry-surface","text":"Registry surface"},{"level":2,"id":"logs-mcp-craft-ts-log-mcp","text":"Logs MCP: @craft-ts/log-mcp"},{"level":2,"id":"graph-mcp-craft-ts-graph-mcp","text":"Graph MCP: @craft-ts/graph-mcp"},{"level":3,"id":"projects-created-earlier","text":"Projects created earlier"},{"level":2,"id":"which-server-should-an-agent-use","text":"Which server should an agent use?"}]}