ssertroutediproofs","external":false,"children":[{"t":"text","text":"Architecture tests"}]},{"t":"text","text":" keep that"},{"t":"text","text":" "},{"t":"text","text":"check from quietly disappearing — a "},{"t":"code","text":"CanRun"},{"t":"text","text":" alias that nobody references still"},{"t":"text","text":" "},{"t":"text","text":"compiles."}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Exposing the whole world."}]},{"t":"text","text":" What a service yields is its API. Keep what"},{"t":"text","text":" "},{"t":"text","text":"consumers do not need in "},{"t":"code","text":"craftPrivate(...)"},{"t":"text","text":"; consumers that need more can"},{"t":"text","text":" "},{"t":"text","text":"yield more."}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Using "},{"t":"code","text":"craftExpose"},{"t":"text","text":" for a same-name service value."}]},{"t":"text","text":" Yield the service or its"},{"t":"text","text":" "},{"t":"text","text":"property directly ("},{"t":"code","text":"yield* ClientCurrency()"},{"t":"text","text":" or "},{"t":"code","text":"yield* I18n.language()"},{"t":"text","text":"). The"},{"t":"text","text":" "},{"t":"code","text":"craft-ts/prefer-direct-craft-service-exposure"},{"t":"text","text":" rule reports wrappers that only"},{"t":"text","text":" "},{"t":"text","text":"repeat that name, including a dependency wrapped in "},{"t":"code","text":"craftPrivate(...)"},{"t":"text","text":" before"},{"t":"text","text":" "},{"t":"text","text":"being exposed. Keep "},{"t":"code","text":"craftExpose"},{"t":"text","text":" for standalone or computed values. A member"},{"t":"text","text":" "},{"t":"text","text":"already returned by a public primitive cannot be re-exposed under another"},{"t":"text","text":" "},{"t":"text","text":"name; consumers should keep using its nested path."}]},{"t":"paragraph","children":[{"t":"text","text":"The same rule rejects "},{"t":"code","text":"craftExpose"},{"t":"text","text":" inside "},{"t":"code","text":"state"},{"t":"text","text":", "},{"t":"code","text":"queryParams"},{"t":"text","text":", "},{"t":"code","text":"mutation"},{"t":"text","text":","},{"t":"text","text":" "},{"t":"code","text":"query"},{"t":"text","text":", and "},{"t":"code","text":"asyncProcess"},{"t":"text","text":" declarations or callbacks. Declare and yield"},{"t":"text","text":" "},{"t":"text","text":"services and primitives in the "},{"t":"code","text":"craftService"},{"t":"text","text":" generator body so their public"},{"t":"text","text":" "},{"t":"text","text":"names and dependencies stay visible there. A "},{"t":"code","text":"craftExpose"},{"t":"text","text":" that repeats the"},{"t":"text","text":" "},{"t":"text","text":"primitive's declared name is also redundant because the primitive is already"},{"t":"text","text":" "},{"t":"text","text":"exposed under that name."}]},{"t":"paragraph","children":[{"t":"text","text":"Members returned by a public primitive are already available below that"},{"t":"text","text":" "},{"t":"text","text":"primitive. If "},{"t":"code","text":"state('searchInput', ...)"},{"t":"text","text":" returns a "},{"t":"code","text":"setSearchInput"},{"t":"text","text":" method,"},{"t":"text","text":" "},{"t":"text","text":"consumers can use "},{"t":"code","text":"DebouncedWebSearchView.searchInput.setSearchInput(...)"},{"t":"text","text":"."},{"t":"text","text":" "},{"t":"text","text":"Do not flatten it with"},{"t":"text","text":" "},{"t":"code","text":"craftExpose('setSearchInput', searchInput.setSearchInput)"},{"t":"text","text":"; the same rule"},{"t":"text","text":" "},{"t":"text","text":"reports that duplicate path. Remove the exposure and update its callers to"},{"t":"text","text":" "},{"t":"text","text":"the nested member."}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Exposing a "},{"t":"code","text":"craftMethod"},{"t":"text","text":" to be yielded."}]},{"t":"text","text":" A "},{"t":"code","text":"craftMethod"},{"t":"text","text":" taken from a service"},{"t":"text","text":" "},{"t":"text","text":"runs when it is called. To hand consumers a generator they "},{"t":"code","text":"yield*"},{"t":"text","text":", expose the"},{"t":"text","text":" "},{"t":"code","text":"craftGen"},{"t":"text","text":" itself: "},{"t":"code","text":"yield* craftExpose('load', craftGen(function* () { … }))"},{"t":"text","text":"."}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Exposing a derived value as a generator."}]},{"t":"text","text":" A zero-argument generator whose"},{"t":"text","text":" "},{"t":"text","text":"only statement returns a value derived from "},{"t":"code","text":"yield*"},{"t":"text","text":" reads models a reactive"},{"t":"text","text":" "},{"t":"text","text":"value. Declare it directly with "},{"t":"code","text":"craftComputed"},{"t":"text","text":" instead of exposing the"},{"t":"text","text":" "},{"t":"text","text":"generator function (or wrapping it in "},{"t":"code","text":"craftGen"},{"t":"text","text":"):"}]},{"t":"code","lines":[{"tokens":[{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"craftComputed","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'system'","kind":"punctuation"},{"text":", ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"return","kind":"keyword"},{"text":" "},{"text":"DEMO_CLIENTS"},{"text":"[","kind":"punctuation"},{"text":"yield*","kind":"keyword"},{"text":" clientCurrency.","kind":"punctuation"},{"text":"client","kind":"function"},{"text":"()].units;","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"craft-ts/prefer-craft-computed-for-reactive-genera