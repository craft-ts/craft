ng"},{"text":"childComponents","kind":"function"},{"text":".","kind":"punctuation"},{"text":"total","kind":"function"},{"text":"()","kind":"punctuation"},{"text":"}`","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The main group, the additional groups and the derived properties can all be used"},{"t":"text","text":" "},{"t":"text","text":"together. Derived properties are computed once per registry injector and keep"},{"t":"text","text":" "},{"t":"text","text":"the reactive signals the groups provide."}]},{"t":"heading","level":2,"id":"registering-a-directive","children":[{"t":"text","text":"Registering a directive"}]},{"t":"paragraph","children":[{"t":"text","text":"Craft directives can be targets too:"}]},{"t":"code","lines":[{"tokens":[{"text":"const","kind":"keyword"},{"text":" { ","kind":"punctuation"},{"text":"RegisterForCounter"},{"text":" } ","kind":"punctuation"},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftRegisterFor","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'Counter'","kind":"punctuation"},{"text":", [","kind":"punctuation"}]},{"tokens":[{"text":"  CounterChild,","kind":"punctuation"}]},{"tokens":[{"text":"  CounterDebugDirective,","kind":"punctuation"}]},{"tokens":[{"text":"]);","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"const","kind":"keyword"},{"text":" "},{"text":"debugEntries"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" RegisterForCounter.","kind":"punctuation"},{"text":"CounterDebugDirective","kind":"function"},{"text":"();","kind":"punctuation"}]},{"tokens":[{"text":"debugEntries","kind":"function"},{"text":"()?.","kind":"punctuation"},{"text":"forEach","kind":"function"},{"text":"(({ ","kind":"punctuation"},{"text":"hostName"},{"text":", ","kind":"punctuation"},{"text":"ref"},{"text":" }) ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" {","kind":"punctuation"}]},{"tokens":[{"text":"  console.","kind":"punctuation"},{"text":"debug","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'directive active'","kind":"punctuation"},{"text":", hostName, ref);","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"A functional directive has no class instance, so "},{"t":"code","text":"ref"},{"t":"text","text":" is what the decorated"},{"t":"text","text":" "},{"t":"text","text":"component registered — the service it exposes. Its "},{"t":"code","text":"hostName"},{"t":"text","text":" remains specific"},{"t":"text","text":" "},{"t":"text","text":"to the directive and its instance, which is what lets you tell several identical"},{"t":"text","text":" "},{"t":"text","text":"directives apart on the same screen."}]},{"t":"heading","level":2,"id":"lifecycle-and-references","children":[{"t":"text","text":"Lifecycle and references"}]},{"t":"paragraph","children":[{"t":"text","text":"Services are registered when their yield resolves. The runtime attaches their"},{"t":"text","text":" "},{"t":"text","text":"removal to the destruction of the injector that carries them."}]},{"t":"paragraph","children":[{"t":"text","text":"Craft components and directives are functions with no class instance, so "},{"t":"code","text":"ref"},{"t":"text","text":" "},{"t":"text","text":"is what they registered. For a directive used with "},{"t":"code","text":".pipe(...)"},{"t":"text","text":", the final"},{"t":"text","text":" "},{"t":"text","text":"component's registration is exposed, because that is the execution scope the"},{"t":"text","text":" "},{"t":"text","text":"directive shares."}]},{"t":"paragraph","children":[{"t":"text","text":"Every Craft component automatically gets a host tag of the form"},{"t":"text","text":" "},{"t":"code","text":"component:<ComponentName>#<id>"},{"t":"text","text":", so "},{"t":"code","text":"provideHostName"},{"t":"text","text":" is not needed in a"},{"t":"text","text":" "},{"t":"text","text":"component's providers — it stays useful only to override that automatic name."},{"t":"text","text":" "},{"t":"text","text":"Directives applied to an element get their own "},{"t":"code","text":"hostName"},{"t":"text","text":", generated from the"},{"t":"text","text":" "},{"t":"text","text":"directive name and an instance id. These names distinguish two identical"},{"t":"text","text":" "},{"t":"text","text":"instances and are usable for diagnostics and observability."}]},{"t":"paragraph","children":[{"t":"text","text":"Entries are removed automatically in every case: destruction of the"},{"t":"text","text":" "},{"t":"text","text":"component/directive, destruction of its DI scope, or replacement of a"},{"t":"text","text":" "},{"t":"text","text":"composition."}]},{"t":"heading","level":2,"id":"pitfalls","children":[{"t":"text","text":"Pitfalls"}]},{"t":"callout","tone":"warning","caption":"An empty registry is not an error","children":[{"t":"paragraph","children":[{"t":"text","text":"Compilation checks that the target you pass to "},{"t":"code","text":"craftRegisterFor"},{"t":"text","text":" is a valid"},{"t":"text","text":" "},{"t":"text","text":"Craft service, component or directive — but it cannot check that an instance"},{"t":"text","text":" "},{"t":"text","text":"will ever be created. If no registered target exists in the executed code, there"},{"t":"text","text":" "},{"t":"text","text":"is no compile error and no runtime error: the signal is simply "},{"t":"code","text":"undefined"},{"t":"text","text":"."}]}]},{"t":"callout","tone":"warning","caption":"Craft targets only","children":[{"t":"paragraph","children":[{"t":"code","text":"craftRegisterFor"},{"t":"text","text":" does not detect arbitrary classes. It targets"},{"t":"text","text":" "},{"t":"code","text":"craftService"},{"t":"text","text":", "},{"t":"code","text":"craftComponent"},{"t":"text","text":" and "},{"t":"code","text":"craftDirective"},{"t":"text","text":", whose scope and lifecycle"},{"t":"text","text":" "},{"t":"text","text":"the runtime knows."}]}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Declaring the same target twice"}]},{"t":"text","text":" in the list is not supported — each target"},{"t":"text","text":" "},{"t":"text","text":"appears once."}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Treating the group signal as always populated."}]},{"t":"text","text":" It is "},{"t":"code","text":"undefined"},{"t":"text","text":" before the"},{"t":"text","text":" "},{"t":"text","text":"first instance and after the last one; the "},{"t":"code","text":"?."},{"t":"text","text":" is not optional."}]},{"t":"details","summary":"Extending the mechanism — target and yield wrappers","children":[{"t":"paragraph","children":[{"t":"text","text":"The registry rests on two separate pieces:"}]},{"t":"list","ordered":true,"items":[[{"t":"paragraph","children":[{"t":"text","text":"a "},{"t":"strong","children":[{"t":"text","text":"yield wrapper"}]},{"t":"text","text":" observes services as they are actually resolved;"}]}],[{"t":"paragraph","children":[{"t":"text","text":"the component/directive "},{"t":"strong","children":[{"t":"text","text":"runtime"}]},{"t":"text","text":" reports their creation and ties cleanup"},{"t":"text","text":" "},{"t":"text","text":"to their lifecycle."}]}]]},{"t":"paragraph","children":[{"t":"text","text":"The first is "},{"t":"code","text":"provideCraftTargetWrapper"},{"t":"text","text":", documented on"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/app/target-wrapper","external":false,"children":[{"t":"text","text":"Target wrapper"}]},{"t":"text","text":". The second is"},{"t":"text","text":" "},{"t":"code","text":"provideServiceYieldWrapper"},{"t":"text","text":", the low-level hook "},{"t":"code","text":"craftRegisterFor"},{"t":"text","text":" uses to wrap"},{"t":"text","text":" "},{"t":"text","text":"every Craft service resolution in the scope where the yield runs — deliberately"},{"t":"text","text":" "},{"t":"text","text":"close to "},{"t":"code","text":"provideFnWrapper"},{"t":"text","text":", but limited to service yields:"}]},{"t":"code","lines":[{"tokens":[{"text":"import","kind":"keyword"},{"text":" {","kind":"punctuation"}]},{"tokens":[{"text":"  provideServiceYieldWrapper,","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"type","kind":"keyword"},{"text":" ServiceYieldContext,","kind":"punctuation"}]},{"tokens":[{"text":"} ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'@craft-ts/core'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"function*","kind":"keyword"},{"text":" "},{"text":"reportServiceYield","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"context"},{"text":":","kind":"keyword"},{"text":" "},{"text":"ServiceYieldContext","kind":"type"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"next","kind":"function"},{"text":":","kind":"keyword"},{"text":" () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"Generator","kind":"type"},{"text":"<","kind":"punctuation"},{"text":"unknown","kind":"type"},{"text":", ","kind":"punctuation"},{"text":"unknown","kind":"type"},{"text":", ","kind":"punctuation"},{"text":"unknown","kind":"type"},{"text":">,","kind":"punctuation"}]},{"tokens":[{"text":") {","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"startedAt"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" performance.","kind":"punctuation"},{"text":"now","kind":"function"},{"text":"();","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"value"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"next","kind":"function"},{"text":"();","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"  console.","kind":"punctuation"},{"text":"debug","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'service resolved'","kind":"punctuation"},{"text":", {","kind":"punctuation"}]},{"tokens":[{"text":"    name: context.name,","kind":"punctuation"}]},{"tokens":[{"text":"    hostScope: context.hostScope,","kind":"punctuation"}]},{"tokens":[{"text":"    duration: performance.","kind":"punctuation"},{"text":"now","kind":"function"},{"text":"() ","kind":"punctuation"},{"text":"-","kind":"keyword"},{"text":" startedAt,","kind":"punctuation"}]},{"tokens":[{"text":"  });","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"  "},{"text":"return","kind":"keyword"},{"text":" value;","kind":"punctuation"}]},{"tokens":[{"text":"}","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"providers"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" [","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"provideServiceYieldWrapper","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"'Warning: the wrapper runs in the current Craft injection context.'","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"    reportServiceYield,","kind":"punctuation"}]},{"tokens":[{"text":"  ),","kind":"punctuation"}]},{"tokens":[{"text":"];","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"context.resolve()"},{"t":"text","text":" resolves the real service; "},{"t":"code","text":"next()"},{"t":"text","text":" keeps the wrapper chain"},{"t":"text","text":" "},{"t":"text","text":"intact. Wrappers compose in registration order — the first is the outermost. The"},{"t":"text","text":" "},{"t":"text","text":"context provides "},{"t":"code","text":"name"},{"t":"text","text":", "},{"t":"code","text":"scope"},{"t":"text","text":", "},{"t":"code","text":"hostScope"},{"t":"text","text":", "},{"t":"code","text":"injector"},{"t":"text","text":" and "},{"t":"code","text":"resolve"},{"t":"text","text":". Like"},{"t":"text","text":" "},{"t":"code","text":"provideFnWrapper"},{"t":"text","text":", this hook suits cross-cutting concerns — registries,"},{"t":"text","text":" "},{"t":"text","text":"metrics, traces, diagnostics — not business logic."}]},{"t":"paragraph","children":[{"t":"text","text":"A new tool can reuse "},{"t":"code","text":"provideServiceYieldWrapper"},{"t":"text","text":" to observe services without"},{"t":"text","text":" "},{"t":"code","text":"craftRegisterFor"},{"t":"text","text":" at all. For functional Craft targets the runtime also exposes"},{"t":"text","text":" "},{"t":"text","text":"its internal registration primitives, so another specialised view can be built —"},{"t":"text","text":" "},{"t":"text","text":"but "},{"t":"code","text":"craftRegisterFor"},{"t":"text","text":" stays the recommended application-level API."}]}]},{"t":"heading","level":2,"id":"see-also","children":[{"t":"text","text":"See Also"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/app/target-wrapper","external":false,"children":[{"t":"text","text":"Target wrapper"}]},{"t":"text","text":" — the extension point underneath"}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/app/craft-service","external":false,"children":[{"t":"text","text":"craftService"}]}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/components/customization","external":false,"children":[{"t":"text","text":"Customization"}]}]}]]}],"outline":[{"level":2,"id":"declaring-a-registry","text":"Declaring a registry"}