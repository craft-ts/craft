{"kind":"doc","route":"/guide/app/service-scopes","title":"Service scopes","blocks":[{"t":"heading","level":1,"id":"service-scopes","children":[{"t":"text","text":"Service scopes"}]},{"t":"paragraph","children":[{"t":"code","text":"scope"},{"t":"text","text":" decides who owns a "},{"t":"code","text":"craftService"},{"t":"text","text":" instance and how its factory receives"},{"t":"text","text":" "},{"t":"text","text":"configuration."}]},{"t":"callout","tone":"tip","caption":"Short version","children":[{"t":"paragraph","children":[{"t":"text","text":"Use "},{"t":"code","text":"toProvide"},{"t":"text","text":" for state or context owned by a component, feature, or route,"},{"t":"text","text":" "},{"t":"text","text":"even when only one component currently consumes it. Use "},{"t":"code","text":"function"},{"t":"text","text":" for reusable"},{"t":"text","text":" "},{"t":"text","text":"logic called by other services when each call should get its own inputs and"},{"t":"text","text":" "},{"t":"text","text":"service context. Use "},{"t":"code","text":"global"},{"t":"text","text":" only for an app-wide singleton."}]}]},{"t":"heading","level":2,"id":"supported-scopes","children":[{"t":"text","text":"Supported Scopes"}]},{"t":"heading","level":3,"id":"global","children":[{"t":"code","text":"global"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"singleton provided at root"}]}],[{"t":"paragraph","children":[{"t":"text","text":"factory runs when the service is first resolved, unless "},{"t":"code","text":"appStart: true"},{"t":"text","text":" makes"},{"t":"text","text":" "},{"t":"text","text":"it eager"}]}],[{"t":"paragraph","children":[{"t":"text","text":"ideal for app-wide services and shared state"}]}],[{"t":"paragraph","children":[{"t":"text","text":"no explicit "},{"t":"code","text":"provideX()"},{"t":"text","text":" helper"}]}],[{"t":"paragraph","children":[{"t":"text","text":"has no factory inputs, including "},{"t":"code","text":"$provided"}]}]]},{"t":"heading","level":3,"id":"toprovide","children":[{"t":"code","text":"toProvide"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"one instance per provider scope, created when its token is first resolved"}]}],[{"t":"paragraph","children":[{"t":"text","text":"use for mutable state or context owned by a component, feature, or route"}]}],[{"t":"paragraph","children":[{"t":"text","text":"configure it with "},{"t":"code","text":"provideX()"},{"t":"text","text":" where that owner is mounted"}]}],[{"t":"paragraph","children":[{"t":"text","text":"works well with tests that need explicit providers"}]}],[{"t":"paragraph","children":[{"t":"text","text":"accepts only "},{"t":"code","text":"$provided"},{"t":"text","text":" factory configuration; use "},{"t":"code","text":"withComponentProviders"},{"t":"text","text":" "},{"t":"text","text":"when those values come from component inputs"}]}]]},{"t":"heading","level":3,"id":"manuallyprovidedatroot","children":[{"t":"code","text":"manuallyProvidedAtRoot"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"explicit provider helper, but designed to be mounted at root"}]}],[{"t":"paragraph","children":[{"t":"text","text":"exposes the generated "},{"t":"code","text":"provideX()"},{"t":"text","text":" helper for explicit root composition"}]}],[{"t":"paragraph","children":[{"t":"text","text":"allows this scope to be yielded by global services, which is not possible"},{"t":"text","text":" "},{"t":"text","text":"with "},{"t":"code","text":"toProvide"},{"t":"text","text":" (it still requires explicit setup when testing with"},{"t":"text","text":" "},{"t":"code","text":"setupCraftServiceTestingByRegister"},{"t":"text","text":")"}]}],[{"t":"paragraph","children":[{"t":"text","text":"accepts only "},{"t":"code","text":"$provided"},{"t":"text","text":" factory configuration, supplied to "},{"t":"code","text":"provideX()"}]}]]},{"t":"heading","level":3,"id":"function","children":[{"t":"code","text":"function"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"creates a fresh service context on each "},{"t":"code","text":"X(...)"},{"t":"text","text":" helper call; no injector"},{"t":"text","text":" "},{"t":"text","text":"provider or shared cached instance"}]}],[{"t":"paragraph","children":[{"t":"text","text":"useful for reusable operations called by other services, such as a query"},{"t":"text","text":" "},{"t":"text","text":"helper that gets different parameters on each call"}]}],[{"t":"paragraph","children":[{"t":"text","text":"accepts call-site inputs only; pass every value directly to "},{"t":"code","text":"X(...)"}]}]]},{"t":"heading","level":3,"id":"abstract","children":[{"t":"code","text":"abstract"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"declares a contract without implementation"}]}],[{"t":"paragraph","children":[{"t":"text","text":"exposes a requirement token to force a concrete implementation later"}]}]]},{"t":"heading","level":2,"id":"recommendations-for-choosing-a-scope","children":[{"t":"text","text":"Recommendations For Choosing a Scope"}]},{"t":"paragraph","children":[{"t":"code","text":"provideX()"},{"t":"text","text":" registers a provider; it does not eagerly run the service factory."},{"t":"text","text":" "},{"t":"text","text":"The instance is created and cached in that injector the first time "},{"t":"code","text":"X()"},{"t":"text","text":" is"},{"t":"text","text":" "},{"t":"text","text":"resolved. "},{"t":"code","text":"appStart: true"},{"t":"text","text":" makes the service eager during app initialization."}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"Use "},{"t":"code","text":"toProvide"},{"t":"text","text":" for state that belongs to a component or route, even if the"},{"t":"text","text":" "},{"t":"text","text":"owning component is its only consumer. Put "},{"t":"code","text":"provideX()"},{"t":"text","text":" in that component's"},{"t":"text","text":" "},{"t":"text","text":"or route's providers. If configuration comes from component inputs, pass it"},{"t":"text","text":" "},{"t":"text","text":"once with "},{"t":"code","text":"withComponentProviders"},{"t":"text","text":"; consumers then call "},{"t":"code","text":"X()"},{"t":"text","text":" without"},{"t":"text","text":" "},{"t":"text","text":"repeating those values."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Use "},{"t":"code","text":"function"},{"t":"text","text":" for reusable per-call work composed by other services. Each"},{"t":"text","text":" "},{"t":"code","text":"X(inputs)"},{"t":"text","text":" call creates its own service context, so it is not a shared store"},{"t":"text","text":" "},{"t":"text","text":"for a component's state."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Be careful with "},{"t":"code","text":"toProvide"},{"t":"text","text":": a missing provider is a runtime failure unless the route DI check is armed. The "},{"t":"link","href":"/craft/guide/routing/setup","external":false,"children":[{"t":"text","text":"route DI check"}]},{"t":"text","text":" and "},{"t":"link","href":"/craft/guide/testing/architecture#assertroutediproofs","external":false,"children":[{"t":"text","text":"architecture tests"}]},{"t":"text","text":" keep that proof in place."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Use "},{"t":"code","text":"global"},{"t":"text","text":" when the instance is intentionally shared application-wide."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Use "},{"t":"code","text":"manuallyProvidedAtRoot"},{"t":"text","text":" only when an explicit root provider is needed,"},{"t":"text","text":" "},{"t":"text","text":"including when a global service must depend on a configured provider."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Use "},{"t":"code","text":"abstract"},{"t":"text","text":" when the implementation should be chosen by the mounting site."}]}],[{"t":"paragraph","children":[{"t":"text","text":"For startup-only logic that should run when the app boots but is not injected"},{"t":"text","text":" "},{"t":"text","text":"elsewhere, prefer "},{"t":"code","text":"function"},{"t":"text","text":" together with "},{"t":"code","text":"provideAppInitializer(...)"},{"t":"text","text":". If"},{"t":"text","text":" "},{"t":"text","text":"the same instance also needs to be injected by other services, use "},{"t":"code","text":"global"},{"t":"text","text":" "},{"t":"text","text":"instead."}]}]]},{"t":"heading","level":2,"id":"see-also","children":[{"t":"text","text":"See Also"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/app/craft-service","external":false,"children":[{"t":"text","text":"craftService"}]}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/routing/route-providers","external":false,"children":[{"t":"text","text":"Route providers"}]},{"t":"text","text":" — providing a service from a route"}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/testing/services","external":false,"children":[{"t":"text","text":"Testing services"}]}]}]]}],"outline":[{"level":2,"id":"supported-scopes","text":"Supported Scopes"},{"level":3,"id":"global","text":"global"},{"level":3,"id":"toprovide","text":"toProvide"},{"level":3,"id":"manuallyprovidedatroot","text":"manuallyProvidedAtRoot"},{"level":3,"id":"function","text":"function"},{"level":3,"id":"abstract","text":"abstract"},{"level":2,"id":"recommendations-for-choosing-a-scope","text":"Recommendations For Choosing a Scope"},{"level":2,"id":"see-also","text":"See Also"}]}