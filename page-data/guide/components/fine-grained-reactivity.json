", "},{"t":"code","text":"forNode"},{"t":"text","text":", "},{"t":"code","text":"matchNode.exhaustive"},{"t":"text","text":", and "},{"t":"code","text":"deferNode"},{"t":"text","text":" isolate their own"},{"t":"text","text":" "},{"t":"text","text":"structural work. A branch or list can change without making the parent"},{"t":"text","text":" "},{"t":"text","text":"component rebuild unrelated siblings. Use these helpers for structure and"},{"t":"text","text":" "},{"t":"text","text":"binding callbacks for values on existing nodes."}]},{"t":"paragraph","children":[{"t":"text","text":"With the named "},{"t":"code","text":"ifNode"},{"t":"text","text":" overload, the condition callback can return a"},{"t":"text","text":" "},{"t":"text","text":"yieldable reader invocation directly. The renderer drives the generator and"},{"t":"text","text":" "},{"t":"text","text":"reads the reactive value for the condition:"}]},{"t":"code","lines":[{"tokens":[{"text":"ifNode","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"'showEmpty'","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"  () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" SearchView.searchQuery.","kind":"punctuation"},{"text":"showEmpty","kind":"function"},{"text":"(),","kind":"punctuation"}]},{"tokens":[{"text":"  () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"p","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'No books found.'","kind":"punctuation"},{"text":"),","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"heading","level":3,"id":"progressive-fornode-rendering","children":[{"t":"text","text":"Progressive "},{"t":"code","text":"forNode"},{"t":"text","text":" rendering"}]},{"t":"paragraph","children":[{"t":"text","text":"See the dedicated "},{"t":"link","href":"/craft/guide/components/schedule-for","