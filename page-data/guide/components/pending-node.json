{"kind":"doc","route":"/guide/components/pending-node","title":"settledValue & pendingNode","blocks":[{"t":"heading","level":1,"id":"settledvalue-pendingnode","children":[{"t":"text","text":"settledValue & pendingNode"}]},{"t":"paragraph","children":[{"t":"text","text":"Reading an async value in a template without ever handling "},{"t":"code","text":"undefined"},{"t":"text","text":" — and"},{"t":"text","text":" "},{"t":"text","text":"being told at "},{"t":"strong","children":[{"t":"text","text":"compile time"}]},{"t":"text","text":" when the loading state has nowhere to go."}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Use it when"}]},{"t":"text","text":" a template renders data that comes from a "},{"t":"code","text":"query"},{"t":"text","text":"."},{"t":"text","text":" "},{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Not when"}]},{"t":"text","text":" you want to drive the loading state yourself: "},{"t":"code","text":"query.value()"},{"t":"text","text":" "},{"t":"text","text":"("},{"t":"code","text":"T | undefined"},{"t":"text","text":") and "},{"t":"code","text":"query.status()"},{"t":"text","text":" stay exactly as they were."}]},{"t":"heading","level":2,"id":"import","children":[{"t":"text","text":"Import"}]},{"t":"code","lines":[{"tokens":[{"text":"import","kind":"keyword"},{"text":" { settled } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'@craft-ts/core'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[{"text":"import","kind":"keyword"},{"text":" { pendingNode } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'@craft-ts/component'","kind":"punctuation"},{"text":";","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"heading","level":2,"id":"overview","children":[{"t":"text","text":"Overview"}]},{"t":"paragraph","children":[{"t":"text","text":"A resource-like "},{"t":"code","text":"query"},{"t":"text","text":", "},{"t":"code","text":"mutation"},{"t":"text","text":" or "},{"t":"code","text":"asyncProcess"},{"t":"text","text":" exposes a second read next"},{"t":"text","text":" "},{"t":"text","text":"to "},{"t":"code","text":"value"},{"t":"text","text":":"}]},{"t":"code","lines":[{"tokens":[{"text":"users.","kind":"punctuation"},{"text":"value","kind":"function"},{"text":"(); ","kind":"punctuation"},{"text":"// User[] | undefined  — you handle the wait","kind":"comment"}]},{"tokens":[{"text":"users.","kind":"punctuation"},{"text":"settledValue","kind":"function"},{"text":"(); ","kind":"punctuation"},{"text":"// User[]        — the wait is handled for you","kind":"comment"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"settledValue"},{"t":"text","text":" never returns "},{"t":"code","text":"undefined"},{"t":"text","text":" and never returns a value while the"},{"t":"text","text":" "},{"t":"text","text":"source carries an exception. When there is nothing to show it "},{"t":"strong","children":[{"t":"text","text":"suspends"}]},{"t":"text","text":": it"},{"t":"text","text":" "},{"t":"text","text":"throws a "},{"t":"code","text":"CraftNotSettled"},{"t":"text","text":" that the nearest "},{"t":"code","text":"pendingNode"},{"t":"text","text":" turns into a"},{"t":"text","text":" "},{"t":"text","text":"fallback. A business exception throws through the existing channel instead, and"},{"t":"text","text":" "},{"t":"text","text":"lands in the nearest "},{"t":"code","text":"catchNode"},{"t":"text","text":"."}]},{"t":"paragraph","children":[{"t":"text","text":"Because the dependency is visible in the types, a template that renders a"},{"t":"text","text":" "},{"t":"text","text":"suspending value with no "},{"t":"code","text":"pendingNode"},{"t":"text","text":" around it does not compile."}]},{"t":"heading","level":2,"id":"reading-a-settled-value-in-a-computed","children":[{"t":"text","text":"Reading a settled value in a computed"}]},{"t":"paragraph","children":[{"t":"text","text":"Inside a "},{"t":"code","text":"craftComputed"},{"t":"text","text":" generator, "},{"t":"code","text":"yield* settled(ref)"},{"t":"text","text":" hands back the"},{"t":"text","text":" "},{"t":"text","text":"resource's settled read:"}]},{"t":"code","lines":[{"tokens":[{"text":"const","kind":"keyword"},{"text":" "},{"text":"teams"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftUse","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"craftComputed","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'teams'","kind":"punctuation"},{"text":", ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"list"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"settled","kind":"function"},{"text":"(users);","kind":"punctuation"}]},{"tokens":[{"text":"  ","kind":"punctuation"},{"text":"// `list()` is `User[]` here — never undefined, never in exception","kind":"comment"}]},{"tokens":[{"text":"  "},{"text":"return","kind":"keyword"},{"text":" () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" [","kind":"punctuation"},{"text":"...new","kind":"keyword"},{"text":" "},{"text":"Set","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"list","kind":"function"},{"text":"().","kind":"punctuation"},{"text":"map","kind":"function"},{"text":"((","kind":"punctuation"},{"text":"user"},{"text":") ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" user.team))].","kind":"punctuation"},{"text":"sort","kind":"function"},{"text":"();","kind":"punctuation"}]},{"tokens":[{"text":"}));","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Nothing is awaited and nothing is yielded at runtime: the markers are type-only."},{"t":"text","text":" "},{"t":"text","text":"What they do is tag "},{"t":"code","text":"teams"},{"t":"text","text":" as "},{"t":"em","children":[{"t":"text","text":"depending on the async source "},{"t":"code","text":"users"}]},{"t":"text","text":", which is"},{"t":"text","text":" "},{"t":"text","text":"what the template checker reads."}]},{"t":"heading","level":2,"id":"the-boundary","children":[{"t":"text","text":"The boundary"}]},{"t":"paragraph","children":[{"t":"text","text":"The boundary is piped onto any node above the reads:"}]},{"t":"code","lines":[{"tokens":[{"text":"div","kind":"function"},{"text":"([","kind":"punctuation"},{"text":"span","kind":"function"},{"text":"(teams), ","kind":"punctuation"},{"text":"span","kind":"function"},{"text":"(total)]).","kind":"punctuation"},{"text":"pipe","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"pendingNode","kind":"function"},{"text":"({ ","kind":"punctuation"},{"text":"fallback","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"p","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'Chargement…'","kind":"punctuation"},{"text":") }),","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"One boundary covers every async source in its subtree — the same shape as"},{"t":"text","text":" "},{"t":"code","text":"Suspense"},{"t":"text","text":". When each zone deserves its own skeleton, name the sources instead;"},{"t":"text","text":" "},{"t":"text","text":"the list is checked exhaustively, so a source with no fallback (and a fallback"},{"t":"text","text":" "},{"t":"text","text":"for a source that never suspends here) is a compile error:"}]},{"t":"code","lines":[{"tokens":[{"text":"div","kind":"function"},{"text":"([","kind":"punctuation"},{"text":"...","kind":"keyword"},{"text":"]).","kind":"punctuation"},{"text":"pipe","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  pendingNode.","kind":"punctuation"},{"text":"exhaustive","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"users","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"SkeletonList","kind":"function"},{"text":"(),","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"orders","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"SkeletonRows","kind":"function"},{"text":"(),","kind":"punctuation"}]},{"tokens":[{"text":"  }),","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The handler keys are the "},{"t":"strong","children":[{"t":"text","text":"query names"}]},{"t":"text","text":", even when the template only ever sees"},{"t":"text","text":" "},{"t":"text","text":"a computed derived from them."}]},{"t":"heading","level":2,"id":"what-the-compiler-enforces","children":[{"t":"text","text":"What the compiler enforces"}]},{"t":"code","lines":[{"tokens":[{"text":"craftComponent","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"'teamList'","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"  {},","kind":"punctuation"}]},{"tokens":[{"text":"  ","kind":"punctuation"},{"text":"// ERROR_async_source_rendered_outside_a_pendingNode: \"users\"","kind":"comment"}]},{"tokens":[{"text":"  "},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"users"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"query","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'users'","kind":"punctuation"},{"text":", { ","kind":"punctuation"},{"text":"...","kind":"keyword"},{"text":" });","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"teams"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"craftComputed","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'teams'","kind":"punctuation"},{"text":", ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"list"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"settled","kind":"function"},{"text":"(users);","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"return","kind":"keyword"},{"text":" () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"list","kind":"function"},{"text":"().","kind":"punctuation"},{"text":"length"},{"text":";","kind":"punctuation"}]},{"tokens":[{"text":"    });","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"return","kind":"keyword"},{"text":" "},{"text":"div","kind":"function"},{"text":"([","kind":"punctuation"},{"text":"span","kind":"function"},{"text":"(teams)]);","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The sources bubble up through the node tree exactly like unhandled exception"},{"t":"text","text":" "},{"t":"text","text":"codes do, and the check fires on the "},{"t":"code","text":"craftComponent"},{"t":"text","text":" template argument, naming"},{"t":"text","text":" "},{"t":"text","text":"the sources that have nowhere to show their loading state. Several suspending"},{"t":"text","text":" "},{"t":"text","text":"computeds in one template are all covered by the same rule: every one of them"},{"t":"text","text":" "},{"t":"text","text":"needs a boundary above it."}]},{"t":"paragraph","children":[{"t":"text","text":"The obligation travels through "},{"t":"code","text":"forNode"},{"t":"text","text":", "},{"t":"code","text":"ifNode"},{"t":"text","text":", "},{"t":"code","text":"deferNode"},{"t":"text","text":", projected content and"},{"t":"text","text":" "},{"t":"text","text":"nested elements — anywhere a node can carry children."}]},{"t":"heading","level":2,"id":"stale-while-revalidate","children":[{"t":"text","text":"Stale-while-revalidate"}]},{"t":"paragraph","children":[{"t":"text","text":"A reload that keeps its previous value does "},{"t":"strong","children":[{"t":"text","text":"not"}]},{"t":"text","text":" suspend: the stale value is"},{"t":"text","text":" "},{"t":"text","text":"served while the new one is in flight, so a refetch never blanks a screen that"},{"t":"text","text":" "},{"t":"text","text":"already has data. Only a source with nothing to show suspends. To make a reload"},{"t":"text","text":" "},{"t":"text","text":"suspend again, clear the value with "},{"t":"code","text":"preservePreviousValue: () => false"},{"t":"text","text":"."}]},{"t":"paragraph","children":[{"t":"text","text":"A refetch throws nothing, so the boundary cannot learn about it from the"},{"t":"text","text":" "},{"t":"text","text":"suspension channel — it watches the source's own status instead. Give a handler"},{"t":"text","text":" "},{"t":"text","text":"its "},{"t":"code","text":"reloading"},{"t":"text","text":" slot to report it, rendered "},{"t":"strong","children":[{"t":"text","text":"next to the still-visible"},{"t":"text","text":" "},{"t":"text","text":"subtree"}]},{"t":"text","text":":"}]},{"t":"code","lines":[{"tokens":[{"text":"pendingNode.","kind":"punctuation"},{"text":"exhaustive","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"  issue: {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"pending","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"p","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'Waiting for an invoice…'","kind":"punctuation"},{"text":"),","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"reloading","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"p","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'Re-issuing…'","kind":"punctuation"},{"text":"),","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"// or, for the catch-all form","kind":"comment"}]},{"tokens":[{"text":"pendingNode","kind":"function"},{"text":"({ ","kind":"punctuation"},{"text":"fallback","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"Skeleton","kind":"function"},{"text":"(), ","kind":"punctuation"},{"text":"reloading","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"Spinner","kind":"function"},{"text":"() });","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"heading","level":2,"id":"runtime-behaviour","children":[{"t":"text","text":"Runtime behaviour"}]},{"t":"paragraph","children":[{"t":"text","text":"While a source is pending, the boundary renders its fallback and detaches the"},{"t":"text","text":" "},{"t":"text","text":"suspended subtree's DOM — "},{"t":"strong","children":[{"t":"text","text":"detaches, not destroys"}]},{"t":"text","text":". Keeping it alive is what"},{"t":"text","text":" "},{"t":"text","text":"makes resumption work: the suspended bindings stay subscribed to their source's"},{"t":"text","text":" "},{"t":"text","text":"status, so they re-run and release the boundary the moment the data arrives."}]},{"t":"paragraph","children":[{"t":"text","text":"Two escapes are reported rather than silently swallowed:"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"a settled read that suspends with no boundary above it throws"},{"t":"text","text":" "},{"t":"code","text":"CraftUnhandledPendingError"},{"t":"text","text":";"}]}],[{"t":"paragraph","children":[{"t":"text","text":"a settled read whose source carries an exception with no "},{"t":"code","text":"catchNode"},{"t":"text","text":" above it"},{"t":"text","text":" "},{"t":"text","text":"throws "},{"t":"code","text":"CraftUnhandledExceptionError"},{"t":"text","text":"."}]}]]},{"t":"paragraph","children":[{"t":"text","text":"The first is the runtime backstop for what the types cannot see — typically a"},{"t":"text","text":" "},{"t":"text","text":"settled read hidden inside a lambda ("},{"t":"code","text":"() => users.settledValue().name"},{"t":"text","text":"), where"},{"t":"text","text":" "},{"t":"text","text":"the brand that carries the obligation is lost. Bind the value "},{"t":"strong","children":[{"t":"text","text":"by reference"}]},{"t":"text","text":""},{"t":"text","text":" "},{"t":"text","text":"("},{"t":"code","text":"span(users.settledValue)"},{"t":"text","text":", "},{"t":"code","text":"span(teams)"},{"t":"text","text":") to keep the compile-time guarantee."}]},{"t":"heading","level":2,"id":"two-boundaries-two-obligations","children":[{"t":"text","text":"Two boundaries, two obligations"}]},{"t":"paragraph","children":[{"t":"text","text":"A settled read has two exits and each one has its own boundary:"}]},{"t":"table","head":[[{"t":"text","text":"Exit"}],[{"t":"text","text":"Thrown"}],[{"t":"text","text":"Boundary"}],[{"t":"text","text":"Checked at"}]],"rows":[[[{"t":"text","text":"nothing to show yet"}],[{"t":"code","text":"CraftNotSettled"}],[{"t":"code","text":"pendingNode"}],[{"t":"code","text":"craftComponent(...)"}]],[[{"t":"text","text":"the source carries an exception"}],[{"t":"code","text":"CraftGenShortCircuit"}],[{"t":"code","text":"catchNode"}],[{"t":"code","text":"craftComponent(...)"}]]]},{"t":"paragraph","children":[{"t":"text","text":"Both bubble up the node tree until a boundary clears them, and both fail the"},{"t":"text","text":" "},{"t":"code","text":"craftComponent"},{"t":"text","text":" template argument when uncovered. A "},{"t":"code","text":"pendingNode"},{"t":"text","text":" is not an"},{"t":"text","text":" "},{"t":"text","text":"exception boundary — settled exceptions pass straight through it, and vice"},{"t":"text","text":" "},{"t":"text","text":"versa."}]},{"t":"paragraph","children":[{"t":"text","text":"These two throws are intentional CraftTS control flow. The shared"},{"t":"text","text":" "},{"t":"code","text":"isCraftControlFlow(error)"},{"t":"text","text":" predicate identifies them so observability and"},{"t":"text","text":" "},{"t":"text","text":"error-conversion wrappers can rethrow them without logging or taking an app"},{"t":"text","text":" "},{"t":"text","text":"snapshot. If a pending read escapes its boundary, it becomes"},{"t":"text","text":" "},{"t":"code","text":"CraftUnhandledPendingError"},{"t":"text","text":"; that is a real template error and remains"},{"t":"text","text":" "},{"t":"text","text":"observable."}]},{"t":"code","lines":[{"tokens":[{"text":"div","kind":"function"},{"text":"([","kind":"punctuation"},{"text":"span","kind":"function"},{"text":"(summary)])","kind":"punctuation"}]},{"tokens":[{"text":"  .","kind":"punctuation"},{"text":"pipe","kind":"function"},{"text":"(pendingNode.","kind":"punctuation"},{"text":"exhaustive","kind":"function"},{"text":"({ ","kind":"punctuation"},{"text":"issue","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"Skeleton","kind":"function"},{"text":"() }))","kind":"punctuation"}]},{"tokens":[{"text":"  .","kind":"punctuation"},{"text":"pipe","kind":"function"},{"text":"(catchNode.","kind":"punctuation"},{"text":"exhaustive","kind":"function"},{"text":"({ ","kind":"punctuation"},{"text":"INVOICE_REJECTED","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"Rejected","kind":"function"},{"text":"() }));","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"A "},{"t":"code","text":"catchNode"},{"t":"text","text":" handler receives the exception as "},{"t":"code","text":"AnyCraftException"},{"t":"text","text":": its "},{"t":"code","text":"code"},{"t":"text","text":" "},{"t":"text","text":"is known, its payload is not. Reach for "},{"t":"code","text":"matchNode"},{"t":"text","text":" when the fallback needs the"},{"t":"text","text":" "},{"t":"text","text":"payload itself."}]},{"t":"heading","level":2,"id":"current-limits","children":[{"t":"text","text":"Current limits"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"The by-id forms ("},{"t":"code","text":"select(...)"},{"t":"text","text":" / "},{"t":"code","text":"selectOrCreate(...)"},{"t":"text","text":") have no settled read"},{"t":"text","text":" "},{"t":"text","text":"yet: a by-id ref holds one status per group member."}]}],[{"t":"paragraph","children":[{"t":"text","text":"A component cannot yet delegate its boundaries to its caller: both checks are"},{"t":"text","text":" "},{"t":"text","text":"enforced on each "},{"t":"code","text":"craftComponent"},{"t":"text","text":" template."}]}],[{"t":"paragraph","children":[{"t":"text","text":"A settled read hidden inside a lambda loses its brand, and with it both"},{"t":"text","text":" "},{"t":"text","text":"compile-time obligations — the runtime backstops still fire."}]}]]},{"t":"paragraph","children":[{"t":"text","text":"The pending fallback is announced to assistive tech ("},{"t":"code","text":"aria-live"},{"t":"text","text":", "},{"t":"code","text":"aria-busy"},{"t":"text","text":")."},{"t":"text","text":" "},{"t":"text","text":"See "},{"t":"link","href":"/craft/guide/components/accessibility","external":false,"children":[{"t":"text","text":"Accessibility"}]},{"t":"text","text":"."}]}],"outline":[{"level":2,"id":"import","text":"Import"},{"level":2,"id":"overview","text":"Overview"},{"level":2,"id":"reading-a-settled-value-in-a-computed","text":"Reading a settled value in a computed"},{"level":2,"id":"the-boundary","text":"The boundary"},{"level":2,"id":"what-the-compiler-enforces","text":"What the compiler enforces"},{"level":2,"id":"stale-while-revalidate","text":"Stale-while-revalidate"},{"level":2,"id":"runtime-behaviour","text":"Runtime behaviour"},{"level":2,"id":"two-boundaries-two-obligations","text":"Two boundaries, two obligations"},{"level":2,"id":"current-limits","text":"Current limits"}]}