{"kind":"doc","route":"/guide/components/template-migrator","title":"Template migrator","blocks":[{"t":"heading","level":1,"id":"template-migrator","children":[{"t":"text","text":"Template migrator"}]},{"t":"paragraph","children":[{"t":"text","text":"Paste an HTML snippet or a web component from a UI library's documentation. The"},{"t":"text","text":" "},{"t":"text","text":"converter generates the equivalent Craft functional template and the imports it"},{"t":"text","text":" "},{"t":"text","text":"needs from "},{"t":"code","text":"@craft-ts/component"},{"t":"text","text":"."}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Use it to"}]},{"t":"text","text":" bring markup from outside — a design system's docs, a CodePen, an"},{"t":"text","text":" "},{"t":"text","text":"existing template markup — into Craft's template syntax without transcribing it"},{"t":"text","text":" "},{"t":"text","text":"by hand."}]},{"t":"component","name":"CraftTemplateMigrator"},{"t":"heading","level":2,"id":"what-it-produces","children":[{"t":"text","text":"What it produces"}]},{"t":"paragraph","children":[{"t":"text","text":"By default the result is a callback to paste as the third argument of"},{"t":"text","text":" "},{"t":"code","text":"craftComponent(...)"},{"t":"text","text":". Fill in a name to generate a complete component instead."}]},{"t":"paragraph","children":[{"t":"text","text":"Native HTML tags become the matching helpers ("},{"t":"code","text":"div"},{"t":"text","text":", "},{"t":"code","text":"button"},{"t":"text","text":", "},{"t":"code","text":"section"},{"t":"text","text":", …);"},{"t":"text","text":" "},{"t":"text","text":"custom tags become "},{"t":"code","text":"customElement('my-element', ...)"},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"pitfalls","children":[{"t":"text","text":"Pitfalls"}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Interpolations and bindings are preserved as expressions"}]},{"t":"text","text":", not translated."},{"t":"text","text":" "},{"t":"text","text":"Adapt them to your Craft context."}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Control-flow directives are not converted."}]},{"t":"text","text":" Rewrite conditional and repeated"},{"t":"text","text":" "},{"t":"text","text":"sections with "},{"t":"code","text":"ifNode"},{"t":"text","text":" or "},{"t":"code","text":"forNode"},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"see-also","children":[{"t":"text","text":"See Also"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/components/directives","external":false,"children":[{"t":"text","text":"Directives and "},{"t":"code","text":".pipe(...)"}]}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/routing/automation","external":false,"children":[{"t":"text","text":"CLI automation"}]},{"t":"text","text":" — codemods for the rest of a migration"}]}]]}],"outline":[{"level":2,"id":"what-it-produces","text":"What it produces"},{"level":2,"id":"pitfalls","text":"Pitfalls"},{"level":2,"id":"see-also","text":"See Also"}]}