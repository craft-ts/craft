ce: ","kind":"punctuation"},{"text":"true","kind":"keyword"},{"text":", position: ","kind":"punctuation"},{"text":"'after'","kind":"punctuation"},{"text":" },","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Reach for "},{"t":"code","text":"catchTag.exhaustive"},{"t":"text","text":" only when the reaction is "},{"t":"strong","children":[{"t":"text","text":"logic"}]},{"t":"text","text":" and produces"},{"t":"text","text":" "},{"t":"text","text":"no DOM — logging it, notifying a service:"}]},{"t":"code","lines":[{"tokens":[{"text":"catchTag.","kind":"punctuation"},{"text":"exhaustive","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"NO_ACCESS","kind":"function"},{"text":": ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"yield*","kind":"keyword"},{"text":" ToastService.","kind":"punctuation"},{"text":"show","kind":"function"},{"text":"(() ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"'No access'","kind":"punctuation"},{"text":");","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Every handler must do that work. An empty generator or a bare "},{"t":"code","text":"return;"},{"t":"text","text":" only"},{"t":"text","text":" "},{"t":"text","text":"removes the exception from the component/route contract; it does not show the"},{"t":"text","text":" "},{"t":"text","text":"user what failed. The "},{"t":"code","text":"craft-ts/require-catch-tag-exhaustive-reaction"},{"t":"text","text":" ESLint"},{"t":"text","text":" "},{"t":"text","text":"rule rejects both patterns. If a primitive exposes the error through"},{"t":"text","text":" "},{"t":"code","text":"exceptions()"},{"t":"text","text":", "},{"t":"code","text":"matchNode.exhaustive"},{"t":"text","text":" can render each case directly. If the"},{"t":"text","text":" "},{"t":"text","text":"component must handle its initialization exception with "},{"t":"code","text":"catchTag"},{"t":"text","text":", make the"},{"t":"text","text":" "},{"t":"text","text":"handler perform a real action that updates the view model so the template can"},{"t":"text","text":" "},{"t":"text","text":"show the result. Use "},{"t":"code","text":"catchNode.exhaustive"},{"t":"text","text":" for an initialization fallback."}]},{"t":"paragraph","children":[{"t":"text","text":"Before — all four HTTP errors are swallowed, so the component cannot tell the"},{"t":"text","text":" "},{"t":"text","text":"user what happened:"}]},{"t":"code","lines":[{"tokens":[{"text":"catchTag.","kind":"punctuation"},{"text":"exhaustive","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"TransientHttpError","kind":"function"},{"text":": ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () { ","kind":"punctuation"},{"text":"return","kind":"keyword"},{"text":"; },","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"HttpError","kind":"function"},{"text":": ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () { ","kind":"punctuation"},{"text":"return","kind":"keyword"},{"text":"; },","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"HttpResponseDecodeError","kind":"function"},{"text":": ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () { ","kind":"punctuation"},{"text":"return","kind":"keyword"},{"text":"; },","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"SearchHttpError","kind":"function"},{"text":": ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () { ","kind":"punctuation"},{"text":"return","kind":"keyword"},{"text":"; },","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"After — each handler records a user-facing message, and the template displays"},{"t":"text","text":" "},{"t":"text","text":"that message as an alert:"}]},{"t":"code","lines":[{"tokens":[{"text":"catchTag.","kind":"punctuation"},{"text":"exhaustive","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"TransientHttpError","kind":"function"},{"text":": ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"yield*","kind":"keyword"},{"text":" SearchView.","kind":"punctuation"},{"text":"showSearchFailure","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'The search is still unavailable after retries.'","kind":"punctuation"},{"text":");","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"HttpError","kind":"function"},{"text":": ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"yield*","kind":"keyword"},{"text":" SearchView.","kind":"punctuation"},{"text":"showSearchFailure","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'The HTTP request failed. Try again shortly.'","kind":"punctuation"},{"text":");","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"HttpResponseDecodeError","kind":"function"},{"text":": ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"yield*","kind":"keyword"},{"text":" SearchView.","kind":"punctuation"},{"text":"showSearchFailure","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'The search service returned unreadable data.'","kind":"punctuation"},{"text":");","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"SearchHttpError","kind":"function"},{"text":": ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"yield*","kind":"keyword"},{"text":" SearchView.","kind":"punctuation"},{"text":"showSearchFailure","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'The search service rejected this request.'","kind":"punctuation"},{"text":");","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"ifNode","kind":"function"},{"text":"(searchQuery.hasSearchError, () ","kind":"punctuation"},{"text":"=>","kind":"keyword"}]},{"tokens":[{"text":"  "},{"text":"p","kind":"function"},{"text":"({ role: ","kind":"punctuation"},{"text":"'alert'","kind":"punctuation"},{"text":" }, searchQuery.searchFailureMessage),","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Either way, handling a code at the component "},{"t":"strong","children":[{"t":"text","text":"removes it"}]},{"t":"text","text":" from the component's"},{"t":"text","text":" "},{"t":"text","text":"contract and from the route's. Whatever you don't handle is "},{"t":"strong","children":[{"t":"text","text":"residual"}]},{"t":"text","text":", and it flows up"},{"t":"text","text":" "},{"t":"text","text":"into the route's exception union — where "},{"t":"code","text":"handleExceptions"},{"t":"text","text":" must cover it:"}]},{"t":"code","lines":[{"tokens":[{"text":"component + providers"}]},{"tokens":[{"text":"        ↓  (codes not handled by .pipe)"}]},{"tokens":[{"text":"   residual exceptions"}]},{"tokens":[{"text":"        ↓"}]},{"tokens":[{"text":"route exception union  ──  handleExceptions must be exact"}]}],"filename":"","language":"","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"At the route, the check is exhaustive "},{"t":"strong","children":[{"t":"text","text":"in both directions"}]},{"t":"text","text":": a reachable code"},{"t":"text","text":" "},{"t":"text","text":"with no handler is a type error, and a handler for a code nothing can produce is"},{"t":"text","text":" "},{"t":"text","text":"a type error too."}]},{"t":"callout","tone":"warning","caption":"Where the compile error actually appears","children":[{"t":"paragraph","children":[{"t":"text","text":"Today the enforcement is at the "},{"t":"strong","children":[{"t":"text","text":"route"}]},{"t":"text","text":", not at the component. The variadic"},{"t":"text","text":" "},{"t":"text","text":"component "},{"t":"code","text":".pipe(...)"},{"t":"text","text":" overload is deliberately kept permissive to avoid"},{"t":"text","text":" "},{"t":"text","text":"excessive TypeScript instantiation depth, so an unhandled code there is rejected"},{"t":"text","text":" "},{"t":"text","text":"by "},{"t":"strong","children":[{"t":"text","text":"runtime"}]},{"t":"text","text":" dispatch rather than by the compiler. The compile-time proof is"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/routing/exception-handling#exhaustiveness","external":false,"children":[{"t":"code","text":"assertExhaustiveRouteExceptions(routes)"}]},{"t":"text","text":"."}]},{"t":"paragraph","children":[{"t":"text","text":"Practical consequence: a component rendered outside any route — in a test, or"},{"t":"text","text":" "},{"t":"text","text":"nested inside another component — gets no compile-time reminder. Handle its"},{"t":"text","text":" "},{"t":"text","text":"codes explicitly."}]}]},{"t":"paragraph","children":[{"t":"text","text":"Three utilities do the handling, and which one you want depends on whether the"},{"t":"text","text":" "},{"t":"text","text":"result is logic or DOM:"}]},{"t":"table","head":[[{"t":"text","text":"Utility"}],[{"t":"text","text":"Handles in"}],[{"t":"text","text":"Produces"}]],"rows":[[[{"t":"code","text":"catchNode.exhaustive"}],[{"t":"text","text":"template"}],[{"t":"text","text":"a fallback around a source block — "},{"t":"strong","children":[{"t":"text","text":"the default choice"}]},{"t":"text","text":""}]],[[{"t":"code","text":"matchNode.exhaustive"}],[{"t":"text","text":"template"}],[{"t":"text","text":"a fallback rendered from an exception value or signal"}]],[[{"t":"code","text":"catchTag.exhaustive"}],[{"t":"text","text":"logic"}],[{"t":"text","text":"nothing renderable — call a service, log, …"}]]]},{"t":"paragraph","children":[{"t":"text","text":"Details on "},{"t":"link","href":"/craft/guide/components/customization#choosing-an-exception-utility","external":false,"children":[{"t":"text","text":"Customization"}]},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"why-exhaustiveness-is-worth-the-ceremony","children":[{"t":"text","text":"Why exhaustiveness is worth the ceremony"}]},{"t":"paragraph","children":[{"t":"text","text":"Because the set of reachable codes is a "},{"t":"strong","children":[{"t":"text","text":"type"}]},{"t":"text","text":", the compiler can compare it"},{"t":"text","text":" "},{"t":"text","text":"against the set you handled. At the route level that comparison is an assertion"},{"t":"text","text":" "},{"t":"text","text":"you place once per collection:"}]},{"t":"code","lines":[{"tokens":[{"text":"assertExhaustiveRouteExceptions","kind":"function"},{"text":"(demoRoutes);","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"A code that can be produced but isn't handled is a compile error. So is a"},{"t":"text","text":" "},{"t":"text","text":"handler for a code nothing produces. Add a "},{"t":"code","text":"craftException"},{"t":"text","text":" to a guard six months"},{"t":"text","text":" "},{"t":"text","text":"from now and the routes file tells you exactly which routes must decide what to"},{"t":"text","text":" "},{"t":"text","text":"do about it."}]},{"t":"paragraph","children":[{"t":"text","text":"The assertion itself is an unused call unless it stays in the file."},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/testing/architecture#assertroutediproofs","external":false,"children":[{"t":"text","text":"Architecture tests"}]},{"t":"text","text":" fail if a"},{"t":"text","text":" "},{"t":"text","text":"collection omits it."}]},{"t":"heading","level":2,"id":"pitfalls","children":[{"t":"text","text":"Pitfalls"}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Throwing instead of returning."}]},{"t":"text","text":" A thrown value is an "},{"t":"em","children":[{"t":"text","text":"error"}]},{"t":"text","text":": it bypasses the"},{"t":"text","text":" "},{"t":"text","text":"typed union and lands in the global error path. Return the "},{"t":"code","text":"craftException"},{"t":"text","text":"."}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Reusing one code for two meanings."}]},{"t":"text","text":" The code is the identity the handlers"},{"t":"text","text":" "},{"t":"text","text":"match on. Two different failures deserve two codes, with payloads carrying the"},{"t":"text","text":" "},{"t":"text","text":"detail."}]},{"t":"heading","level":2,"id":"see-also","children":[{"t":"text","text":"See Also"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/routing/exception-handling","external":false,"children":[{"t":"text","text":"Route exception handling"}]}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/testing/architecture","external":false,"children":[{"t":"text","text":"Architecture rules"}]},{"t":"text","text":" — "},{"t":"code","text":"assertRouteDiProofs"},{"t":"text","text":" keeps the exhaustiveness assert in place"}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/state/server-state","external":false,"children":[{"t":"text","text":"query"}]},{"t":"text","text":" — typed HTTP exception matchers"}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/forms/exceptions","external":false,"children":[{"t":"text","text":"Form exception handling"}]}]}]]}],"outline":[{"level":2,"id":"declaring-one","text":"Declaring one"},{"level":2,"id":"where-they-come-from","text":"Where they come from"},{"level":2,"id":"propagating-through-a-shared-utility","text":"Propagating through a shared utility"},{"level":3,"id":"stopping-the-propagation","text":"Stopping the propagation"},{"level":2,"id":"reading-them","text":"Reading them"},{"level":2,"id":"handling-them","text":"Handling them"},{"level":2,"id":"an-unhandled-exception-doesn-t-just-disappear","text":"An unhandled exception doesn't just disappear"},{"level":2,"id":"why-exhaustiveness-is-worth-the-ceremony","text":"Why exhaustiveness is worth the ceremony"},{"level":2,"id":"pitfalls","text":"Pitfalls"},{"level":2,"id":"see-also","text":"See Also"}]}