":"    "},{"text":"?","kind":"keyword"},{"text":" "},{"text":"true","kind":"keyword"}]},{"tokens":[{"text":"    "},{"text":":","kind":"keyword"},{"text":" "},{"text":"craftException","kind":"function"},{"text":"({ _tag: ","kind":"punctuation"},{"text":"'FORBIDDEN_ROLE'","kind":"punctuation"},{"text":" });","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"noPizzeriaGuard"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftGen","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"const","kind":"keyword"},{"text":" { ","kind":"punctuation"},{"text":"pizzeria"},{"text":" } ","kind":"punctuation"},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"Auth","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"undefined","kind":"keyword"},{"text":", ({ ","kind":"punctuation"},{"text":"pizzeria"},{"text":" }) ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" ({ pizzeria }));","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"  "},{"text":"return","kind":"keyword"},{"text":" (","kind":"punctuation"},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"pizzeria","kind":"function"},{"text":"())","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"?","kind":"keyword"},{"text":" "},{"text":"craftException","kind":"function"},{"text":"({ _tag: ","kind":"punctuation"},{"text":"'HAS_PIZZERIA'","kind":"punctuation"},{"text":" })","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":":","kind":"keyword"},{"text":" "},{"text":"true","kind":"keyword"},{"text":";","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Used from a route:"}]},{"t":"code","lines":[{"tokens":[{"text":"canActivate"},{"text":": ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"roleGuard","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"ROLES"},{"text":".","kind":"punctuation"},{"text":"PIZZERIA_ADMIN"},{"text":");","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"noPizzeriaGuard","kind":"function"},{"text":"();","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"return","kind":"keyword"},{"text":" "},{"text":"true","kind":"keyword"},{"text":";","kind":"punctuation"}]},{"tokens":[{"text":"},","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"heading","level":3,"id":"why-it-matters","children":[{"t":"text","text":"Why it matters"}]},{"t":"paragraph","children":[{"t":"text","text":"Without it, reusable guards turn into copy-pasted generator blocks with repeated"},{"t":"text","text":" "},{"t":"text","text":"branching and ad hoc exception handling. "},{"t":"code","text":"craftGen"},{"t":"text","text":" lets you:"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"parameterise one guard and reuse it across routes;"}]}],[{"t":"paragraph","children":[{"t":"text","text":"keep the route logic readable by composing with "},{"t":"code","text":"yield*"},{"t":"text","text":";"}]}],[{"t":"paragraph","children":[{"t":"text","text":"preserve exhaustiveness, because every reachable exception code stays typed;"}]}],[{"t":"paragraph","children":[{"t":"text","text":"keep route dependency tracking intact, because the yielded dependencies still"},{"t":"text","text":" "},{"t":"text","text":"surface to the surrounding route."}]}]]},{"t":"paragraph","children":[{"t":"text","text":"In practice this is the difference between \"a guard that works\" and \"a guard you"},{"t":"text","text":" "},{"t":"text","text":"can safely reuse and evolve\"."}]},{"t":"heading","level":3,"id":"how-it-behaves","children":[{"t":"text","text":"How it behaves"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"A normal return value comes back from "},{"t":"code","text":"yield*"},{"t":"text","text":" unchanged."}]}],[{"t":"paragraph","children":[{"t":"text","text":"A returned "},{"t":"code","text":"craftException"},{"t":"text","text":" makes the wrapper throw "},{"t":"code","text":"CraftGenShortCircuit"},{"t":"text","text":"."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Yielded dependencies are relayed unchanged to the caller."}]}],[{"t":"paragraph","children":[{"t":"text","text":"When you compose several guards, the first exception wins."}]}]]},{"t":"heading","level":2,"id":"pitfalls","children":[{"t":"text","text":"Pitfalls"}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"A primitive invocation is single-use."}]},{"t":"text","text":" Each call produces one generator, to be"},{"t":"text","text":" "},{"t":"text","text":"consumed exactly once — don't store one and "},{"t":"code","text":"yield*"},{"t":"text","text":" it twice."}]},{"t":"heading","level":2,"id":"see-also","children":[{"t":"text","text":"See Also"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/routing/guards","external":false,"children":[{"t":"text","text":"Route guards"}]}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/routing/eslint-rules","external":false,"children":[{"t":"text","text":"ESLint rules"}]},{"t":"text","text":" — "},{"t":"code","text":"require-yieldable-reactive-read"},{"t":"text","text":" and siblings"}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/advanced/program-operators","external":false,"children":[{"t":"text","text":"Program operators"}]},{"t":"text","text":" — "},{"t":"code","text":"catchTag"},{"t":"text","text":" and "},{"t":"code","text":"retry"}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/concepts/exceptions","external":false,"children":[{"t":"text","text":"Exceptions as values"}]}]}]]}],"outline":[{"level":2,"id":"why-a-generator-at-all","text":"Why a generator at all"},{"level":2,"id":"the-rule","text":"The rule"},{"level":2,"id":"craftgen-—-a-tracked-generator-outside-a-service","text":"craftGen — a tracked generator outside a service"},{"level":3,"id":"the-common-case","text":"The common case"},{"level":3,"id":"why-it-matters","text":"Why it matters"},{"level":3,"id":"how-it-behaves","text":"How it behaves"},{"level":2,"id":"pitfalls","text":"Pitfalls"},{"level":2,"id":"see-also","text":"See Also"}]}