guide/reactivity/on","external":false,"children":[{"t":"code","text":"on$"}]},{"t":"text","text":"."}]},{"t":"heading","level":3,"id":"granular-state-granular-tests","children":[{"t":"text","text":"Granular state, granular tests"}]},{"t":"paragraph","children":[{"t":"text","text":"Small, focused states isolate change. Combined with partial yields, a consumer"},{"t":"text","text":" "},{"t":"text","text":"depends on exactly what it reads — and a test provides exactly that, no more."}]},{"t":"heading","level":3,"id":"services-as-functions","children":[{"t":"text","text":"Services as functions"}]},{"t":"paragraph","children":[{"t":"text","text":"A service is a factory with a name and a scope, not a class:"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/app/craft-service","external":false,"children":[{"t":"code","text":"craftService"}]},{"t":"text","text":" for the ones you write,"},{"t":"text","text":" "},{"t":"text","text":"and small host adapters for dependencies owned by the runtime. Both participate"},{"t":"text","text":" "},{"t":"text","text":"in the same typed composition and the same testing workflow."}]},{"t":"code","lines":[{"tokens":[{"text":"const","kind":"keyword"},{"text":" { ","kind":"punctuation"},{"text":"UserProfile"},{"text":" } ","kind":"punctuation"},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftService","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  { name: ","kind":"punctuation"},{"text":"'UserProfile'","kind":"punctuation"},{"text":", providedIn: ","kind":"punctuation"},{"text":"'global'","kind":"punctuation"},{"text":" },","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"api"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"UserApi","kind":"function"},{"text":"();","kind":"