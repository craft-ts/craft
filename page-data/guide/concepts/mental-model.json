kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"    "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"query","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"'user'","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"      {","kind":"punctuation"}]},{"tokens":[{"text":"        params: userId,","kind":"punctuation"}]},{"tokens":[{"text":"        "},{"text":"loader","kind":"function"},{"text":": ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" ({ ","kind":"punctuation"},{"text":"params"},{"text":" }) {","kind":"punctuation"}]},{"tokens":[{"text":"          "},{"text":"return","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" api.","kind":"punctuation"},{"text":"getUser","kind":"function"},{"text":"(params);","kind":"punctuation"}]},{"tokens":[{"text":"        },","kind":"punctuation"}]},{"tokens":[{"text":"      },","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"insertReactOnMutation","kind":"function"},{"text":"(updateEmail, {","kind":"punctuation"}]},{"tokens":[{"text":"        optimisticPatch: { ","kind":"punctuation"},{"text":"email","kind":"function"},{"text":": ({ ","kind":"punctuation"},{"text":"mutationParams"},{"text":" }) ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" mutationParams.email },","kind":"punctuation"}]},{"tokens":[{"text":"        reload: { onMutationException: ","kind":"punctuation"},{"text":"true","kind":"keyword"},{"text":" },","kind":"punctuation"}]},{"tokens":[{"text":"      }),","kind":"punctuation"}]},{"tokens":[{"text":"    );","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"heading","level":3,"id":"signals-not-rxjs","children":[{"t":"text","text":"Signals, not RxJS"}]},{"t":"paragraph","children":[{"t":"text","text":"100% signal-based. craft-ts has no RxJS dependency: anything subscribable — an"},{"t":"text","text":" "},{"t":"text","text":"RxJS "},{"t":"code","text":"Observable"},{"t":"text","text":" included — works structurally, and when you do want streams"},{"t":"text","text":" "},{"t":"text","text":"(operators, multicast, typed exceptions), "},{"t":"code","text":"@craft-ts/stream"},{"t":"text","text":" provides them with"},{"t":"text","text":" "},{"t":"text","text":"the same typed dependencies and exceptions as the rest of craft-ts. See"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/reactivity/streams","external":false,"children":[{"t":"text","text":"Typed streams"}]},{"t":"text","text":"."}]},{"t":"heading","level":3,"id":"declarative-code-is-legible-code","children":[{"t":"text","text":"Declarative code is legible code"}]},{"t":"paragraph","children":[{"t":"text","text":"The three principles add up to something that is rarely stated outright: the app"},{"t":"text","text":" "},{"t":"text","text":"becomes "},{"t":"strong","children":[{"t":"text","text":"declared data"}]},{"t":"text","text":" rather than control flow to be reconstructed. Two"},{"t":"text","text":" "},{"t":"text","text":"consequences follow, and both are worth more than they look."}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Observability stops being instrumentation."}]},{"t":"text","text":" Because every dependency"},{"t":"text","text":" "},{"t":"text","text":"resolution and every crafted function passes through one system, that system is"},{"t":"text","text":" "},{"t":"text","text":"where you wrap them — structured logs through a yieldable "},{"t":"code","text":"Console"},{"t":"text","text":", correlation"},{"t":"text","text":" "},{"t":"text","text":"ids across the graph, per-service timing, snapshots of the live dependency"},{"t":"text","text":" "},{"t":"text","text":"tree — with no change to business code. Retrofitting the same thing onto"},{"t":"text","text":" "},{"t":"text","text":"imperative code means touching every call site. See"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/advanced/observability","external":false,"children":[{"t":"text","text":"Observability"}]},{"t":"text","text":"."}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"And what a tool can read, a tool can help with."}]},{"t":"text","text":" The dependency graph, the"},{"t":"text","text":" "},{"t":"text","text":"reachable exceptions and the route contract are all declared, so an agent — or a"},{"t":"text","text":" "},{"t":"text","text":"future WebMCP-style integration — can reason about the app without inferring it"},{"t":"text","text":" "},{"t":"text","text":"from execution. The same property that makes the compiler able to check your"},{"t":"text","text":" "},{"t":"text","text":"providers makes the codebase tractable to something that isn't you."}]},{"t":"heading","level":3,"id":"exceptions-are-values-errors-are-surprises","children":[{"t":"text","text":"Exceptions are values, errors are surprises"}]},{"t":"paragraph","children":[{"t":"text","text":"A craft "},{"t":"em","children":[{"t":"text","text":"exception"}]},{"t":"text","text":" is a failure you declared and expect to handle; an "},{"t":"em","children":[{"t":"text","text":"error"}]},{"t":"text","text":" "},{"t":"text","text":"is the unexpected kind. Keeping them apart is what allows the compiler to check"},{"t":"text","text":" "},{"t":"text","text":"that you handled every declared case."}]},{"t":"paragraph","children":[{"t":"text","text":"This is "},{"t":"strong","children":[{"t":"text","text":"error-as-value"}]},{"t":"text","text":": a declared failure is "},{"t":"em","children":[{"t":"text","text":"returned"}]},{"t":"text","text":", not thrown, so it"},{"t":"text","text":" "},{"t":"text","text":"propagates through types rather than escaping through the stack. A "},{"t":"code","text":"try/catch"},{"t":"text","text":" "},{"t":"text","text":"tells you nothing about what it might catch; a returned "},{"t":"code","text":"craftException"},{"t":"text","text":" carries"},{"t":"text","text":" "},{"t":"text","text":"its code and payload all the way to whoever handles it — and the compiler knows"},{"t":"text","text":" "},{"t":"text","text":"if nobody does. See "},{"t":"link","href":"/craft/guide/concepts/exceptions","external":false,"children":[{"t":"text","text":"Exceptions as values"}]},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"see-also","children":[{"t":"text","text":"See Also"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/concepts/choose-primitive","external":false,"children":[{"t":"text","text":"Which primitive should I use?"}]}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/concepts/primitive-anatomy","external":false,"children":[{"t":"text","text":"Anatomy of a primitive"}]}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/learn/","external":false,"children":[{"t":"text","text":"Learn: the guided path"}]}]}]]}],"outline":[{"level":2,"id":"declare","text":"Declare"},{"level":2,"id":"yield","text":"Yield"},{"level":2,"id":"derive","text":"Derive"},{"level":2,"id":"what-follows-from-this","text":"What follows from this"},{"level":3,"id":"composition-instead-of-configuration","text":"Composition instead of configuration"},{"level":3,"id":"methods-or-events-your-choice","text":"Methods or events, your choice"},{"level":3,"id":"granular-state-granular-tests","text":"Granular state, granular tests"},{"level":3,"id":"services-as-functions","text":"Services as functions"},{"level":3,"id":"signals-not-rxjs","text":"Signals, not RxJS"},{"level":3,"id":"declarative-code-is-legible-code","text":"Declarative code is legible code"},{"level":3,"id":"exceptions-are-values-errors-are-surprises","text":"Exceptions are values, errors are surprises"},{"level":2,"id":"see-also","text":"See Also"}]}