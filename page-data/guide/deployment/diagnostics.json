},{"t":"text","text":"."}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Fix"}]},{"t":"text","text":" — Add the section the runtime requires."}]}]]},{"t":"heading","level":3,"id":"craft-deploy-manifest-section-unexpected","children":[{"t":"code","text":"CRAFT_DEPLOY_MANIFEST_SECTION_UNEXPECTED"}]},{"t":"paragraph","children":[{"t":"text","text":"A section does not belong to this runtime."}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Cause"}]},{"t":"text","text":" — A section of another runtime is present; nothing would ever execute it."}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Fix"}]},{"t":"text","text":" — Remove the section, or change the runtime to the one that uses it."}]}]]},{"t":"heading","level":3,"id":"craft-deploy-manifest-unknown-platform","children":[{"t":"code","text":"CRAFT_DEPLOY_MANIFEST_UNKNOWN_PLATFORM"}]},{"t":"paragraph","children":[{"t":"text","text":"Unknown platform."}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Cause"}]},{"t":"text","text":" — "},{"t":"code","text":"platform"},{"t":"text","text":" is not part of the documented platform list."}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Fix"}]},{"t":"text","text":" — Pick a supported platform, or open an issue to add it to the matrix."}]}]]},{"t":"heading","level":3,"id":"craft-deploy-manifest-unknown-runtime","children":[{"t":"code","text":"CRAFT_DEPLOY_MANIFEST_UNKNOWN_RUNTIME"}]},{"t":"paragraph","children":[{"t":"text","text":"Unknown runtime."}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Cause"}]},{"t":"text","text":" — "},{"t":"code","text