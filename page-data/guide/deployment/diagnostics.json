ng","children":[{"t":"text","text":"Fix"}]},{"t":"text","text":" — Fix the thrown error, or run the CLI under a TypeScript loader, or commit a "},{"t":"code","text":"craft.deploy.json"},{"t":"text","text":" produced by the build."}]}]]},{"t":"heading","level":3,"id":"craft-deploy-config-not-found","children":[{"t":"code","text":"CRAFT_DEPLOY_CONFIG_NOT_FOUND"}]},{"t":"paragraph","children":[{"t":"text","text":"No deployment manifest found."}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Cause"}]},{"t":"text","text":" — No "},{"t":"code","text":"craft.deploy.ts"},{"t":"text","text":", "},{"t":"code","text":"craft.deploy.mjs"},{"t":"text","text":", "},{"t":"code","text":"craft.deploy.js"},{"t":"text","text":" or "},{"t":"code","text":"craft.deploy.json"},{"t":"text","text":" was found in the checked directory."}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Fix"}]},{"t":"text","text":" — Create a manifest with "},{"t":"code","text":"defineCraftDeployment"},{"t":"text","text":" or point the CLI at one with "},{"t":"code","text":"--config"},{"t":"text","text":"."}]}]]},{"t":"heading","level":3,"id":"craft-deploy-config-no-default-export","children":[{"t":"code","text":"CRAFT_DEPLOY_CONFIG_NO_DEFAULT_EXPORT"}]},{"t":"paragraph","children":[{"t":"text","text":"The deployment manifest has no default export."}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Cause"}]},{"t":"text","text":" — The module loaded but exposes no default export to read."}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Fix"}]},{"t":"text","text":" — Add "},{"t":"code","text":"export default defineCraftDeployment({ ... })"},{"t":"text","text":"."}]}]]},{"t":"heading","level":3,"id":"craft-deploy-deploy-not-confirmed","children":[{"t":"code","text":"CRAFT_DEPLOY_DEPLOY_NOT_CONFIRMED"}]},{"t":"paragraph","children":[{"t":"text","text":"A deployment was requested without confirmation."}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Cause"}]},{"t":"text","text":" — "},{"t":"code","text":"craft-ts deploy"},{"t":"text","text":" mutates an infrastructure, so it refuses to run until the plan has been approved explicitly."}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Fix"}]},{"t":"text","text":" — Review "},{"t":"code","text":"craft-ts deploy preview"},{"t":"text","text":", then pass "},{"t":"code","text":"--yes"},{"t":"text","text":" to apply it."}]}]]},{"t":"heading","level":3,"id":"craft-deploy-env-name-invalid","children":[{"t":"code","text":"CRAFT_DEPLOY_ENV_NAME_INVALID"}]},{"t":"paragraph","children":[{"t":"text","text":"Invalid environment variable name."}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Cause"}]},{"t":"text","text":" — A declared name is not an upper snake case identifier, which several platforms reject."}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Fix"}]},{"t":"text","text":" — Rename the variable to "},{"t":"code","text":"UPPER_SNAKE_CASE"},{"t":"text","text":"."}]}]]},{"t":"heading","level":3,"id":"craft-deploy-env-undeclared","children":[{"t":"code","text":"CRAFT_DEPLOY_ENV_UNDECLARED"}]},{"t":"paragraph","children":[{"t":"text","text":"An environment variable is read but not declared."}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Cause"}]},{"t":"text","text":" — The module graph of the runtime entry reads a variable the manifest does not list, so no provider can know 