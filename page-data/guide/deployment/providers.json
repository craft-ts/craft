ker compose -f docker-compose.production.yml up"}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Credentials"}]},{"t":"text","text":" — Registry credentials handled by the Docker CLI."}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Limit"}]},{"t":"text","text":" — No static-only publication path: a plain bucket is cheaper."}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Limit"}]},{"t":"text","text":" — Provisioning of the host is out of scope."}]}]]},{"t":"heading","level":3,"id":"cloudflare-pages","children":[{"t":"code","text":"cloudflare-pages"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Artefact"}]},{"t":"text","text":" — Public directory uploaded as-is."}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Local preview"}]},{"t":"text","text":" — "},{"t":"code","text":"wrangler pages dev <publicDir>"}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Credentials"}]},{"t":"text","text":" — "},{"t":"code","text":"CLOUDFLARE_API_TOKEN"},{"t":"text","text":" read by Wrangler."}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Limit"}]},{"t":"text","text":" — SSR and Worker runtimes need a Worker deployment, not Pages."}]}]]},{"t":"heading","level":3,"id":"vercel","children":[{"t":"code","text":"vercel"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Artefact"}]},{"t":"text","text":" — Public directory plus an optional Node server entry."}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Local preview"}]},{"t":"text