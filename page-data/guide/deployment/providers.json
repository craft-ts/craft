:2,"id":"using-a-provider","children":[{"t":"text","text":"Using a provider"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-ts","kind":"string"},{"text":" "},{"text":"deploy","kind":"string"},{"text":" "},{"text":"preview","kind":"string"},{"text":" "},{"text":"--provider","kind":"string"},{"text":" "},{"text":"alchemy","kind":"string"},{"text":" "},{"text":"--stage","kind":"string"},{"text":" "},{"text":"staging","kind":"string"}]},{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-ts","kind":"string"},{"text":" "},{"text":"deploy","kind":"string"},{"text":" "},{"text":"--provider","kind":"string"},{"text":" "},{"text":"alchemy","kind":"string"},{"text":" "},{"text":"--stage","kind":"string"},{"text":" "},{"text":"staging","kind":"string"},{"text":" "},{"text":"--yes","kind":"string"}]}],"filename":"","language":"bash","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"deploy"},{"t":"text","text":" runs the manifest check, the provider check and the preview before it"},{"t":"text","text":" "},{"t":"text","text":"applies anything, and stops with "},{"t":"code","text":"CRAFT_DEPLOY_DEPLOY_NOT_CONFIRMED"},{"t":"text","text":" when the"},{"t":"text","text":" "},{"t":"text","text":"plan has not been approved. Capabilities are verified against the provider that"},{"t":"text","text":" "},{"t":"text","text":"was actually loaded, not against this table, so a project can deploy with a"},{"t":"text","text":" "},{"t":"text","text":"provider CraftTS does not ship."}]},{"t":"heading","level":2,"id":"status","children":[{"t":"text","text":"Status"}]},{"t":"paragraph","children":[{"t":"text","text":"The matrix above is documentation, not a list of shipped integrations. One"},{"t":"text","text":" "},{"t":"text","text":"implementation ships today: "},{"t":"link","href":"/craft/guide/deployment/alchemy","external":false,"children":[{"t":"text","text":"Alchemy"}]},{"t":"text","text":", 