}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"loadCraftComponent(...)"},{"t":"text","text":" wires the lazy component and its dependency contract together. The"},{"t":"text","text":" "},{"t":"text","text":"per-route "},{"t":"code","text":"RouteCheckedDI"},{"t":"text","text":" / "},{"t":"code","text":"CanRun"},{"t":"text","text":" proof remains in the route file; see the tested example in"},{"t":"text","text":" "},{"t":"link","href":"/craft/learn/09-routing#the-check-that-pays-for-all-of-this","external":false,"children":[{"t":"text","text":"Learn step 9"}]},{"t":"text","text":"."}]},{"t":"heading","level":3,"id":"prefer-the-route-cli-for-day-to-day-authoring","children":[{"t":"text","text":"Prefer the route CLI for day-to-day authoring"}]},{"t":"paragraph","children":[{"t":"text","text":"The CLI is the primary writing façade while the generated result remains ordinary editable TypeScript:"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft","kind":"string"},{"text":" "},{"text":"route","kind":"string"},{"text":" "},{"text":"add","kind":"string"}]},{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft","kind":"string"},{"text":" "},{"text":"route","kind":"string"},{"text":" "},{"text":"add","kind":"string"},{"text":" "},{"text":"/users/:userId","kind":"string"},{"text":" "},{"text":"--component","kind":"string"},{"text":" "},{"text":"src/app/users/user-detail.ts#UserDetailComponent","kind":"string"}]}],"filename":"","language":"bash","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"By default it detects the project and "},{"t":"code","text":"craftRoutes"},{"t":"text","text":" collections, creates one lazy routes file"},{"t":"text","text":" "},{"t":"text","text":"per feature, adds the lazy loader, "},{"t":"code","text":".withParent"},{"t":"text","text":", the parent mount assertion and the same-file DI"},{"t":"text","text":" "},{"t":"text","text":"check, then runs ESLint and TypeScript diagnostics. Use "},{"t":"code","text":"--dry-run"},{"t":"text","text":" to inspect the plan,"},{"t":"text","text":" "},{"t":"code","text":"--yes"},{"t":"text","text":" for non-interactive scripts and "},{"t":"code","text":"--json"},{"t":"text","text":" for machine-readable output. Route targets must"},{"t":"text","text":" "},{"t":"text","text":"already be Craft components."}]},{"t":"paragraph","children":[{"t":"text","text":"Static redirects stay in the selected collection:"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft","kind":"string"},{"text":" "},{"text":"route","kind":"string"},{"text":" "},{"text":"add","kind":"string"},{"text":" "},{"text":"/old-users","kind":"string"},{"text":" "},{"text":"--redirect-to","kind":"string"},{"text":" "},{"text":"/users","kind":"string"},{"text":" "},{"text":"--parent","kind":"string"},{"text":" "},{"text":"src/app/app.routes.ts#appRoutes","kind":"string"}]}],"filename":"","language":"bash","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Existing flat groups can be split explicitly:"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft","kind":"string"},{"text":" "},{"text":"route","kind":"string"},{"text":" "},{"text":"split","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--parent","kind":"string"},{"text":" "},{"text":"src/app/app.routes.ts#appRoutes","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--prefix","kind":"string"},{"text":" "},{"text":"users","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--target","kind":"string"},{"text":" "},{"text":"src/app/users/users.routes.ts","kind":"string"}]}],"filename":"","language":"bash","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The split command only moves statically analyzable routes. It reports local declarations or dynamic"},{"t":"text","text":" "},{"t":"text","text":"paths without mutating files, so business logic is never guessed."}]},{"t":"paragraph","children":[{"t":"text","text":"Then wire the crafted routes into your application config:"}]},{"t":"code","lines":[{"tokens":[{"text":"import","kind":"keyword"},{"text":" { craftAppConfig, provideCraftRouter } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'@craft-ts/core'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[{"text":"import","kind":"keyword"},{"text":" { appRoutes } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'./app.routes'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"appConfig"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftAppConfig","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"  providers: [","kind":"punctuation"},{"text":"provideCraftRouter","kind":"function"},{"text":"(appRoutes.","kind":"punctuation"},{"text":"toRoutes","kind":"function"},{"text":"())],","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Notes:"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"code","text":"appRoutes.toRoutes()"},{"t":"text","text":" gives the router the real runtime routes."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Route params are bound to component inputs by name; there is nothing to opt into."}]}],[{"t":"paragraph","children":[{"t":"code","text":"provideCraftRouter(...)"},{"t":"text","text":" also takes the craft loading features"},{"t":"text","text":" "},{"t":"text","text":"("},{"t":"code","text":"withErrorComponent"},{"t":"text","text":", "},{"t":"code","text":"withRouteLoadError"},{"t":"text","text":", "},{"t":"code","text":"withTransitionTimings"},{"t":"text","text":", …) in"},{"t":"text","text":" "},{"t":"text","text":"the same call, e.g."},{"t":"text","text":" "},{"t":"code","text":"provideCraftRouter(appRoutes.toRoutes(), withErrorComponent({ component: MyGlobalErrorScreen }))"},{"t":"text","text":"."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Render "},{"t":"code","text":"CraftRouterOutlet()"},{"t":"text","text":" from "},{"t":"code","text":"@craft-ts/component"},{"t":"text","text":" inside your Craft"},{"t":"text","text":" "},{"t":"text","text":"component tree: the URL commits immediately and the outlet drives the"},{"t":"text","text":" "},{"t":"text","text":"pending UI and centralised exception handling."},{"t":"text","text":" "},{"t":"text","text":"(The features also work standalone via "},{"t":"code","text":"provideCraftLoading(...)"},{"t":"text","text":".)"},{"t":"text","text":" "},{"t":"code","text":"withRouteLoadError(...)"},{"t":"text","text":" must stay in "},{"t":"code","text":"provideCraftRouter(...)"},{"t":"text","text":" because it also registers an"},{"t":"text","text":" "},{"t":"text","text":"a navigation error handler and an internal recovery route. See"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/routing/pending-ui","external":false,"children":[{"t":"text","text":"Non-blocking navigation & pending UI"}]},{"t":"text","text":" and"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/routing/route-load-errors","external":false,"children":[{"t":"text","text":"Route Load Errors"}]},{"t":"text","text":"."}]}],[{"t":"paragraph","children":[{"t":"text","text":"For lazy routes, "},{"t":"code","text":"loadChildren"},{"t":"text","text":" should return the named route tree exported by the child collection, for example "},{"t":"code","text":"childRoutes.childRoutes"},{"t":"text","text":"."}]}]]},{"t":"heading","level":3,"id":"when-a-routes-file-gets-big","children":[{"t":"text","text":"When a routes file gets big"}]},{"t":"paragraph","children":[{"t":"code","text":"RouteCheckedDI"},{"t":"text","text":" checks one component at a time, so its cost does not grow with"},{"t":"text","text":" "},{"t":"text","text":"the number of sibling routes. Split routes with "},{"t":"code","text":"loadChildren"},{"t":"text","text":" when code"},{"t":"text","text":" "},{"t":"text","text":"splitting or ownership boundaries make that useful — each child still needs"},{"t":"text","text":" "},{"t":"text","text":"its own per-route checks. See "},{"t":"strong","children":[{"t":"link","href":"/craft/guide/routing/scaling","external":false,"children":[{"t":"text","text":"Scaling routes"}]}]},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"_3-install-the-eslint-rules","children":[{"t":"text","text":"3. Install the ESLint rules"}]},{"t":"paragraph","children":[{"t":"text","text":"Several checks in this guide enforce the same-file DI proof, the exhaustiveness"},{"t":"text","text":" "},{"t":"text","text":"assert and the architecture itself."}]},{"t":"paragraph","children":[{"t":"text","text":"Installing the plugin and the rule list is its own page:"},{"t":"text","text":" "},{"t":"text","text":""},{"t":"strong","children":[{"t":"link","href":"/craft/guide/routing/eslint-rules","external":false,"children":[{"t":"text","text":"ESLint rules"}]}]},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"_4-make-the-di-contract-enforceable","children":[{"t":"text","text":"4. Make the DI contract enforceable"}]},{"t":"paragraph","children":[{"t":"text","text":"The proofs in this guide are unused type aliases unless they stay in the file:"},{"t":"text","text":" "},{"t":"text","text":"comment out a "},{"t":"code","text":"CanRun"},{"t":"text","text":" and the project still compiles. That is the one fragile"},{"t":"text","text":" "},{"t":"text","text":"step in an otherwise compile-time guarantee."}]},{"t":"paragraph","children":[{"t":"text","text":"Architecture tests close it. "},{"t":"code","text":"assertRouteDiProofs"},{"t":"text","text":" walks the static graph and"},{"t":"text","text":" "},{"t":"text","text":"fails unless every routed component — including lazy "},{"t":"code","text":"loadChildren"},{"t":"text","text":" "},{"t":"text","text":"collections — every pending or error screen, and every "},{"t":"code","text":"craftAppConfig"},{"t":"text","text":" error"},{"t":"text","text":" "},{"t":"text","text":"surface is hooked to an armed mapper. TypeScript still judges whether a"},{"t":"text","text":" "},{"t":"text","text":"dependency is provided; the architecture suite judges whether that judgement"},{"t":"text","text":" "},{"t":"text","text":"was invoked."}]},{"t":"paragraph","children":[{"t":"text","text":"Copy the demo layout ("},{"t":"code","text":"apps/demo/architecture/"},{"t":"text","text":") and add:"}]},{"t":"code","lines":[{"tokens":[{"text":"it","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'requires a DI proof on every routed component and app-config error screen'","kind":"punctuation"},{"text":", () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" {","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"assertRouteDiProofs","kind":"function"},{"text":"(graph.graph);","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Full setup — analysis tsconfig, catalog, Nx target — is on"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/testing/architecture","external":false,"children":[{"t":"text","text":"Architecture rules"}]},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"see-also","children":[{"t":"text","text":"See Also"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/routing/automation","external":false,"children":[{"t":"text","text":"CLI automation"}]},{"t":"text","text":" — let the CLI write routes for you"}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/testing/architecture","external":false,"children":[{"t":"text","text":"Architecture rules"}]},{"t":"text","text":" — "},{"t":"code","text":"assertRouteDiProofs"},{"t":"text","text":" keeps the proofs armed"}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/routing/guards","external":false,"children":[{"t":"text","text":"Route guards"}]},{"t":"text","text":" — the next thing you'll add"}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/routing/scaling","external":false,"children":[{"t":"text","text":"Scaling routes"}]},{"t":"text","text":" — when one routes file gets too big"}]}]]}],"outline":[{"level":2,"id":"prerequisites","text":"Prerequisites"},{"level":2,"id":"_1-add-a-di-check-to-every-routed-component","text":"1. Add a DI check to every routed component"},{"level":2,"id":"_2-define-routes-with-craftroute-and-collect-them-with-craftroutes","text":"2. Define routes with craftRoute and collect them with craftRoutes"},{"level":3,"id":"prefer-the-route-cli-for-day-to-day-authoring","text":"Prefer the route CLI for day-to-day authoring"},{"level":3,"id":"when-a-routes-file-gets-big","text":"When a routes file gets big"},{"level":2,"id":"_3-install-the-eslint-rules","text":"3. Install the ESLint rules"},{"level":2,"id":"_4-make-the-di-contract-enforceable","text":"4. Make the DI contract enforceable"},{"level":2,"id":"see-also","text":"See Also"}]}