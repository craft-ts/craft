ertion and the"},{"t":"text","text":" "},{"t":"text","text":"same-file DI check, then runs ESLint and TypeScript diagnostics. Use "},{"t":"code","text":"--dry-run"},{"t":"text","text":" to inspect the plan,"},{"t":"text","text":" "},{"t":"code","text":"--yes"},{"t":"text","text":" for non-interactive scripts and "},{"t":"code","text":"--json"},{"t":"text","text":" for machine-readable output."}]},{"t":"paragraph","children":[{"t":"text","text":"Static redirects stay in the selected collection:"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft","kind":"string"},{"text":" "},{"text":"route","kind":"string"},{"text":" "},{"text":"add","kind":"string"},{"text":" "},{"text":"/old-users","kind":"string"},{"text":" "},{"text":"--redirect-to","kind":"string"},{"text":" "},{"text":"/users","kind":"string"},{"text":" "},{"text":"--parent","kind":"string"},{"text":" "},{"text":"src/app/app.routes.ts#appRoutes","kind":"string"}]}],"filename":"","language":"bash","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Existing flat groups can be split explicitly:"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft","kind":"string"},{"text":" "},{"text":"route","kind":"string"},{"text":" "},{"text":"split","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--parent","kind":"string"},{"text":" "},{"text":"src/app/app.routes.ts#appRoutes","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--prefix","kind":"string"},{"text":" "},{"text":"users","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--target","kind":"string"},{"text":" "},{"text":"src/app/users/users.routes.ts","kind":"string"}]}],"filename":"","language":"bash","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The split command only moves statically analyzable routes. It reports local declarations or dynamic"},{"t":"text","text":" "},{"t":"text","text":"paths without mutating files, so business logic is never guessed."}]},{"t":"paragraph","children":[{"t":"text","text":"Then wire the crafted routes into your application config:"}]},{"t":"code","lines":[{"tokens":[{"text":"import","kind":"keyword"},{"text":" { craftAppConfig, provideCraftRouter } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'@craft-ts/core'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[{"text":"import","kind":"keyword"},{"text":" { appRoutes } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'./app.routes'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"appConfig"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftAppConfig","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"  providers: [","kind":"punctuation"},{"text":"provideCraftRouter","kind":"function"},{"text":"(appRoutes.","kind":"punctuation"},{"text":"toRoutes","kind":"function"},{"text":"())],","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Notes:"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"code","text":"appRoutes.toRoutes()"},{"t":"text","text":" gives the router the real runtime routes."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Route params are bound to component inputs by name; there is nothing to opt into."}]}],[{"t":"paragraph","children":[{"t":"code","text":"provideCraftRouter(...)"},{"t":"text","text":" also takes the craft loading features"},{"t":"text","text":" "},{"t":"text","text":"("},{"t":"code","text":"withErrorComponent"},{"t":"text","text":", "},{"t":"code","t