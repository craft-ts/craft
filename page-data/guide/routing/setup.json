","text":"When a routes file gets big"}]},{"t":"paragraph","children":[{"t":"code","text":"RouteCheckedDI"},{"t":"text","text":" checks one component at a time, so its cost does not grow with"},{"t":"text","text":" "},{"t":"text","text":"the number of sibling routes. Split routes with "},{"t":"code","text":"loadChildren"},{"t":"text","text":" when code"},{"t":"text","text":" "},{"t":"text","text":"splitting or ownership boundaries make that useful — each child still needs"},{"t":"text","text":" "},{"t":"text","text":"its own per-route checks. See "},{"t":"strong","children":[{"t":"link","href":"/craft/guide/routing/scaling","external":false,"children":[{"t":"text","text":"Scaling routes"}]}]},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"_3-generate-dependency-metadata","children":[{"t":"text","text":"3. Generate dependency metadata"}]},{"t":"paragraph","children":[{"t":"text","text":"Add a script in your app:"}]},{"t":"code","lines":[{"tokens":[{"text":"{","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"\"scripts\"","kind":"punctuation"},{"text":": {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"\"craft:brand\"","kind":"punctuation"},{"text":": ","kind":"punctuation"},{"text":"\"craft-brand --root src\"","kind":"punctuation"}]},{"tokens":[{"text":"  }","kind":"punctuation"}]},{"tokens":[{"text":"}","kind":"punctuation"}]}],"filename":"","language":"json","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Then run:"}]},{"t":"code","lines":[{"tokens":[{"text":"npm","kind":"function"},{"text":" "},{"text":"run","kind":"string"},{"text":" "},{"text":"craft:brand","kind":"string"}]}],"filename":"","language":"bash","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"This is the step that creates the initial "},{"t":"code","text":"GenDeps_*"},{"t":"text","text":" aliases in your component files, for example:"}]},{"t":"code","lines":[{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"type","kind":"keyword"},{"text":" "},{"text":"GenDeps_TestComponent","kind":"type"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"GetDeps","kind":"type"},{"text":"<{","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"deps"},{"text":":","kind":"keyword"},{"text":" {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"TaskList"},{"text":":","kind":"keyword"},{"text":" "},{"text":"GetServiceDependencies","kind":"type"},{"text":"<","kind":"punctuation"},{"text":"typeof","kind":"keyword"},{"text":" TaskList>;","kind":"punctuation"}]},{"tokens":[{"text":"  };","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"provided"},{"text":":","kind":"keyword"},{"text":" {};","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"publicProperties"},{"text":":","kind":"keyword"},{"text":" "},{"text":"GetPublicComponentProperties","kind":"type"},{"text":"<","kind":"punctuation"},{"text":"TestComponent","kind":"type"},{"text":">;","kind":"punctuation"}]},{"tokens":[{"text":"}>;","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Adjust "},{"t":"code","text":"--root"},{"t":"text","text":" to your real source root:"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"code","text":"src"},{"t":"text","text":" for an application"}]}],[{"t":"paragraph","children":[{"t":"code","text":"projects/my-app/src"},{"t":"text","text":" for a workspace app"}]}],[{"t":"paragraph","children":[{"t":"code","text":"libs/my-feature/src"},{"t":"text","text":" for a library"}]}]]},{"t":"paragraph","children":[{"t":"text","text":"If you use a project-level "},{"t":"code","text":"craft-brand.config.ts"},{"t":"text","text":", you can extend the script:"}]},{"t":"code","lines":[{"tokens":[{"text":"{","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"\"scripts\"","kind":"punctuation"},{"text":": {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"\"craft:brand\"","kind":"punctuation"},{"text":": ","kind":"punctuation"},{"text":"\"craft-brand --root src --config ./craft-brand.config.ts\"","kind":"punctuation"}]},{"tokens":[{"text":"  }","kind":"punctuation"}]},{"tokens":[{"text":"}","kind":"punctuation"}]}],"filename":"","language":"json","numbered":false,"firstLine":1},{"t":"heading","level":2,"id":"_4-install-the-eslint-rules","children":[{"t":"text","text":"4. Install the ESLint rules"}]},{"t":"paragraph","children":[{"t":"text","text":"Several checks in this guide rely on code a rule generates or keeps in sync —"},{"t":"text","text":" "},{"t":"code","text":"GenDeps_*"},{"t":"text","text":" aliases, the same-file DI proof, the exhaustiveness assert. Others"},{"t":"text","text":" "},{"t":"text","text":"enforce the architecture itself."}]},{"t":"paragraph","children":[{"t":"text","text":"Installing the plugin and the rule list is its own page:"},{"t":"text","text":" "},{"t":"text","text":""},{"t":"strong","children":[{"t":"link","href":"/craft/guide/routing/eslint-rules","external":false,"children":[{"t":"text","text":"ESLint rules"}]}]},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"_5-when-a-component-changes-regenerate-gendeps-with-the-quick-fix","children":[{"t":"text","text":"5. When a component changes, regenerate "},{"t":"code","text":"GenDeps"},{"t":"text","text":" with the Quick Fix"}]},{"t":"paragraph","children":[{"t":"text","text":"After changing a component's DI-related shape, refresh its generated alias."}]},{"t":"paragraph","children":[{"t":"text","text":"Typical triggers:"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"adding or removing "},{"t":"code","text":"inject(...)"}]}],[{"t":"paragraph","children":[{"t":"text","text":"changing constructor injection"}]}],[{"t":"paragraph","children":[{"t":"text","text":"changing component "},{"t":"code","text":"imports"}]}],[{"t":"paragraph","children":[{"t":"text","text":"changing "},{"t":"code","text":"providers"}]}],[{"t":"paragraph","children":[{"t":"text","text":"changing "},{"t":"code","text":"viewProviders"}]}]]},{"t":"paragraph","children":[{"t":"text","text":"Recommended workflow:"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"first generation or bulk refactor: "},{"t":"code","text":"npm run craft:brand"}]}],[{"t":"paragraph","children":[{"t":"text","text":"one file without "},{"t":"code","text":"GenDeps_*"},{"t":"text","text":": run the dependency generator for the relevant source root"}]}],[{"t":"paragraph","children":[{"t":"text","text":"one file with "},{"t":"code","text":"GenDeps_*"},{"t":"text","text":": run "},{"t":"code","text":"eslint --fix"},{"t":"text","text":" for the file"}]}],[{"t":"paragraph","children":[{"t":"text","text":"CLI alternative for one file: "},{"t":"code","text":"eslint --fix src/app/feature/my-component.ts"}]}]]},{"t":"paragraph","children":[{"t":"text","text":"Important limits:"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"the Quick Fix only handles the current file"}]}],[{"t":"paragraph","children":[{"t":"text","text":"if you rename the component class, rerun the generator so the "},{"t":"code","text":"GenDeps_*"},{"t":"text","text":" alias name stays aligned"}]}]]},{"t":"callout","tone":"warning","caption":"","children":[{"t":"paragraph","children":[{"t":"text","text":"An Eslint error does not trigger a compilation error, so make sure to run the Quick Fix or "},{"t":"code","text":"eslint --fix"},{"t":"text","text":" after changing a component's DI shape. Otherwise, "},{"t":"code","text":"main.ts"},{"t":"text","text":" will not see the updated "},{"t":"code","text":"GenDeps_*"},{"t":"text","text":" and may miss real DI errors."}]}]},{"t":"heading","level":2,"id":"_6-make-the-di-contract-enforceable","children":[{"t":"text","text":"6. Make the DI contract enforceable"}]},{"t":"paragraph","children":[{"t":"text","text":"The proofs in this guide are unused type aliases unless they stay in the file:"},{"t":"text","text":" "},{"t":"text","text":"comment out a "},{"t":"code","text":"CanRun"},{"t":"text","text":" and the project still compiles. That is the one fragile"},{"t":"text","text":" "},{"t":"text","text":"step in an otherwise compile-time guarantee."}]},{"t":"paragraph","children":[{"t":"text","text":"Architecture tests close it. "},{"t":"code","text":"assertRouteDiProofs"},{"t":"text","text":" walks the static graph and"},{"t":"text","text":" "},{"t":"text","text":"fails unless every routed component — including lazy "},{"t":"code","text":"loadChildren"},{"t":"text","text":" "},{"t":"text","text":"collections — every pending or error screen, and every "},{"t":"code","text":"craftAppConfig"},{"t":"text","text":" error"},{"t":"text","text":" "},{"t":"text","text":"surface is hooked to an armed mapper. TypeScript still judges whether a"},{"t":"text","text":" "},{"t":"text","text":"dependency is provided; the architecture suite judges whether that judgement"},{"t":"text","text":" "},{"t":"text","text":"was invoked."}]},{"t":"paragraph","children":[{"t":"text","text":"Copy the demo layout ("},{"t":"code","text":"apps/demo/architecture/"},{"t":"text","text":") and add:"}]},{"t":"code","lines":[{"tokens":[{"text":"it","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'requires a DI proof on every routed component and app-config error screen'","kind":"punctuation"},{"text":", () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" {","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"assertRouteDiProofs","kind":"function"},{"text":"(graph.graph);","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Full setup — analysis tsconfig, catalog, Nx target — is on"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/testing/architecture","external":false,"children":[{"t":"text","text":"Architecture rules"}]},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"see-also","children":[{"t":"text","text":"See Also"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/routing/automation","external":false,"children":[{"t":"text","text":"CLI automation"}]},{"t":"text","text":" — let the CLI write routes for you"}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/testing/architecture","external":false,"children":[{"t":"text","text":"Architecture rules"}]},{"t":"text","text":" — "},{"t":"code","text":"assertRouteDiProofs"},{"t":"text","text":" keeps the proofs armed"}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/routing/guards","external":false,"children":[{"t":"text","text":"Route guards"}]},{"t":"text","text":" — the next thing you'll add"}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/routing/scaling","external":false,"children":[{"t":"text","text":"Scaling routes"}]},{"t":"text","text":" — when one routes file gets too big"}]}]]}],"outline":[{"level":2,"id":"prerequisites","text":"Prerequisites"},{"level":2,"id":"_1-add-a-di-check-to-every-routed-component","text":"1. Add a DI check to every routed component"},{"level":2,"id":"_2-define-routes-with-craftroute-and-collect-them-with-craftroutes","text":"2. Define routes with craftRoute and collect them with craftRoutes"},{"level":3,"id":"prefer-the-route-cli-for-day-to-day-authoring","text":"Prefer the route CLI for day-to-day authoring"},{"level":3,"id":"when-a-routes-file-gets-big","text":"When a routes file gets big"},{"level":2,"id":"_3-generate-dependency-metadata","text":"3. Generate dependency metadata"},{"level":2,"id":"_4-install-the-eslint-rules","text":"4. Install the ESLint rules"},{"level":2,"id":"_5-when-a-component-changes-regenerate-gendeps-with-the-quick-fix","text":"5. When a component changes, regenerate GenDeps with the Quick Fix"},{"level":2,"id":"_6-make-the-di-contract-enforceable","text":"6. Make the DI contract enforceable"},{"level":2,"id":"see-also","text":"See Also"}]}