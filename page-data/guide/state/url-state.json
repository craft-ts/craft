":[{"text":"    "},{"text":"void","kind":"keyword"},{"text":" PagePathParams;","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"return","kind":"keyword"},{"text":" [];","kind":"punctuation"}]},{"tokens":[{"text":"  }),","kind":"punctuation"}]},{"tokens":[{"text":"]);","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Without a codec, the primitive reads and writes the URL segment as a "},{"t":"code","text":"string"},{"t":"text","text":"."},{"t":"text","text":" "},{"t":"text","text":"With a codec, "},{"t":"code","text":"value()"},{"t":"text","text":" and "},{"t":"code","text":"set(...)"},{"t":"text","text":" use the decoded type. The route record's"},{"t":"text","text":" "},{"t":"text","text":"keys must match dynamic segment names. Optional segments ("},{"t":"code","text":":page?"},{"t":"text","text":") continue to"},{"t":"text","text":" "},{"t":"text","text":"use the existing raw parameter helpers; "},{"t":"code","text":"pathParams"},{"t":"text","text":" does not bind optional"},{"t":"text","text":" "},{"t":"text","text":"segments yet."}]},{"t":"paragraph","children":[{"t":"code","text":"set"},{"t":"text","text":" and "},{"t":"code","text":"update"},{"t":"text","text":" replace only the selected segment and preserve the other path"},{"t":"text","text":" "},{"t":"text","text":"segments, query string, and fragment. They add a history entry by default;"},{"t":"text","text":" "},{"t":"code","text":"{ replaceUrl: true }"},{"t":"text","text":" replaces the current entry. "},{"t":"code","text":"skipLocationChange"},{"t":"text","text":" is also"},{"t":"text","text":" "},{"t":"text","text":"available in the same options object."}]},{"t":"paragraph","children":[{"t":"text","text":"When "},{"t":"code","text":"fallbackValue"},{"t":"text","text":" is present, a decode failure uses that value and remains"},{"t":"text","text":" "},{"t":"text","text":"available through "},{"t":"code","text":"hasException()"},{"t":"text","text":" and "},{"t":"code","text":"exception()"},{"t":"text","text":". Without a fallback, the"},{"t":"text","text":" "},{"t":"text","text":"route's exception handlers receive a codec-returned "},{"t":"code","text":"craftException"},{"t":"text","text":", or a"},{"t":"text","text":" "},{"t":"code","text":"PathParamDecodeError"},{"t":"text","text":" when "},{"t":"code","text":"decode"},{"t":"text","text":" throws. This happens before the route"},{"t":"text","text":" "},{"t":"text","text":"component consumes the decoded value. An encode failure is normalized to"},{"t":"text","text":" "},{"t":"code","text":"PathParamEncodeError"},{"t":"text","text":" before the URL changes."}]},{"t":"paragraph","children":[{"t":"text","text":"The generated collection helper is route-scoped, like the existing raw"},{"t":"text","text":" "},{"t":"code","text":"UsersUserIdParams"},{"t":"text","text":" helpers. Descendant providers can use the short helper from"},{"t":"text","text":" "},{"t":"code","text":"withProviders"},{"t":"text","text":", such as "},{"t":"code","text":"PagePathParams"},{"t":"text","text":"; app-level services should pass"},{"t":"text","text":" "},{"t":"text","text":"destination parameters explicitly:"}]},{"t":"code","lines":[{"tokens":[{"text":"import","kind":"keyword"},{"text":" { CraftRouter } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'@craft-ts/core'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"yield*","kind":"keyword"},{"text":" CraftRouter.","kind":"punctuation"},{"text":"navigate","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"  to: ","kind":"punctuation"},{"text":"'users/:userId/page/:page'","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"  params: { userId, page: ","kind":"punctuation"},{"text":"3","kind":"number"},{"text":" }, ","kind":"punctuation"},{"text":"// `page` is decoded here; the codec writes \"3\"","kind":"comment"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Routes that do not declare "},{"t":"code","text":"pathParams"},{"t":"text","text":" keep their existing raw parameter"},{"t":"text","text":" "},{"t":"text","text":"helpers and "},{"t":"code","text":"params"},{"t":"text","text":" remain strings. A declaration replaces only the matching"},{"t":"text","text":" "},{"t":"text","text":"parameter's type in "},{"t":"code","text":"CraftRouter"},{"t":"text","text":" navigation inputs."}]},{"t":"heading","level":2,"id":"query-string-codecs-are-mandatory","children":[{"t":"text","text":"Query string codecs are mandatory"}]},{"t":"paragraph","children":[{"t":"text","text":"A URL only holds strings, so every query parameter declares how it converts both ways."},{"t":"text","text":" "},{"t":"text","text":"The decoded type is your application type; the encoded one is what appears in the"},{"t":"text","text":" "},{"t":"text","text":"address bar."}]},{"t":"paragraph","children":[{"t":"code","text":"fallbackValue"},{"t":"text","text":" is what you get when the parameter is absent — which is why the"},{"t":"text","text":" "},{"t":"text","text":"state type is never "},{"t":"code","text":"undefined"},{"t":"text","text":"."}]},{"t":"paragraph","children":[{"t":"text","text":"Codecs stay synchronous because they run inside the reactive URL computation."},{"t":"text","text":" "},{"t":"code","text":"@craft-ts/core"},{"t":"text","text":" deliberately doesn't depend on a validation library: supply a"},{"t":"text","text":" "},{"t":"text","text":"small "},{"t":"code","text":"{ decode, encode }"},{"t":"text","text":" pair directly, or adapt one from the library you"},{"t":"text","text":" "},{"t":"text","text":"already use."}]},{"t":"code","lines":[{"tokens":[{"text":"// arrays","kind":"comment"}]},{"tokens":[{"text":"tags"},{"text":": {","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"fallbackValue"},{"text":": [],","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"codec"},{"text":": {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"decode"},{"text":": (","kind":"punctuation"},{"text":"value"},{"text":") ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" value.","kind":"punctuation"},{"text":"split","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"','","kind":"punctuation"},{"text":").","kind":"punctuation"},{"text":"filter","kind":"function"},{"text":"(Boolean),","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"encode"},{"text":": (","kind":"punctuation"},{"text":"value"},{"text":") ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" value.","kind":"punctuation"},{"text":"join","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"','","kind":"punctuation"},{"text":"),","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":"},","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"// plain strings","kind":"comment"}]},{"tokens":[{"text":"q"},{"text":": { ","kind":"punctuation"},{"text":"fallbackValue"},{"text":": ","kind":"punctuation"},{"text":"''","kind":"punctuation"},{"text":", ","kind":"punctuation"},{"text":"codec"},{"text":": { ","kind":"punctuation"},{"text":"decode"},{"text":": String, ","kind":"punctuation"},{"text":"encode"},{"text":": String } },","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The same pattern covers dates, enums and JSON-encoded objects."}]},{"t":"heading","level":2,"id":"effect-schema-adapter","children":[{"t":"text","text":"Effect Schema adapter"}]},{"t":"paragraph","children":[{"t":"text","text":"When the application already uses Effect Schema, keep "},{"t":"code","text":"queryParams"},{"t":"text","text":" as the URL"},{"t":"text