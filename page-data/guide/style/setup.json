{"kind":"doc","route":"/guide/style/setup","title":"Activating @craft-ts/style","blocks":[{"t":"heading","level":1,"id":"activating-craft-ts-style","children":[{"t":"text","text":"Activating "},{"t":"code","text":"@craft-ts/style"}]},{"t":"paragraph","children":[{"t":"text","text":"The typed style system is not a runtime library you import and call. It is a"},{"t":"text","text":" "},{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"build step"}]},{"t":"text","text":": a Vite plugin evaluates every "},{"t":"code","text":"*.style.ts"},{"t":"text","text":" in Node, deduplicates"},{"t":"text","text":" "},{"t":"text","text":"what they registered, and emits one stylesheet. Without that plugin the"},{"t":"text","text":" "},{"t":"text","text":"vocabulary still typechecks and still compiles — and the page renders with no"},{"t":"text","text":" "},{"t":"text","text":"CSS at all."}]},{"t":"paragraph","children":[{"t":"text","text":"This page is the one to follow before the other four."}]},{"t":"heading","level":2,"id":"install","children":[{"t":"text","text":"Install"}]},{"t":"code","lines":[{"tokens":[{"text":"npm","kind":"function"},{"text":" "},{"text":"install","kind":"string"},{"text":" "},{"text":"@craft-ts/style","kind":"string"}]},{"tokens":[{"text":"npm","kind":"function"},{"text":" "},{"text":"install","kind":"string"},{"text":" "},{"text":"--save-dev","kind":"string"},{"text":" "},{"text":"@craft-ts/dev-tools","kind":"string"}]},{"tokens":[{"text":"# Optional, for visual scenario matrices and attestation:","kind":"comment"}]},{"tokens":[{"text":"npm","kind":"function"},{"text":" "},{"text":"install","kind":"string"},{"text":" "},{"text":"--save-dev","kind":"string"},{"text":" "},{"text":"@craft-ts/style-testing","kind":"string"}]}],"filename":"","language":"bash","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"@craft-ts/style"},{"t":"text","text":" carries the vocabulary — tokens, kinds, typed custom"},{"t":"text","text":" "},{"t":"text","text":"properties, axes, sheets, obligations. "},{"t":"code","text":"@craft-ts/dev-tools"},{"t":"text","text":" carries the"},{"t":"text","text":" "},{"t":"code","text":"craft-graph"},{"t":"text","text":" contrast command and the ESLint guard rails."},{"t":"text","text":" "},{"t":"code","text":"@craft-ts/style-testing"},{"t":"text","text":" carries the optional scenario matrix and the drivers"},{"t":"text","text":" "},{"t":"text","text":"that reach each of its points; it never ships to the browser, so it belongs in"},{"t":"text","text":" "},{"t":"code","text":"devDependencies"},{"t":"text","text":" when visual scenarios or attestation are enabled."}]},{"t":"paragraph","children":[{"t":"code","text":"@craft-ts/style"},{"t":"text","text":" declares "},{"t":"code","text":"@craft-ts/core"},{"t":"text","text":" as a peer dependency, and"},{"t":"text","text":" "},{"t":"code","text":"@craft-ts/style-testing"},{"t":"text","text":" declares "},{"t":"code","text":"@craft-ts/style"},{"t":"text","text":". Keep all installed"},{"t":"text","text":" "},{"t":"code","text":"@craft-ts/*"},{"t":"text","text":" packages on the same release line. The runtime style package and"},{"t":"text","text":" "},{"t":"text","text":"the optional testing package are both "},{"t":"code","text":"sideEffects: false"},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"wire-the-plugin","children":[{"t":"text","text":"Wire the plugin"}]},{"t":"code","lines":[{"tokens":[{"text":"import","kind":"keyword"},{"text":" { defineConfig } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'vite'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[{"text":"import","kind":"keyword"},{"text":" { craftStyle } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'@craft-ts/style/vite'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"default","kind":"keyword"},{"text":" "},{"text":"defineConfig","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"  plugins: [","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"craftStyle","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"      ","kind":"punctuation"},{"text":"// Written on every emission, so the graph never reads a picture of the","kind":"comment"}]},{"tokens":[{"text":"      ","kind":"punctuation"},{"text":"// sheet that is older than the CSS the browser got.","kind":"comment"}]},{"tokens":[{"text":"      dumpPath: ","kind":"punctuation"},{"text":"'tmp/craft-style-graph.json'","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"    }),","kind":"punctuation"}]},{"tokens":[{"text":"  ],","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"craftStyle"},{"t":"text","text":" takes six options, all optional:"}]},{"t":"table","head":[[{"t":"text","text":"option"}],[{"t":"text","text":"default"}],[{"t":"text","text":"what it decides"}]],"rows":[[[{"t":"code","text":"suffix"}],[{"t":"code","text":"'.style.ts'"}],[{"t":"text","text":"the filename suffix that marks a module as a sheet"}]],[[{"t":"code","text":"ignore"}],[{"t":"code","text":"['node_modules', 'dist', '.git', '.nx', 'tmp']"}],[{"t":"text","text":"directory names the walk never descends into"}]],[[{"t":"code","text":"dumpPath"}],[{"t":"text","text":"none — no dump is written"}],[{"t":"text","text":"where to write the graph dump"}]],[[{"t":"code","text":"alias"}],[{"t":"text","text":"none"}],[{"t":"text","text":"module aliases for the "},{"t":"strong","children":[{"t":"text","text":"Node"}]},{"t":"text","text":" evaluation of the sheets"}]],[[{"t":"code","text":"reset"}],[{"t":"code","text":"true"}],[{"t":"text","text":"ship the craft-ts reset — see "},{"t":"link","href":"/craft/guide/style/foundation","external":false,"children":[{"t":"text","text":"Global foundation"}]}]],[[{"t":"code","text":"base"}],[{"t":"code","text":"true"}],[{"t":"text","text":"ship colour scheme, focus ring, reduced motion, selection"}]]]},{"t":"paragraph","children":[{"t":"code","text":"alias"},{"t":"text","text":" exists because the sheets are evaluated by a real bundler in a separate"},{"t":"text","text":" "},{"t":"text","text":"pass, before your app's own resolution applies. In a published project, Node"},{"t":"text","text":" "},{"t":"text","text":"resolution finds "},{"t":"code","text":"@craft-ts/style"},{"t":"text","text":" on its own and you can leave "},{"t":"code","text":"alias"},{"t":"text","text":" out. In"},{"t":"text","text":" "},{"t":"text","text":"this monorepo the demo passes the workspace source paths — see"},{"t":"text","text":" "},{"t":"link","href":"https://github.com/craft-ts/craft-ts/blob/main/apps/demo/vite.config.ts","external":true,"children":[{"t":"code","text":"apps/demo/vite.config.ts"}]},{"t":"text","text":","},{"t":"text","text":" "},{"t":"text","text":"which is the working reference for everything on this page."}]},{"t":"paragraph","children":[{"t":"text","text":"Then import the emitted sheet once, at the app entry:"}]},{"t":"code","lines":[{"tokens":[{"text":"import","kind":"keyword"},{"text":" "},{"text":"'virtual:craft-style.css'","kind":"punctuation"},{"text":";","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"If your "},{"t":"code","text":"tsconfig"},{"t":"text","text":" does not already know that id, declare it next to your other"},{"t":"text","text":" "},{"t":"text","text":"ambient types:"}]},{"t":"code","lines":[{"tokens":[{"text":"declare","kind":"keyword"},{"text":" "},{"text":"module","kind":"keyword"},{"text":" "},{"text":"'virtual:craft-style.css'","kind":"punctuation"},{"text":";","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"heading","level":2,"id":"what-the-plugin-produces","children":[{"t":"text","text":"What the plugin produces"}]},{"t":"paragraph","children":[{"t":"text","text":"Two artefacts, from one evaluation."}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"The CSS."}]},{"t":"text","text":" Every "},{"t":"code","text":"when(...)"},{"t":"text","text":" and "},{"t":"code","text":"set(...)"},{"t":"text","text":" the sheets registered, rendered as"},{"t":"text","text":" "},{"t":"text","text":"atomic rules and "},{"t":"code","text":"@property"},{"t":"text","text":" registrations, deduplicated across files, and"},{"t":"text","text":" "},{"t":"text","text":"served under "},{"t":"code","text":"virtual:craft-style.css"},{"t":"text","text":". This is the whole stylesheet: no class"},{"t":"text","text":" "},{"t":"text","text":"is ever assembled in the browser, so what the browser gets is exactly what the"},{"t":"text","text":" "},{"t":"text","text":"emitter proved."}]},{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"The dump"}]},{"t":"text","text":", when "},{"t":"code","text":"dumpPath"},{"t":"text","text":" is set. A JSON picture of the registry — classes,"},{"t":"text","text":" "},{"t":"text","text":"atoms, and typed variables — written on "},{"t":"em","children":[{"t":"text","text":"every"}]},{"t":"text","text":" emission, so it can never"},{"t":"text","text":" "},{"t":"text","text":"describe a sheet older than the CSS that was served alongside it. The dump is"},{"t":"text","text":" "},{"t":"text","text":"the style half of the dependency graph: it is what"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/style/testing#what-the-graph-adds","external":false,"children":[{"t":"code","text":"style_impact"},{"t":"text","text":", "},{"t":"code","text":"style_matrix"},{"t":"text","text":" and "},{"t":"code","text":"style_debt"}]},{"t":"text","text":" "},{"t":"text","text":"read, and what the "},{"t":"code","text":"@craft-ts/dev-tools"},{"t":"text","text":" style queries read."}]},{"t":"paragraph","children":[{"t":"text","text":"The plugin re-derives the whole sheet when a "},{"t":"code","text":"*.style.ts"},{"t":"text","text":" changes rather than"},{"t":"text","text":" "},{"t":"text","text":"patching it. Atomic output is small and the emission is one bundle away; an"},{"t":"text","text":" "},{"t":"text","text":"incremental path here would be a second source of truth about what the CSS says."}]},{"t":"heading","level":2,"id":"what-breaks-without-it","children":[{"t":"text","text":"What breaks without it"}]},{"t":"table","head":[[{"t":"text","text":"missing"}],[{"t":"text","text":"symptom"}]],"rows":[[[{"t":"text","text":"the plugin"}],[{"t":"text","text":"no CSS at all — the classes exist as strings, nothing ever wrote their rules"}]],[[{"t":"code","text":"import 'virtual:craft-style.css'"}],[{"t":"text","text":"same, and less obviously: the plugin runs but nothing pulls its output"}]],[[{"t":"code","text":"dumpPath"}],[{"t":"code","text":"style_matrix"},{"t":"text","text":" and the other graph queries have nothing to read and say so"}]]]},{"t":"paragraph","children":[{"t":"text","text":"The MCP server names the fix in its own error message: it points you back at"},{"t":"text","text":" "},{"t":"code","text":"craftStyle({ dumpPath })"},{"t":"text","text":". If you are reading this because you saw that"},{"t":"text","text":" "},{"t":"text","text":"message, "},{"t":"code","text":"dumpPath"},{"t":"text","text":" is the line you are missing."}]},{"t":"heading","level":2,"id":"emitting-without-a-vite-server","children":[{"t":"text","text":"Emitting without a Vite server"}]},{"t":"paragraph","children":[{"t":"code","text":"@craft-ts/style/vite"},{"t":"text","text":" exports the emitter itself, so a test or a script can get"},{"t":"text","text":" "},{"t":"text","text":"the same two artefacts without standing up a dev server:"}]},{"t":"code","lines":[{"tokens":[{"text":"import","kind":"keyword"},{"text":" { emitStyles } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'@craft-ts/style/vite'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"// The same two artefacts the plugin produces, without a Vite server: `css` is","kind":"comment"}]},{"tokens":[{"text":"// what the browser gets, `dump` is what the graph and the MCP tools read.","kind":"comment"}]},{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"emitOnce","kind":"function"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" () ","kind":"punctuation"},{"text":"=>","kind":"keyword"}]},{"tokens":[{"text":"  "},{"text":"emitStyles","kind":"function"},{"text":"([","kind":"punctuation"},{"text":"'src/app/ui/button.style.ts'","kind":"punctuation"},{"text":", ","kind":"punctuation"},{"text":"'src/app/ui/foundation.style.ts'","kind":"punctuation"},{"text":"]);","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"vite"},{"t":"text","text":" is a peer of that entry point, not a dependency: a project that builds"},{"t":"text","text":" "},{"t":"text","text":"with something else can still call "},{"t":"code","text":"emitStyles"},{"t":"text","text":" without pulling Vite's types"},{"t":"text","text":" "},{"t":"text","text":"into its own program."}]},{"t":"heading","level":2,"id":"next","children":[{"t":"text","text":"Next"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/style/define","external":false,"children":[{"t":"text","text":"Define your design system"}]},{"t":"text","text":" — palette, axes, theme: where "},{"t":"code","text":"bp"},{"t":"text","text":","},{"t":"text","text":" "},{"t":"code","text":"scheme"},{"t":"text","text":" and "},{"t":"code","text":"palette"},{"t":"text","text":" come from."}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/style/tokens","external":false,"children":[{"t":"text","text":"Tokens and typed variables"}]},{"t":"text","text":" — level 1."}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/style/variants","external":false,"children":[{"t":"text","text":"Axes and the visual matrix"}]},{"t":"text","text":" — level 2."}]}]]}],"outline":[{"level":2,"id":"install","text":"Install"},{"level":2,"id":"wire-the-plugin","text":"Wire the plugin"},{"level":2,"id":"what-the-plugin-produces","text":"What the plugin produces"},{"level":2,"id":"what-breaks-without-it","text":"What breaks without it"},{"level":2,"id":"emitting-without-a-vite-server","text":"Emitting without a Vite server"},{"level":2,"id":"next","text":"Next"}]}