"},{"text":"pagesRoutes"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftRoutes","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'pages'","kind":"punctuation"},{"text":", [","kind":"punctuation"}]},{"tokens":[{"text":"  {","kind":"punctuation"}]},{"tokens":[{"text":"    path: ","kind":"punctuation"},{"text":"'orders'","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"loadComponent","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"import","kind":"keyword"},{"text":"(","kind":"punctuation"},{"text":"'./orders-page'","kind":"punctuation"},{"text":"),","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":"]);","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"code","lines":[{"tokens":[{"text":"// orders-page.ts","kind":"comment"}]},{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"OrdersPage"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftComponent","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"/* ... */","kind":"punctuation"},{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Putting both declarations in "},{"t":"code","text":"pages.routes.ts"},{"t":"text","text":" makes route files grow into"},{"t":"text","text":" "},{"t":"text","text":"feature modules. Putting "},{"t":"code","text":"OrdersPage"},{"t":"text","text":" and "},{"t":"code","text":"CustomersPage"},{"t":"text","text":" in one"},{"t":"text","text":" "},{"t":"code","text":"pages.components.ts"},{"t":"text","text":" file creates the same problem at the lazy boundary: the"},{"t":"text","text":" "},{"t":"text","text":"chunk is no longer organized around one page entry point."}]},{"t":"paragraph","children":[{"t":"text","text":"The rule covers both eager route targets and lazy targets. A route collection"},{"t":"text","text":" "},{"t":"text","text":"may contain several routes, but each page component declaration still has its"},{"t":"text","text":" "},{"t":"text","text":"own source file. Child components rendered by a page are not route targets and"},{"t":"text","text":" "},{"t":"text","text":"are not restricted by this rule. Reusing the same component declaration from"},{"t":"text","text":" "},{"t":"text","text":"multiple routes is not treated as two page components."}]},{"t":"heading","level":2,"id":"the-intended-shape","children":[{"t":"text","text":"The intended shape"}]},{"t":"paragraph","children":[{"t":"text","text":"Keep the route tree responsible for navigation and loading:"}]},{"t":"code","lines":[{"tokens":[{"text":"// account.routes.ts","kind":"comment"}]},{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"accountRoutes"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftRoutes","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'account'","kind":"punctuation"},{"text":", [","kind":"punctuation"}]},{"tokens":[{"text":"  {","kind":"punctuation"}]},{"tokens":[{"text":"    path: ","kind":"punctuation"},{"text":"'profile'","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"loadComponent","kind":"function"},{"text":": ({ ","kind":"punctuation"},{"text":"withRetry"},{"text":" }) ","kind":"punctuation"},{"text":"=>","kind":"keyword"}]},{"tokens":[{"text":"      "},{"text":"withRetry","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"import","kind":"keyword"},{"text":"(","kind":"punctuation"},{"text":"'./profile-page'","kind":"punctuation"},{"text":")).","kind":"punctuation"},{"text":"then","kind":"function"},{"text":"((","kind":"punctuation"},{"text":"module"},{"text":") ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"module","kind":"type"},{"text":".ProfilePage),","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":"]);","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Keep the page implementation in its own file, with its own component"},{"t":"text","text":" "},{"t":"text","text":"dependencies and tests. "},{"t":"code","text":"loadChildren"},{"t":"text","text":" remains the right choice when a whole"},{"t":"text","text":" "},{"t":"text","text":"route collection should be lazy, while the collection's page components still"},{"t":"text","text":" "},{"t":"text","text":"follow this file boundary."}]},{"t":"heading","level":2,"id":"failure-message","children":[{"t":"text","text":"Failure message"}]},{"t":"paragraph","children":[{"t":"text","text":"The assertion reports the route, component and offending source file. Move each"},{"t":"text","text":" "},{"t":"text","text":"page component to its own sibling file, then keep the route's import literal so"},{"t":"text","text":" "},{"t":"text","text":"the router and bundler can discover the lazy boundary."}]},{"t":"heading","level":2,"id":"see-also","children":[{"t":"text","text":"See also"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/routing/setup","external":false,"children":[{"t":"text","text":"Routing setup"}]}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/routing/scaling","external":false,"children":[{"t":"text","text":"Scaling routes"}]}]}],[{"t":"paragraph","children":[{"t":"link","href":"/craft/guide/testing/architecture/route-di-proofs","external":false,"children":[{"t":"text","text":"Route DI proofs"}]}]}]]}],"outline":[{"level":2,"id":"what-it-prevents","text":"What it prevents"},{"level":2,"id":"the-intended-shape","text":"The intended shape"},{"level":2,"i