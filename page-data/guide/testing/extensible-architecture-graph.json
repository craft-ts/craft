":"only node ids and relations, so the metrics never move it."}]},{"t":"paragraph","children":[{"t":"text","text":"Nodes may also carry "},{"t":"code","text":"doc"},{"t":"text","text":" ("},{"t":"code","text":"summary"},{"t":"text","text":", "},{"t":"code","text":"tags"},{"t":"text","text":", "},{"t":"code","text":"rationale"},{"t":"text","text":") read from their"},{"t":"text","text":" "},{"t":"text","text":"declaration. The opt-in Markdown collector adds "},{"t":"code","text":"doc-page"},{"t":"text","text":" nodes and "},{"t":"code","text":"documents"},{"t":"text","text":" "},{"t":"text","text":"relations; both are part of the built-in vocabulary, so a renderer or a rule can"},{"t":"text","text":" "},{"t":"text","text":"rely on them without augmenting the registries."}]},{"t":"paragraph","children":[{"t":"text","text":"When the vocabulary changes, regenerate the committed architecture catalog and"},{"t":"text","text":" "},{"t":"text","text":"run the architecture suite:"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-graph","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--project","kind":"string"},{"text":" "},{"text":"apps/shop/tsconfig.graph.json","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--root","kind":"string"},{"text":" "},{"text":".","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--out","kind":"string"},{"text":" "},{"text":"apps/shop/architecture/catalog","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--format","kind":"string"},{"text":" "},{"text":"json","kind":"string"}]},{"tokens":[]},{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"nx","kind":"string"},{"text":" "},{"text":"architecture","kind":"string"},{"text":" "},{"text":"shop","kind":"string"}]}],"filename":"","language":"shell","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text"