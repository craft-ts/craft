ext":"};","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"For production-like tests, provide the real Layer. For focused tests, stub only"},{"t":"text","text":" "},{"t":"text","text":"the selected members and let "},{"t":"code","text":"UnstubbedEffectMember"},{"t":"text","text":" expose an unexpected read."}]},{"t":"heading","level":2,"id":"test-the-craft-service-or-component-by-register","children":[{"t":"text","text":"Test the Craft service or component by register"}]},{"t":"paragraph","children":[{"t":"text","text":"Craft tests still use a register derived from the Craft dependency graph:"}]},{"t":"code","lines":[{"tokens":[{"text":"const","kind":"keyword"},{"text":" { ","kind":"punctuation"},{"text":"sut"},{"text":" } ","kind":"punctuation"},{"text":"=","kind":"keyword"},{"text":" "},{"text":"await","kind":"keyword"},{"text":" "},{"text":"setupCraftServiceTestingByRegister","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  AccessDecisionService,","kind":"punctuation"}]},{"tokens":[{"text":"  {","kind":"punctuation"}]},{"tokens":[{"text":"    AccessPolicyService: ","kind":"punctuation"},{"text":"mockEffectService","kind":"function"},{"text":"(AccessPolicyService, {","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"decide","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" Effect.","kind":"punctuation"},{"text":"succeed","kind":"function"},{"text":"(expectedDecision),","kind":"punctuation"}]},{"tokens":[{"text":"    }),","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The exact register also includes regular Craft services, "},{"t":"code","text":"'real'"},{"t":"text","text":","},{"t":"text","text":" "},{"t":"code","text":"'notReached'"},{"t":"text","text":" or "},{"t":"code","text":"provideX()"},{"t":"text","text":" entries when those nodes are reachable. Effect"},{"t":"text","text":" "},{"t":"text","text":"service mocks cover the Effect side; the Craft register proves the full graph is"},{"t":"text","text":" "},{"t":"text","text":"accounted for."}]},{"t":"heading","level":2,"id":"test-the-bridge-and-adapters","children":[{"t":"text","text":"Test the bridge and adapters"}]},{"t":"paragraph","children":[{"t":"text","text":"Install and dispose the bridge per test suite:"}]},{"t":"code","lines":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" "},{"text":"dispose","kind":"function"},{"text":":","kind":"keyword"},{"text":" () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"void","kind":"type"},{"text":";","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"beforeEach","kind":"function"},{"text":"(() ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" {","kind":"punctuation"}]},{"tokens":[{"text":"  dispose "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"installCraftEffectBridge","kind":"function"},{"text":"();","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"afterEach","kind":"function"},{"text":"(() ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" {","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"dispose","kind":"function"},{"text":"();","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Cover at least one example of each channel: a typed failure becomes a Craft"},{"t":"text","text":" "},{"t":"text","text":"exception, "},{"t":"code","text":"Effect.die"},{"t":"text","text":" rejects as a technical error, and aborting the owning"},{"t":"text","text":" "},{"t":"text","text":"resource interrupts the Effect."}]},{"t":"heading","level":2,"id":"architecture-checks","children":[{"t":"text","text":"Architecture checks"}]},{"t":"paragraph","children":[{"t":"text","text":"The static graph includes the Effect backend automatically when"},{"t":"text","text":" "},{"t":"code","text":"analyzeDependencyGraph"},{"t":"text","text":" runs. It exposes typed nodes for "},{"t":"code","text":"effect-service"},{"t":"text","text":","},{"t":"text","text":" "},{"t":"code","text":"effect-operation"},{"t":"text","text":" and "},{"t":"code","text":"effect-layer"},{"t":"text","text":", together with "},{"t":"code","text":"requires-service"},{"t":"text","text":","},{"t":"text","text":" "},{"t":"code","text":"provided-by-layer"},{"t":"text","text":" and "},{"t":"code","text":"composes-layer"},{"t":"text","text":" relations. You can therefore write"},{"t":"text","text":" "},{"t":"text","text":"rules against Effect concepts just as you do against Craft nodes:"}]},{"t":"code","lines":[{"tokens":[{"text":"const","kind":"keyword"},{"text":" "},{"text":"effectServices"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" graph.","kind":"punctuation"},{"text":"nodes","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'effect-service'","kind":"punctuation"},{"text":");","kind":"punctuation"}]},{"tokens":[{"text":"const","kind":"keyword"},{"text":" "},{"text":"effectOperations"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" graph.","kind":"punctuation"},{"text":"nodes","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'effect-operation'","kind":"punctuation"},{"text":");","kind":"punctuation"}]},{"tokens":[{"text":"const","kind":"keyword"},{"text":" "},{"text":"effectLayers"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" graph.","kind":"punctuation"},{"text":"nodes","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'effect-layer'","kind":"punctuation"},{"text":");","kind":"punctuation"}]},{"tokens":[{"text":"const","kind":"keyword"},{"text":" "},{"text":"serviceRequirements"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" graph.","kind":"punctuation"},{"text":"edges","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'requires-service'","kind":"punctuation"},{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The built-in checks can then be kept beside the app's architecture tests:"}]},{"t":"code","lines":[{"tokens":[{"text":"assertCraftEffectNoNetwork","kind":"function"},{"text":"(graph.graph);","kind":"punctuation"}]},{"tokens":[{"text":"assertCraftEffectNoImperativeSync","kind":"function"},{"text":"(graph.graph);","kind":"punctuation"}]},{"tokens":[{"text":"assertDeclarativeArchitecture","kind":"function"},{"text":"(graph.graph);","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"For a project-specific invariant, inspect these typed nodes and relations in a"},{"t":"text","text":" "},{"t":"text","text":"custom assertion and fail the architecture test when the rule is violated. If"},{"t":"text","text":" "},{"t":"text","text":"you need to add concepts that the built-in Effect backend does not model, use"},{"t":"text","text":" "},{"t":"text","text":"the "},{"t":"link","href":"/craft/guide/testing/extensible-architecture-graph","external":false,"children":[{"t":"code","text":"DependencyGraphNodeRegistry"},{"t":"text","text":" and "},{"t":"code","text":"DependencyGraphCollector"}]},{"t":"text","text":"."},{"t":"text","text":" "},{"t":"text","text":"The Effect graph is already collected; no extra collector is needed just to"},{"t":"text","text":" "},{"t":"text","text":"apply rules to its services, operations or Layers."}]},{"t":"heading","level":2,"id":"what-you-gained","children":[{"t":"text","text":"What you gained"}]},{"t":"paragraph","children":[{"t":"text","text":"Tests that mirror the real Craft and Effect graphs: real composition by default,"},{"t":"text","text":" "},{"t":"text","text":"narrow mocks at the boundary, and architecture rules for the invariants that"},{"t":"text","text":" "},{"t":"text","text":"types alone cannot keep armed."}]},{"t":"row","layout":"between","children":[{"t":"paragraph","children":[{"t":"link","href":"/craft/learn-effect/07-forms-validation","external":false,"children":[{"t":"text","text":"← 7. Build forms and validate boundaries"}]}]},{"t":"paragraph","children":[{"t":"link","href":"/craft/learn-effect/09-server-functions","external":false,"children":[{"t":"text","text":"9. Call server functions — POC →"}]}]}]}],"outline":[{"level":2,"id":"test-an-effect-service-with-a-partial-mock","text":"Test an Effect service with a partial mock"},{"level":2,"id":"test-the-craft-service-or-component-by-register","text":"Test the Craft service or component by register"},{"level":2,"id":"test-the-bridge-and-adapters","text":"Test the bridge and adapters"},{"level":2,"id":"architecture-checks","text":"Architecture checks"},{"level":2,"id":"what-you-gained","text":"What you gained"}]}