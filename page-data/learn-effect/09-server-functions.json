uation"},{"text":"=>","kind":"keyword"},{"text":" ({ filter: ","kind":"punctuation"},{"text":"search","kind":"function"},{"text":"() }),","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"loader","kind":"function"},{"text":": ({ ","kind":"punctuation"},{"text":"params"},{"text":" }) ","kind":"punctuation"},{"text":"=>","kind":"keyword"}]},{"tokens":[{"text":"      Effect.","kind":"punctuation"},{"text":"gen","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"        "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"result"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" Effect.","kind":"punctuation"},{"text":"promise","kind":"function"},{"text":"(() ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"getUsers","kind":"function"},{"text":"(params));","kind":"punctuation"}]},{"tokens":[{"text":"        "},{"text":"if","kind":"keyword"},{"text":" (","kind":"punctuation"},{"text":"isCraftException","kind":"function"},{"text":"(result)) ","kind":"punctuation"},{"text":"return","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" Effect.","kind":"punctuation"},{"text":"fail","kind":"function"},{"text":"(result);","kind":"punctuation"}]},{"tokens":[{"text":"        "},{"text":"return","kind":"keyword"},{"text":" result;","kind":"punctuation"}]},{"tokens":[{"text":"      }),","kind":"punctuation"}]},{"tokens":[{"text":"  });","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The exact transport adapter is still experimental. The repository's"},{"t":"text","text":" "},{"t":"code","text":"demo-with-server-function"},{"t":"text","text":" app currently uses "},{"t":"code","text":"createServer"},{"t":"text","text":", "},{"t":"code","text":"executeEffect"},{"t":"text","text":" "},{"t":"text","text":"and a local HTTP bridge."}]},{"t":"heading","level":3,"id":"transport-failures-are-typed","children":[{"t":"text","text":"Transport failures are typed"}]},{"t":"paragraph","children":[{"t":"text","text":"The client transport always converts failures that prevent a usable server"},{"t":"text","text":" "},{"t":"text","text":"function response into a "},{"t":"code","text":"CraftException"},{"t":"text","text":" with "},{"t":"code","text":"_tag: 'HttpError'"},{"t":"text","text":" and"},{"t":"text","text":" "},{"t":"code","text":"scope: 'ServerFunctionClient'"},{"t":"text","text":". This includes a lost connection, an aborted"},{"t":"text","text":" "},{"t":"text","text":"request, a missing "},{"t":"code","text":"fetch"},{"t":"text","text":" implementation, a rejected custom transport and an"},{"t":"text","text":" "},{"t":"text","text":"unreadable response body. As with "},{"t":"code","text":"CraftHttpClient"},{"t":"text","text":", a network failure has"},{"t":"text","text":" "},{"t":"code","text":"payload.status === 0"},{"t":"text","text":"; the original failure is kept in "},{"t":"code","text":"payload.body"},{"t":"text","text":"."}]},{"t":"paragraph","children":[{"t":"text","text":"Server-side business failures remain their declared tags, so connection loss"},{"t":"text","text":" "},{"t":"text","text":"and domain errors can be handled separately by the same resource or mutation."}]},{"t":"heading","level":2,"id":"register-and-execute-on-the-server","children":[{"t":"text","text":"Register and execute on the server"}]},{"t":"code","lines":[{"tokens":[{"text":"const","kind":"keyword"},{"text":" "},{"text":"application"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"createServer","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"  functions: [listUsers],","kind":"punctuation"}]},{"tokens":[{"text":"  execute: ","kind":"punctuation"},{"text":"executeEffect","kind":"function"},{"text":"(runtimeLayer).run,","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The runtime Layer supplies server-only services such as a repository or the"},{"t":"text","text":" "},{"t":"text","text":"current user. Never import secrets, credentials or server implementations into"},{"t":"text","text":" "},{"t":"text","text":"a client module."}]},{"t":"heading","level":2,"id":"middleware-and-security","children":[{"t":"text","text":"Middleware and security"}]},{"t":"paragraph","children":[{"t":"text","text":"The current demo also shows Effect middleware:"}]},{"t":"code","lines":[{"tokens":[{"text":"const","kind":"keyword"},{"text":" "},{"text":"audited"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"effectServerMiddleware","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'demo.audit'","kind":"punctuation"},{"text":", ({ ","kind":"punctuation"},{"text":"next"},{"text":" }) ","kind":"punctuation"},{"text":"=>","kind":"keyword"}]},{"tokens":[{"text":"  Effect.","kind":"punctuation"},{"text":"gen","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"yield*","kind":"keyword"},{"text":" Effect.","kind":"punctuation"},{"text":"log","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'before'","kind":"punctuation"},{"text":");","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"result"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" Effect.","kind":"punctuation"},{"text":"exit","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"next","kind":"function"},{"text":"());","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"yield*","kind":"keyword"},{"text":" Effect.","kind":"punctuation"},{"text":"log","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'after'","kind":"punctuation"},{"text":");","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"return","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" result;","kind":"punctuation"}]},{"tokens":[{"text":"  }),","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Middleware may add typed failures, resolve Effect services and run before/after"},{"t":"text","text":" "},{"t":"text","text":"hooks. Client claims remain untrusted; authenticate and authorize again on the"},{"t":"text","text":" "},{"t":"text","text":"server, then publish only verified values to the handler context."}]},{"t":"heading","level":2,"id":"current-limitations","children":[{"t":"text","text":"Current limitations"}]},{"t":"paragraph","children":[{"t":"text","text":"Treat these as constraints of the POC, not promises of the final design:"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"the browser transport and development plugin are local experimental adapters;"}]}],[{"t":"paragraph","children":[{"t":"text","text":"client/server file boundaries are checked by the current architecture graph,"},{"t":"text","text":" "},{"t":"text","text":"but deployment integration is still evolving;"}]}],[{"t":"paragraph","children":[{"t":"text","text":"middleware APIs and the server registry may be renamed or reshaped;"}]}],[{"t":"paragraph","children":[{"t":"text","text":"the server must re-check authorization even if the client has a matching"},{"t":"text","text":" "},{"t":"text","text":"Effect Layer."}]}]]},{"t":"paragraph","children":[{"t":"text","text":"See the running examples in"},{"t":"text","text":" "},{"t":"link","href":"https://github.com/craft-ts/craft-ts/tree/main/apps/demo-with-server-function","external":true,"children":[{"t":"code","text":"apps/demo-with-server-function"}]},{"t":"text","text":" "},{"t":"text","text":"and the server-function architecture plan in the repository when this work is"},{"t":"text","text":" "},{"t":"text","text":"promoted out of the prototype area."}]},{"t":"heading","level":2,"id":"what-you-gained","children":[{"t":"text","text":"What you gained"}]},{"t":"paragraph","children":[{"t":"text","text":"You can experiment with typed Effect server calls while keeping an explicit"},{"t":"text","text":" "},{"t":"text","text":"client/server boundary. Keep this chapter isolated from stable application"},{"t":"text","text":" "},{"t":"text","text":"contracts until the POC is replaced by a final server-function API."}]},{"t":"row","layout":"between","children":[{"t":"paragraph","children":[{"t":"link","href":"/craft/learn-effect/08-testing","external":false,"children":[{"t":"text","text":"← 8. Test the graph"}]}]},{"t":"paragraph","children":[{"t":"link","href":"/craft/learn-effect/","external":false,"children":[{"t":"text","text":"Back to the overview →"}]}]}]}],"outline":[{"level":2,"id":"the-current-shape","text":"The current shape"},{"level":2,"id":"define-the-server-implementation","text":"Define the server implementation"},{"level":2,"id":"define-the-client-facade","text":"Define the client facade"},{"level":3,"id":"transport-failures-are-typed","text":"Transport failures are typed"},{"level":2,"id":"register-and-execute-on-the-server","text":"Register and execute on the server"},{"level":2,"id":"middleware-and-security","text":"Middleware and security"},{"level":2,"id":"current-limitations","text":"Current limitations"},{"level":2,"id":"what-you-gained","text":"What you gained"}]}