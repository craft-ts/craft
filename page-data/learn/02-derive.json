n":[{"t":"text","text":"The library ships ready-made ones — storage persistence, optimistic updates,"},{"t":"text","text":" "},{"t":"text","text":"pagination placeholders, forms. They are the exact same shape as the functions"},{"t":"text","text":" "},{"t":"text","text":"you just wrote. See "},{"t":"link","href":"/craft/guide/concepts/insertions","external":false,"children":[{"t":"text","text":"Insertions"}]},{"t":"text","text":"."}]}]},{"t":"heading","level":2,"id":"what-you-gained","children":[{"t":"text","text":"What you gained"}]},{"t":"paragraph","children":[{"t":"text","text":"State that carries its own behaviour, a template that only renders, and a"},{"t":"text","text":" "},{"t":"text","text":"composition mechanism that scales past the first three methods."}]},{"t":"row","layout":"between","children":[{"t":"paragraph","children":[{"t":"link","href":"/craft/learn/01-first-state","external":false,"children":[{"t":"text","text":"← 1. Your first state"}]}]},{"t":"paragraph","children":[{"t":"link","href":"/craft/learn/03-service","external":false,"children":[{"t":"text","text":"3. Move logic out of the component →"}]}]}]}],"outline":[{"level":2,"id":"the-insertion-argument","text":"The insertion argument"},{"level":2,"id":"the-whole-component","text":"The whole component"},{"level":2,"id":"control-flow","text":"Control flow"},{"level":3,"id":"why-not-a-plain-ternary-or-switch","text":"Why not a plain ternary or switch?"},{"level":2,"id":"reusing-behaviour-across-components","text":"Reusing behaviour across components"},{"level":2,"id":"every-exception-a-component-picks-up-must-be-handled","text":"Every exception a component picks up must be handled"},{"level":2,"id":"several-insertions-at-once","text":"Several insertions at once"},{"level":2,"id":"what-you-gained","text":"What you gained"}]}