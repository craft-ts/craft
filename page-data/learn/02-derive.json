ildren":[{"t":"text","text":"Two template things worth noting. "},{"t":"code","text":"forNode(source, options, render)"},{"t":"text","text":" takes a"},{"t":"text","text":" "},{"t":"code","text":"track"},{"t":"text","text":" — the stable identity the renderer uses to reuse, move and remove"},{"t":"text","text":" "},{"t":"text","text":"nodes — and an optional "},{"t":"code","text":"empty"},{"t":"text","text":" branch. Pass the reader itself ("},{"t":"code","text":"tasks"},{"t":"text","text":") rather"},{"t":"text","text":" "},{"t":"text","text":"than "},{"t":"code","text":"() => tasks()"},{"t":"text","text":". When a binding must format or call a method, use a"},{"t":"text","text":" "},{"t":"text","text":"generator and "},{"t":"code","text":"yield*"},{"t":"text","text":"."}]},{"t":"paragraph","children":[{"t":"text","text":"What the component declares is now three lines. That's the point: "},{"t":"strong","children":[{"t":"text","text":"behaviour"},{"t":"text","text":" "},{"t":"text","text":"lives on the state, not around it."}]},{"t":"text","text":""}]},{"t":"heading","level":2,"id":"control-flow","children":[{"t":"text","text":"Control flow"}]},{"t":"paragraph","children":[{"t":"text","text":"Craft templates are TypeScript, so control flow is made of functions rather than"},{"t":"text","text":" "},{"t":"text","text":"syntax. Each block is a typed function with an explicit contract:"}]},{"t":"table","head":[[{"t":"text","text":"Block"}],[{"t":"text","text":"Purpose"}]],"rows":[[[{"t":"code","text":"forNode"}],[{"t":"text","text":"Renders a collection with stable tracking and an optional empty branch"}]],[[{"t":"code","text":"ifNode"}],[{"t":"text","text":"Preserves a conditional branch in the render contract"}]],[[{"t":"code","text":"matchNode.exhaustive"}],[{"t":"text","text":"Matches every member of a discriminated union"}]],[[{"t":"code","text":"deferNode"}],[{"t":"text","text":"Loads a branch lazily"}]]]},{"t":"paragraph","children":[{"t":"code","text":"matchNode.exhaustive"},{"t":"text","text":" matches on a "},{"t":"strong","children":[{"t":"text","text":"discriminant key"}]},{"t":"text","text":" of a union and the"},{"t":"text","text":" "},{"t":"text","text":"handler map must cover every member — a missing case is a compile error."}]},{"t":"code","lines":[{"tokens":[{"text":"matchNode.","kind":"punctuation"},{"text":"exhaustive","kind":"function"},{"text":"(() ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" tasksQuery.","kind":"punctuation"},{"text":"exceptions","kind":"function"},{"text":"().loader, ","kind":"punctuation"},{"text":"'_tag'","kind":"punctuation"},{"text":", {","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"TASK_NOT_FOUND","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"p","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'This task no longer exists.'","kind":"punctuation"},{"text":"),","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"TASK_FORBIDDEN","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"p","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'You do not have access to it.'","kind":"punctuation"},{"text":"),","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"heading","level":3,"id":"why-not-a-plain-ternary-or-switch","children":[{"t":"text","text":"Why not a plain ternary or "},{"t":"code","text":"switch"},{"t":"text","text":"?"}]},{"t":"paragraph","children":[{"t":"text","text":"Because a raw TypeScript conditional "},{"t":"strong","children":[{"t":"text","text":"collapses"}]},{"t":"text","text":". The template type ends up"},{"t":"text","text":" "},{"t":"text","text":"holding the "},{"t":"em","children":[{"t":"text","text":"result"}]},{"t":"text","text":" of the branch, not the fact that a branch existed:"}]},{"t":"code","lines":[{"tokens":[{"text":"// works at runtime, but the contract is now opaque","kind":"comment"}]},{"tokens":[{"text":"tasks.","kind":"punctuation"},{"text":"isEmpty","kind":"function"},{"text":"() ","kind":"punctuation"},{"text":"?","kind":"keyword"},{"text":" "},{"text":"p","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'Nothing to do'","kind":"punctuation"},{"text":") ","kind":"punctuation"},{"text":":","kind":"keyword"},{"text":" "},{"text":"ul","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"/* … */","kind":"punctuation"},{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"ifNode"},{"t":"text","text":" and "},{"t":"code","text":"matchNode"},{"t":"text","text":" keep the condition "},{"t":"strong","children":[{"t":"text","text":"and both branches"}]},{"t":"text","text":" in the node"},{"t":"text","text":" "},{"t":"text","text":"contract. That is what lets you assert, at compile time, that an element renders"},{"t":"text","text":" "},{"t":"em","children":[{"t":"text","text":"only"}]},{"t":"text","text":" when a condition holds, or that a label renders for every item of a"},{"t":"text","text":" "},{"t":"text","text":"non-empty list — see "},{"t":"link","href":"/craft/guide/testing/type-level","external":false,"children":[{"t":"text","text":"Type-level tests"}]},{"t":"text","text":". With a"},{"t":"text","text":" "},{"t":"text","text":"ternary those assertions have nothing to inspect."}]},{"t":"paragraph","children":[{"t":"text","text":"The renderer also uses the block structure to update surgically instead of"},{"t":"text","text":" "},{"t":"text","text":"rebuilding the subtree."}]},{"t":"callout","tone":"tip","caption":"When a ternary is fine","children":[{"t":"paragraph","children":[{"t":"text","text":"For a leaf value — a class name, a piece of text, an attribute — a ternary is"},{"t":"text","text":" "},{"t":"text","text":"the right tool. The rule concerns "},{"t":"strong","children":[{"t":"text","text":"structure"}]},{"t":"text","text":": whenever a branch decides"},{"t":"text","text":" "},{"t":"text","text":"whether an element exists, reach for "},{"t":"code","text":"ifNode"},{"t":"text","text":" or "},{"t":"code","text":"matchNode"},{"t":"text","text":"."}]}]},{"t":"paragraph","children":[{"t":"code","text":"ifNode"},{"t":"text","text":" takes a "},{"t":"strong","children":[{"t":"text","text":"named"}]},{"t":"text","text":" reactive value as its condition (a primitive ref, or"},{"t":"text","text":" "},{"t":"text","text":"a value marked with "},{"t":"code","text":"markYieldableValue"},{"t":"text","text":"), because that name is what the"},{"t":"text","text":" "},{"t":"text","text":"visibility contract records."}]},{"t":"heading","level":2,"id":"reusing-behaviour-across-components","children":[{"t":"text","text":"Reusing behaviour across components"}]},{"t":"paragraph","children":[{"t":"text","text":"An insertion factors logic out of a "},{"t":"strong","children":[{"t":"text","text":"primitive"}]},{"t":"text","text":". Its counterpart for"},{"t":"text","text":" "},{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"components"}]},{"t":"text","text":" is a directive: "},{"t":"code","text":"craftDirective"},{"t":"text","text":" transforms the service a"},{"t":"text","text":" "},{"t":"text","text":"component takes and the template it returns, and you attach it with "},{"t":"code","text":".pipe(...)"},{"t":"text","text":":"}]},{"t":"code","lines":[{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"Card"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftComponent","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'Card'","kind":"punctuation"},{"text":", {}, ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" (","kind":"punctuation"},{"text":"inputs"},{"text":":","kind":"keyword"},{"text":" {","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"readonly","kind":"keyword"},{"text":" "},{"text":"user"},{"text":":","kind":"keyword"},{"text":" "},{"text":"Input","kind":"type"},{"text":"<","kind":"punctuation"},{"text":"User","kind":"type"},{"text":">;","kind":"punctuation"}]},{"tokens":[{"text":"}) {","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"const","kind":"keyword"},{"text":" { ","kind":"punctuation"},{"text":"user"},{"text":" } ","kind":"punctuation"},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"CardView","kind":"function"},{"text":"(inputs);","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"return","kind":"keyword"},{"text":" "},{"text":"div","kind":"function"},{"text":"(user.name);","kind":"punctuation"}]},{"tokens":[{"text":"}).","kind":"punctuation"},{"text":"pipe","kind":"function"},{"text":"(InteractivePermissions);","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The directive can enrich what the component reads from its service — here a"},{"t":"text","text":" "},{"t":"code","text":"permissions"},{"t":"text","text":" façade the component never had to declare — and directives compose"},{"t":"text","text":" "},{"t":"text","text":"left to right. That is how a tooltip, focus management or interaction analytics"},{"t":"text","text":" "},{"t":"text","text":"get added to several components without any of them knowing about it."}]},{"t":"paragraph","children":[{"t":"text","text":"The full pattern — writing a directive, what it can require from its host, and"},{"t":"text","text":" "},{"t":"text","text":"how styles compose — is on"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/components/directives","external":false,"children":[{"t":"text","text":"Directives and "},{"t":"code","text":".pipe(...)"}]},{"t":"text","text":". See also"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/components/customization","external":false,"children":[{"t":"text","text":"Customization"}]},{"t":"text","text":" for the three layers of"},{"t":"text","text":" "},{"t":"text","text":"component customization, and "},{"t":"link","href":"/craft/guide/components/styles","external":false,"children":[{"t":"text","text":"Styling a component"}]},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"every-exception-a-component-picks-up-must-be-handled","children":[{"t":"text","text":"Every exception a component picks up must be handled"}]},{"t":"paragraph","children":[{"t":"text","text":"If a component — or one of its providers — can raise a "},{"t":"code","text":"craftException"},{"t":"text","text":", that"},{"t":"text","text":" "},{"t":"text","text":"code becomes part of the component's contract. It has to"},{"t":"text","text":" "},{"t":"text","text":"be dealt with, and the compiler is the one that says so:"}]},{"t":"code","lines":[{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"Restricted"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" MyComponent.","kind":"punctuation"},{"text":"pipe","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  catchNode.","kind":"punctuation"},{"text":"exhaustive","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"NO_ACCESS","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"p","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'You do not have access to this data.'","kind":"punctuation"},{"text":"),","kind":"punctuation"}]},{"tokens":[{"text":"  }),","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"catchNode.exhaustive"},{"t":"text","text":" is the one you want most of the time: it renders a"},{"t":"text","text":" "},{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"fallback"}]},{"t":"text","text":". When the failure happens while the component is declaring what it"},{"t":"text","text":" "},{"t":"text","text":"takes — before there are any nodes — the fallback simply renders alone."}]},{"t":"paragraph","children":[{"t":"text","text":"Handle it here and the code disappears from the contract. Leave it and it flows"},{"t":"text","text":" "},{"t":"text","text":"up to the route, where "},{"t":"code","text":"handleExceptions"},{"t":"text","text":" "},{"t":"strong","children":[{"t":"text","text":"must"}]},{"t":"text","text":" cover it — a reachable code"},{"t":"text","text":" "},{"t":"text","text":"with no handler doesn't compile, and neither does a handler for a code nothing"},{"t":"text","text":" "},{"t":"text","text":"can produce."}]},{"t":"callout","tone":"warning","caption":"Where the error actually lands today","children":[{"t":"paragraph","children":[{"t":"text","text":"The compile-time enforcement is at the "},{"t":"strong","children":[{"t":"text","text":"route"}]},{"t":"text","text":""},{"t":"text","text":" "},{"t":"text","text":"("},{"t":"code","text":"assertExhaustiveRouteExceptions"},{"t":"text","text":"). The component "},{"t":"code","text":".pipe(...)"},{"t":"text","text":" overload is"},{"t":"text","text":" "},{"t":"text","text":"currently kept permissive to avoid excessive TypeScript instantiation depth, so"},{"t":"text","text":" "},{"t":"text","text":"an unhandled code there is caught by runtime dispatch instead. Practical"},{"t":"text","text":" "},{"t":"text","text":"consequence: a component rendered outside any route gets no compile-time"},{"t":"text","text":" "},{"t":"text","text":"reminder — handle its codes explicitly."}]},{"t":"paragraph","children":[{"t":"text","text":"The whole rule is on "},{"t":"link","href":"/craft/guide/concepts/exceptions","external":false,"children":[{"t":"text","text":"An unhandled exception doesn't just"},{"t":"text","text":" "},{"t":"text","text":"disappear"}]},{"t":"text","text":"."}]}]},{"t":"paragraph","children":[{"t":"code","text":"matchNode.exhaustive"},{"t":"text","text":" is the sibling for rendering from an exception "},{"t":"em","children":[{"t":"text","text":"value"}]},{"t":"text","text":" "},{"t":"text","text":"or signal. Reach for "},{"t":"code","text":"catchTag.exhaustive"},{"t":"text","text":" only when the reaction is pure"},{"t":"text","text":" "},{"t":"text","text":"logic — a toast, a log — and produces no DOM."}]},{"t":"heading","level":2,"id":"several-insertions-at-once","children":[{"t":"text","text":"Several insertions at once"}]},{"t":"paragraph","children":[{"t":"text","text":"One insertion function gets crowded fast. Split it and compose with "},{"t":"code","text":"insertStatePipe"},{"t":"text","text":":"}]},{"t":"code","lines":[{"tokens":[{"text":"import","kind":"keyword"},{"text":" { insertStatePipe, craftComputed, craftService, state, craftUse } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'@craft-ts/core'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"const","kind":"keyword"},{"text":" { ","kind":"punctuation"},{"text":"TaskList"},{"text":" } ","kind":"punctuation"},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftService","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  { name: ","kind":"punctuation"},{"text":"'TaskList'","kind":"punctuation"},{"text":", providedIn: ","kind":"punctuation"},{"text":"'function'","kind":"punctuation"},{"text":" },","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"state","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"'tasks'","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"      [] ","kind":"punctuation"},{"text":"as","kind":"keyword"},{"text":" "},{"text":"Task","kind":"type"},{"text":"[],","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"insertStatePipe","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"        ({ ","kind":"punctuation"},{"text":"update"},{"text":" }) ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" ({","kind":"punctuation"}]},{"tokens":[{"text":"          "},{"text":"add","kind":"function"},{"text":": (","kind":"punctuation"},{"text":"title"},{"text":":","kind":"keyword"},{"text":" "},{"text":"string","kind":"type"},{"text":") ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"update","kind":"function"},{"text":"((","kind":"punctuation"},{"text":"c"},{"text":") ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" [","kind":"punctuation"},{"text":"...","kind":"keyword"},{"text":"c, ","kind":"punctuation"},{"text":"newTask","kind":"function"},{"text":"(title)]),","kind":"punctuation"}]},{"tokens":[{"text":"        }),","kind":"punctuation"}]},{"tokens":[{"text":"        ({ ","kind":"punctuation"},{"text":"state"},{"text":" }) ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" ({","kind":"punctuation"}]},{"tokens":[{"text":"          remaining: ","kind":"punctuation"},{"text":"craftUse","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"craftComputed","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'remaining'","kind":"punctuation"},{"text":", ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"            "},{"text":"return","kind":"keyword"},{"text":" (","kind":"punctuation"},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"state","kind":"function"},{"text":"()).","kind":"punctuation