omponent"},{"t":"text","text":" "},{"t":"text","text":"owns this mutable state."}]},{"t":"heading","level":2,"id":"using-it","children":[{"t":"text","text":"Using it"}]},{"t":"paragraph","children":[{"t":"text","text":"The component mounts one service instance in its provider scope, then resolves"},{"t":"text","text":" "},{"t":"text","text":"it without passing inputs each time:"}]},{"t":"code","lines":[{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"Tasks"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftComponent","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"'Tasks'","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"  { providers: [","kind":"punctuation"},{"text":"provideTaskList","kind":"function"},{"text":"()] },","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"const","kind":"keyword"},{"text":" { ","kind":"punctuation"},{"text":"tasks"},{"text":" } ","kind":"punctuation"},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"TaskList","kind":"function"},{"text":"();","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"    "},{"text":"return","kind":"keyword"},{"text":" [","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"/* unchanged */","kind":"punctuation"}]},{"tokens":[{"text":"    ];","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"craftService"},{"t":"text","text":" returns a helper named after the service — here "},{"t":"code","text":"TaskList"},{"t":"text","text":". There"},{"t":"text","text":" "},{"t":"text","text":"is no "},{"t":