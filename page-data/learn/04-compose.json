{"t":"text","text":". Craft uses it as a "},{"t":"strong","children":[{"t":"text","text":"collection channel"}]},{"t":"text","text":": each "},{"t":"code","text":"yield*"},{"t":"text","text":" reports \"I need"},{"t":"text","text":" "},{"t":"text","text":"this\" to the runtime driving the factory, which resolves it and folds it into the"},{"t":"text","text":" "},{"t":"text","text":"graph."}]},{"t":"paragraph","children":[{"t":"text","text":"You don't manage that channel yourself. In practice the whole rule is:"}]},{"t":"quote","children":[{"t":"paragraph","children":[{"t":"text","text":"Every named entity yields what it does not own. A factory, a computed, a"},{"t":"text","text":" "},{"t":"text","text":"method — each one records "},{"t":"strong","children":[{"t":"text","text":"its"}]},{"t":"text","text":" dependencies with "},{"t":"code","text":"yield*"},{"t":"text","text":"."}]}]},{"t":"code","lines":[{"tokens":[{"text":"const","kind":"keyword"},{"text":" "},{"text":"api"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"TaskApi","kind":"function"},{"text":"(); ","kind":"punctuation"},{"text":"// a service","kind":"comment"}]},{"tokens":[{"text":"const","kind":"keyword"},{"text":" "},{"text":"tasks"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"state","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'tasks'","kind":"punctuation"},{"text":", []); ","kind":"punctuation"},{"text":"// a primitive","kind":"comment"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"callout","tone":"warning","caption":"A primitive is single-use","children":[{"t":"paragraph","children":[{"t":"text","text":"Each "},{"t":"code","text":"state(...)"},{"t":"text","text":" / "},{"t":"code","text":"query(...)"},{"t":"text","text":" call produces one generator, consumed exactly"},{"t":"text","text":" "},{"t":"text","text":"once. Don't store one and "},{"t":"code","text":"yield*"},{"t":"text","text":" it twice."}]}]},{"t":"heading","level":2,"id":"composing-two-services","children":[{"t":"text","text":"Composing two services"}]},{"t":"code","lines":[{"tokens":[{"text":"const","kind":"keyword"},{"text":" { ","kind":"punctuation"},{"text":"TaskApi"},{"text":" } ","kind":"punctuation"},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftService","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  { name: ","kind":"punctuation"},{"text":"'TaskApi'","kind":"punctuation"},{"text":", providedIn: ","kind":"punctuation"},{"text":"'global'","kind":"punctuation"},{"text":" },","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    ","kind":"punctuation"},{"text":"// raw fetch, only to keep this example about composition —","kind":"comment"}]},{"tokens":[{"text":"    ","kind":"punctuation"},{"text":"// see the note below","kind":"comment"}]},{"tokens":[{"text":"    "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"craftExpose","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'fetchAll'","kind":"punctuation"},{"text":", () ","kind":"punctuation"},{"text":"=>","kind":"keyword"}]},{"tokens":[{"text":"      "},{"text":"fetch","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'/api/tasks'","kind":"punctuation"},{"text":").","kind":"punctuation"},{"text":"then","kind":"function"},{"text":"((","kind":"punctuation"},{"text":"r"},{"text":") ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" r.","kind":"punctuation"},{"text":"json","kind":"function"},{"text":"()),","kind":"punctuation"}]},{"tokens":[{"text":"    );","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"const","kind":"keyword"},{"text":" { ","kind":"punctuation"},{"text":"TaskList"},{"text":" } ","kind":"punctuation"},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftService","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  { name: ","kind":"punctuation"},{"text":"'TaskList'","kind":"punctuation"},{"text":", providedIn: ","kind":"punctuation"},{"text":"'function'","kind":"punctuation"},{"text":" },","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"api"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"TaskApi","kind":"function"},{"text":"();","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"state","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'tasks'","kind":"punctuation"},{"text":", [] ","kind":"punctuation"},{"text":"as","kind":"keyword"},{"text":" "},{"text":"Task","kind":"type"},{"text":"[], ({ ","kind":"punctuation"},{"text":"set"},{"text":" }) ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" ({","kind":"punctuation"}]},{"tokens":[{"text":"      ","kind":"punctuation"},{"text":"// For this demo only; we'll later see why this belongs in a mutation instead.","kind":"comment"}]},{"tokens":[{"text":"      "},{"text":"load","kind":"function"},{"text":": ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"        "},{"text":"return","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"set","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"yield*","kind":"keyword"},{"text":" api.","kind":"punctuation"},{"text":"fetchAll","kind":"function"},{"text":"());","kind":"punctuation"}]},{"tokens":[{"text":"      },","kind":"punctuation"}]},{"tokens":[{"text":"    }));","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"const","kind":"keyword"},{"text":" { ","kind":"punctuation"},{"text":"TaskStats"},{"text":" } ","kind":"punctuation"},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftService","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  { name: ","kind":"punctuation"},{"text":"'TaskStats'","kind":"punctuation"},{"text":", providedIn: ","kind":"punctuation"},{"text":"'function'","kind":"punctuation"},{"text":" },","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"const","kind":"keyword"},{"text":" { ","kind":"punctuation"},{"text":"tasks"},{"text":" } ","kind":"punctuation"},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"TaskList","kind":"function"},{"text":"();","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"craftComputed","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'done'","kind":"punctuation"},{"text":", ","kind":"punctuation"},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"return","kind":"keyword"},{"text":" (","kind":"punctuation"},{"text":"yield*","kind":"keyword"},{"text":" "},{"text":"tasks","kind":"function"},{"text":"()).","kind":"punctuation"},{"text":"filter","kind":"function"},{"text":"((","kind":"punctuation"},{"text":"t"},{"text":") ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" t.done).","kind":"punctuation"},{"text":"length"},{"text":";","kind":"punctuation"}]},{"tokens":[{"text":"    });","kind":"punctuation"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"A service's factory is always a generator: its API is what it yields. A named"},{"t":"text","text":" "},{"t":"text","text":"primitive is exposed under its name; anything else — like "},{"t":"code","text":"fetchAll"},{"t":"text","text":" — is"},{"t":"text","text":" "},{"t":"text","text":"exposed with "},{"t":"code","text":"craftExpose(name, value)"},{"t":"text","text":"."}]},{"t":"paragraph","children":[{"t":"code","text":"TaskStats"},{"t":"text","text":" does not own "},{"t":"code","text":"TaskList"},{"t":"text","text":". The computed yields "},{"t":"code","text":"tasks"},{"t":"text","text":" so "},{"t":"strong","children":[{"t":"text","text":"that"}]},{"t":"text","text":""},{"t":"text","text":" "},{"t":"text","text":"read is recorded on "},{"t":"code","text":"done"},{"t":"text","text":", not silently closed over from the factory."}]},{"t":"callout","tone":"warning","caption":"Don't call `fetch` directly in real code","children":[{"t":"paragraph","children":[{"t":"text","text":"It is used here only to keep the example about composition. HTTP goes through"},{"t":"text","text":" "},{"t":"text","text":""},{"t":"strong","children":[{"t":"code","text":"CraftHttpClient"}]},{"t":"text","text":", which is yieldable — so the request is tracked like any"},{"t":"text","text":" "},{"t":"text","text":"other dependency, it is mockable at the "},{"t":"link","href":"/craft/guide/testing/browser-boundaries","external":false,"children":[{"t":"text","text":"browser"},{"t":"text","text":" "},{"t":"text","text":"boundary"}]},{"t":"text","text":" in tests, and above all it is what"},{"t":"text","text":" "},{"t":"text","text":"turns a failed response into a typed "},{"t":"code","text":"craftException"},{"t":"text","text":" you can handle."}]},{"t":"paragraph","children":[{"t":"text","text":"A raw "},{"t":"code","text":"fetch"},{"t":"text","text":" gives you none of that: no tracking, no boundary, and a rejected"},{"t":"text","text":" "},{"t":"text","text":"promise instead of a declared failure. "},{"t":"link","href":"/craft/learn/05-load-data","external":false,"children":[{"t":"text","text":"Step 5"}]},{"t":"text","text":" uses"},{"t":"text","text":" "},{"t":"code","text":"CraftHttpClient"},{"t":"text","text":" for real, and "},{"t":"link","href":"/craft/learn/06-mutate-data","external":false,"children":[{"t":"text","text":"step 6"}]},{"t":"text","text":" shows the"},{"t":"text","text":" "},{"t":"text","text":"exceptions it produces."}]},{"t":"paragraph","children":[{"t":"text","text":"The "},{"t":"code","text":"craft-ts/prefer-craft-http-client"},{"t":"text","text":" ESLint rule flags direct "},{"t":"code","text":"HttpClient"},{"t":"text","text":" "},{"t":"text","text":"usage for the same reason."}]}]},{"t":"heading","level":2,"id":"taking-only-what-you-need","children":[{"t":"text","text":"Taking only what you need"}]},{"t":"paragraph","children":[{"t":"code","text":"TaskStats"},{"t":"text","text":" only reads the array. Say so, and the graph records only that:"}]},{"t":"code","lines":[{"tokens":[{"text":"const","kind":"keyword"},{"text":" { ","kind":"punctuation"},{"text":"TaskStats"},{"text":" } ","kind":"punctuation"},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftService","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  { name: ","kind":"punctuation"},{"text":"'TaskStats'","kind":"punctuation"},{"text":", providedIn: ","kind":"punctuation"},{"text":"'function'","kind":"punctuation"},{"text":" },","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"function*","kind":"keyword"},{"text":" () {","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"fetchAll"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"yield*","kind":"keyword"},{"text":" TaskApi.","kind":"punctuation"},{"text":"fetchAll","kind":"function"},{"text":"(); ","kind":"punctuation"},{"text":"// one property","kind":"comment"}]},{"tokens":[{"text":"    ","kind":"punctuation"},{"text":"// …","kind":"comment"}]},{"tokens":[{"text":"  },","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"A test for "},{"t":"code","text":"TaskStats"},{"t":"text","text":" then has to mock "},{"t":"code","text":"fetchAll"},{"t":"text","text":" and nothing else."}]},{"t":"heading","level":2,"id":"what-you-gained","children":[{"t":"text","text":"What you gained"}]},{"t":"paragraph","children":[{"t":"text","text":"The mental model: "},{"t":"strong","children":[{"t":"text","text":"declare with a name, drive with "},{"t":"code","text":"yield*"},{"t":"text","text":", derive the rest."}]},{"t":"text","text":""},{"t":"text","text":" "},{"t":"text","text":"Every remaining step is a variation on it — "},{"t":"code","text":"query"},{"t":"text","text":" yields, "},{"t":"code","text":"mutation"},{"t":"text","text":" yields,"},{"t":"text","text":" "},{"t":"text","text":"guards yield, route providers yield."}]},{"t":"callout","tone":"tip","caption":"Going deeper","children":[{"t":"paragraph","children":[{"t":"code","text":"craftGen"},{"t":"text","text":" lets you write a standalone generator outside a service — useful for"},{"t":"text","text":" "},{"t":"text","text":"guards and route helpers. See "},{"t":"link","href":"/craft/guide/concepts/generators","external":false,"children":[{"t":"text","text":"Generators"}]},{"t":"text","text":"."}]}]},{"t":"row","layout":"between","children":[{"t":"paragraph","children":[{"t":"link","href":"/craft/learn/03-service","external":false,"children":[{"t":"text","text":"← 3. Move logic out of the component"}]}]},{"t":"paragraph","children":[{"t":"link","href":"/craft/learn/05-load-data","external":false,"children":[{"t":"text","text":"5. Load server data →"}]}]}]}],"outline":[{"level":2,"id":"the-problem-yield-solves","text":"The problem yield* solves"},{"level":2,"id":"why-a-generator","text":"Why a generator?"},{"level":2,"id":"composing-two-services","text":"Composing two services"},{"level":2,"id":"taking-only-what-you-need","text":"Taking only what you need"},{"level":2,"id":"what-you-gained","text":"What you gained"}]}