nctuation"},{"text":"click","kind":"function"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"goToTask","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"'1'","kind":"punctuation"},{"text":") }, ","kind":"punctuation"},{"text":"'Open task 1'","kind":"punctuation"},{"text":");","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The target is "},{"t":"code","text":"{ to, params?, queryParams? }"},{"t":"text","text":", and all of it is checked:"}]},{"t":"code","lines":[{"tokens":[{"text":"router.","kind":"punctuation"},{"text":"navigate","kind":"function"},{"text":"({ to: ","kind":"punctuation"},{"text":"'taks'","kind":"punctuation"},{"text":" }); ","kind":"punctuation"},{"text":"// ✗ not a known path","kind":"comment"}]},{"tokens":[{"text":"router.","kind":"punctuation"},{"text":"navigate","kind":"function"},{"text":"({ to: ","kind":"punctuation"},{"text":"'tasks/:taskId'","kind":"punctuation"},{"text":" }); ","kind":"punctuation"},{"text":"// ✗ params.taskId is missing","kind":"comment"}]},{"tokens":[{"text":"router.","kind":"punctuation"},{"text":"navigate","kind":"function"},{"text":"({ to: ","kind":"punctuation"},{"text":"'tasks/:taskId'","kind":"punctuation"},{"text":", params: { id: ","kind":"punctuation"},{"text":"'1'","kind":"punctuation"},{"text":" } }); ","kind":"punctuation"},{"text":"// ✗ wrong param","kind":"comment"}]},{"tokens":[{"text":"router.","kind":"punctuation"},{"text":"navigate","kind":"function"},{"text":"({ to: ","kind":"punctuation"},{"text":"'tasks/:taskId'","kind":"punctuation"},{"text":", params: { taskId: ","kind":"punctuation"},{"text":"'1'","kind":"punctuation"},{"text":" } }); ","kind":"punctuation"},{"text":"// ✓","kind":"comment"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Note that "},{"t":"code","text":"navigate"},{"t":"text","text":" comes from "},{"t":"strong","children":[{"t":"text","text":"yielding"}]},{"t":"text","text":" "},{"t":"code","text":"CraftRouter"},{"t":"text","text":", not from injecting"},{"t":"text","text":" "},{"t":"text","text":"it — so the dependency is tracked and the route check can see it."}]},{"t":"heading","level":2,"id":"the-check-that-pays-for-all-of-this","children":[{"t":"text","text":"The check that pays for all of this"}]},{"t":"paragraph","children":[{"t":"text","text":"Each route component gets its own check: "},{"t":"code","text":"RouteCheckedDI"},{"t":"text","text":" compares what the"},{"t":"text","text":" "},{"t":"text","text":"component needs against what is actually available at that path, and "},{"t":"code","text":"CanRun"},{"t":"text","text":" "},{"t":"text","text":"turns a mismatch into a TypeScript error."}]},{"t":"paragraph","children":[{"t":"text","text":"The "},{"t":"code","text":"tasks"},{"t":"text","text":" route created above remains visible as the source of truth; the"},{"t":"text","text":" "},{"t":"text","text":"check below validates that route's component and its "},{"t":"code","text":"path: 'tasks'"},{"t":"text","text":" context."},{"t":"text","text":" "},{"t":"text","text":"An AI can also create this CraftTS routing boilerplate very well — including"},{"t":"text","text":" "},{"t":"text","text":"the lazy import, retry handling, route registry and DI check — from the"},{"t":"text","text":" "},{"t":"text","text":"component and path you provide."}]},{"t":"paragraph","children":[{"t":"text","text":"Declare one local alias for your app's context, then one "},{"t":"code","text":"CanRun"},{"t":"text","text":" per route:"}]},{"t":"code","lines":[{"tokens":[{"text":"import","kind":"keyword"},{"text":" "},{"text":"type","kind":"keyword"},{"text":" { CanRun, ComponentDepsOf, RouteCheckedDI } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'@craft-ts/core'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"type","kind":"keyword"},{"text":" "},{"text":"AppRouteCheckedDI","kind":"type"},{"text":"<","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"Component","kind":"type"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"RouteInputs","kind":"type"},{"text":" "},{"text":"extends","kind":"keyword"},{"text":" "},{"text":"string","kind":"type"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"never","kind":"type"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"Context","kind":"type"},{"text":" "},{"text":"extends","kind":"keyword"},{"text":" "},{"text":"string","kind":"type"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"'app route component'","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"> ","kind":"punctuation"},{"text":"=","kind":"keyword"},{"text":" "},{"text":"RouteCheckedDI","kind":"type"},{"text":"<","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"ComponentDepsOf","kind":"type"},{"text":"<","kind":"punctuation"},{"text":"Component","kind":"type"},{"text":">,","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"'CraftRouter'","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"CraftRouter","kind":"type"},{"text":" "},{"text":"|","kind":"keyword"},{"text":" "},{"text":"ActivatedRoute","kind":"type"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"Context","kind":"type"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"RouteInputs","kind":"type"}]},{"tokens":[{"text":">;","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"type","kind":"keyword"},{"text":" "},{"text":"_CanRunTasks","kind":"type"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"CanRun","kind":"type"},{"text":"<","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"AppRouteCheckedDI","kind":"type"},{"text":"<","kind":"punctuation"}]},{"tokens":[{"text":"    (","kind":"punctuation"},{"text":"typeof","kind":"keyword"},{"text":" "},{"text":"import","kind":"keyword"},{"text":"(","kind":"punctuation"},{"text":"'./tasks/tasks'","kind":"punctuation"},{"text":"))[","kind":"punctuation"},{"text":"'default'","kind":"punctuation"},{"text":"],","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"never","kind":"type"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"'path: \"tasks\"'","kind":"punctuation"}]},{"tokens":[{"text":"  >","kind":"punctuation"}]},{"tokens":[{"text":">;","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The alias fixes the ambient context once — what the app provides by name"},{"t":"text","text":" "},{"t":"text","text":"("},{"t":"code","text":"'CraftRouter'"},{"t":"text","text":") and by value ("},{"t":"code","text":"Router | ActivatedRoute"},{"t":"text","text":"). Each route then"},{"t":"text","text":" "},{"t":"text","text":"supplies three things: the component, the "},{"t":"strong","children":[{"t":"text","text":"route inputs"}]},{"t":"text","text":" it may bind (a path"},{"t":"text","text":" "},{"t":"text","text":"param like "},{"t":"code","text":"'taskId'"},{"t":"text","text":", or "},{"t":"code","text":"never"},{"t":"text","text":"), and a label used in error messages."}]},{"t":"paragraph","children":[{"t":"text","text":"A mismatch reads like this:"}]},{"t":"code","lines":[{"tokens":[{"text":"The TaskList service is not provided in path: \"tasks\""}]},{"tokens":[{"text":"Input \"taskId\" is not provided in path: \"tasks\""}]}],"filename":"","language":"","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Remember step 3, where "},{"t":"code","text":"toProvide"},{"t":"text","text":" was flagged as failing only at runtime? This"},{"t":"text","text":" "},{"t":"text","text":"is what closes that hole — "},{"t":"strong","children":[{"t":"text","text":"provided the proof stays in the file"}]},{"t":"text","text":". A "},{"t":"code","text":"CanRun"},{"t":"text","text":" "},{"t":"text","text":"alias that nobody references still compiles; "},{"t":"link","href":"/craft/guide/testing/architecture#assertroutediproofs","external":false,"children":[{"t":"text","text":"architecture"},{"t":"text","text":" "},{"t":"text","text":"tests"}]},{"t":"text","text":" are what turn omitting"},{"t":"text","text":" "},{"t":"text","text":"it into a failing suite."}]},{"t":"callout","tone":"tip","caption":"Why one check per route","children":[{"t":"paragraph","children":[{"t":"code","text":"RouteCheckedDI"},{"t":"text","text":" validates a single component with no recursion between routes,"},{"t":"text","text":" "},{"t":"text","text":"so the cost is flat: a file with two hundred routes costs two hundred"},{"t":"text","text":" "},{"t":"text","text":"independent checks and never hits TypeScript's instantiation ceiling. See"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/routing/scaling","external":false,"children":[{"t":"text","text":"Scaling routes"}]},{"t":"text","text":"."}]}]},{"t":"heading","level":2,"id":"prove-the-exceptions-are-handled","children":[{"t":"text","text":"Prove the exceptions are handled"}]},{"t":"paragraph","children":[{"t":"text","text":"Guards, matchers and resolvers can raise a "},{"t":"code","text":"craftException"},{"t":"text","text":" — and so can a"},{"t":"text","text":" "},{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"component's own factory or providers"}]},{"t":"text","text":", whose unhandled codes flow up into the"},{"t":"text","text":" "},{"t":"text","text":"route. One call asserts that every reachable code has a handler, and that no"},{"t":"text","text":" "},{"t":"text","text":"handler exists for a code nothing produces:"}]},{"t":"code","lines":[{"tokens":[{"text":"assertExhaustiveRouteExceptions","kind":"function"},{"text":"(appRoutes);","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The ESLint rule "},{"t":"code","text":"craft-ts/require-assert-exhaustive-route-exceptions"},{"t":"text","text":" adds it"},{"t":"text","text":" "},{"t":"text","text":"for you."}]},{"t":"paragraph","children":[{"t":"text","text":"A component can also handle its own codes with "},{"t":"code","text":".pipe(catchTag.exhaustive(...))"},{"t":"text","text":","},{"t":"text","text":" "},{"t":"text","text":"which removes them from the route's union — see "},{"t":"link","href":"/craft/guide/concepts/exceptions","external":false,"children":[{"t":"text","text":"An unhandled exception doesn't"},{"t":"text","text":" "},{"t":"text","text":"just disappear"}]},{"t":"text","text":". Everything else is on"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/routing/exception-handling","external":false,"children":[{"t":"text","text":"Route exception handling"}]},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"wire-it-into-the-app","children":[{"t":"text","text":"Wire it into the app"}]},{"t":"code","lines":[{"tokens":[{"text":"import","kind":"keyword"},{"text":" { craftAppConfig } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'@craft-ts/core'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"appConfig"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftAppConfig","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"  providers: [","kind":"punctuation"},{"text":"provideRouter","kind":"function"},{"text":"(appRoutes.","kind":"punctuation"},{"text":"toRoutes","kind":"function"},{"text":"(), )],","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"toRoutes()"},{"t":"text","text":" returns the runtime routes; "},{"t":"code","text":"META_DATA"},{"t":"text","text":" carries the compile-time"},{"t":"text","text":" "},{"t":"text","text":"graph to "},{"t":"code","text":"craftAppConfig"},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"make-the-di-contract-enforceable","children":[{"t":"text","text":"Make the DI contract enforceable"}]},{"t":"paragraph","children":[{"t":"text","text":"The proofs above look ceremonial: unused type aliases, a "},{"t":"code","text":"CanRun"},{"t":"text","text":" wrapper, a"},{"t":"text","text":" "},{"t":"text","text":"cascade that does not descend into "},{"t":"code","text":"loadChildren"},{"t":"text","text":", a separate check for pending"},{"t":"text","text":" "},{"t":"text","text":"and error screens, another for "},{"t":"code","text":"app.config"},{"t":"text","text":". Each piece is small; omitting one"},{"t":"text","text":" "},{"t":"text","text":"is silent. TypeScript still compiles."}]},{"t":"paragraph","children":[{"t":"text","text":"Architecture tests collapse that checklist into a single assertion."},{"t":"text","text":" "},{"t":"code","text":"assertRouteDiProofs"},{"t":"text","text":" walks the static graph and fails unless every routed"},{"t":"text","text":" "},{"t":"text","text":"component — including lazy child collections — and every "},{"t":"code","text":"craftAppConfig"},{"t":"text","text":" error"},{"t":"text","text":" "},{"t":"text","text":"screen is hooked to an armed mapper. TypeScript still judges whether a"},{"t":"text","text":" "},{"t":"text","text":"dependency is provided; the architecture suite judges whether that judgement"},{"t":"text","text":" "},{"t":"text","text":"was invoked."}]},{"t":"paragraph","children":[{"t":"text","text":"Add it next to "},{"t":"code","text":"e2e/"},{"t":"text","text":", in "},{"t":"code","text":"architecture/"},{"t":"text","text":", then run it in CI. Full setup:"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/testing/architecture","external":false,"children":[{"t":"text","text":"Architecture rules"}]},{"t":"text","text":"."}]},{"t":"heading","level":2,"id":"what-the-user-sees-while-a-route-loads","children":[{"t":"text","text":"What the user sees while a route loads"}]},{"t":"paragraph","children":[{"t":"text","text":"A guard or a resolver that does real work leaves the app frozen on the previous"},{"t":"text","text":" "},{"t":"text","text":"page. Swap "},{"t":"code","text":"provideRouter"},{"t":"text","text":" for "},{"t":"code","text":"provideCraftRouter"},{"t":"text","text":" and render"},{"t":"text","text":" "},{"t":"code","text":"CraftRouterOutlet()"},{"t":"text","text":" instead of "},{"t":"code","text":"<router-outlet>"},{"t":"text","text":", and the URL commits"},{"t":"text","text":" "},{"t":"text","text":"immediately while the chain runs behind it:"}]},{"t":"code","lines":[{"tokens":[{"text":"import","kind":"keyword"},{"text":" { craftAppConfig, provideCraftRouter, withTransitionTimings } ","kind":"punctuation"},{"text":"from","kind":"keyword"},{"text":" "},{"text":"'@craft-ts/core'","kind":"punctuation"},{"text":";","kind":"punctuation"}]},{"tokens":[]},{"tokens":[{"text":"export","kind":"keyword"},{"text":" "},{"text":"const","kind":"keyword"},{"text":" "},{"text":"appConfig"},{"text":" "},{"text":"=","kind":"keyword"},{"text":" "},{"text":"craftAppConfig","kind":"function"},{"text":"({","kind":"punctuation"}]},{"tokens":[{"text":"  providers: [","kind":"punctuation"}]},{"tokens":[{"text":"    "},{"text":"provideCraftRouter","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"      appRoutes.","kind":"punctuation"},{"text":"toRoutes","kind":"function"},{"text":"(),","kind":"punctuation"}]},{"tokens":[{"text":"      "},{"text":"withTransitionTimings","kind":"function"},{"text":"({ stayMs: ","kind":"punctuation"},{"text":"300","kind":"number"},{"text":", blankMs: ","kind":"punctuation"},{"text":"300","kind":"number"},{"text":", pendingMinMs: ","kind":"punctuation"},{"text":"500","kind":"number"},{"text":" }),","kind":"punctuation"}]},{"tokens":[{"text":"    ),","kind":"punctuation"}]},{"tokens":[{"text":"  ],","kind":"punctuation"}]},{"tokens":[{"text":"});","kind":"punctuation"}]}],"filename":"","language":"ts","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Those three numbers are the whole waiting story, and they exist so a fast"},{"t":"text","text":" "},{"t":"text","text":"navigation shows "},{"t":"strong","children":[{"t":"text","text":"nothing at all"}]},{"t":"text","text":":"}]},{"t":"table","head":[[{"t":"text","text":"Phase"}],[{"t":"text","text":"What is on screen"}]],"rows":[[[{"t":"code","text":"0 → stayMs"}],[{"t":"text","text":"the previous page — most navigations resolve here"}]],[[{"t":"code","text":"stayMs → +blankMs"}],[{"t":"text","text":"a blank surface: something is coming"}]],[[{"t":"text","text":"beyond, for "},{"t":"code","text":"pendingMinMs"},{"t":"text","text":" at least"}],[{"t":"text","text":"the pending component (a spinner, a skeleton)"}]]]},{"t":"paragraph","children":[{"t":"code","text":"pendingMinMs"},{"t":"text","text":" is the anti-flicker floor: once the loader appears it stays put,"},{"t":"text","text":" "},{"t":"text","text":"so it can't flash for 40ms."}]},{"t":"heading","level":3,"id":"changing-the-pending-component","children":[{"t":"text","text":"Changing the pending component"}]},{"t":"paragraph","children":[{"t":"text","text":"The default spinner is replaceable globally:"}]},{"t":"code","lines":[{"tokens":[{"text":"provideCraftRouter","kind":"function"},{"text":"(","kind":"punctuation"}]},{"tokens":[{"text":"  appRoutes.","kind":"punctuation"},{"text":"toRoutes","kind":"function"},{"text":"(),","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"withPendingComponent","kind":"function"},{"text":"(MyBrandedSpinner),","kind":"punctuation"}]},{"tokens":[{"text":");","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"…or per route, which is where it gets interesting — a skeleton shaped like the"},{"t":"text","text":" "},{"t":"text","text":"page it is standing in for reads far better than a spinner:"}]},{"t":"code","lines":[{"tokens":[{"text":"{","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"path"},{"text":": ","kind":"punctuation"},{"text":"'tasks'","kind":"punctuation"},{"text":",","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"...","kind":"keyword"},{"text":"loadCraftComponent","kind":"function"},{"text":"(","kind":"punctuation"},{"text":"/* … */","kind":"punctuation"},{"text":"),","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"pendingComponent"},{"text":": () ","kind":"punctuation"},{"text":"=>","kind":"keyword"},{"text":" "},{"text":"import","kind":"keyword"},{"text":"(","kind":"punctuation"},{"text":"'./tasks/tasks-skeleton'","kind":"punctuation"},{"text":"),","kind":"punctuation"}]},{"tokens":[{"text":"  "},{"text":"stayMs"},{"text":": ","kind":"punctuation"},{"text":"150","kind":"number"},{"text":", ","kind":"punctuation"},{"text":"// this route is slower: get to the skeleton sooner","kind":"comment"}]},{"tokens":[{"text":"  "},{"text":"blankMs"},{"text":": ","kind":"punctuation"},{"text":"0","kind":"number"},{"text":",  ","kind":"punctuation"},{"text":"// and skip the blank phase entirely","kind":"comment"}]},{"tokens":[{"text":"}","kind":"punctuation"}]}],"filename":"","language":"typescript","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Route-level values override the global ones, so you tune only the routes that"},{"t":"text","text":" "},{"t":"text","text":"need it."}]},{"t":"callout","tone":"tip","caption":"See it running","children":[{"t":"paragraph","children":[{"t":"text","text":"The "},{"t":"code","text":"slow-page"},{"t":"text","text":" demo exists for exactly this: two deliberately slow steps (~1.5s"},{"t":"text","text":" "},{"t":"text","text":"each) so you can watch the stay → blank → loader phases play out. The first"},{"t":"text","text":" "},{"t":"text","text":"visit is slow, a revisit is instant thanks to the query cache, and a \"clear"},{"t":"text","text":" "},{"t":"text","text":"cache\" button replays it. Source:"},{"t":"text","text":" "},{"t":"link","href":"https://github.com/craft-ts/craft-ts/blob/main/apps/demo/src/app/examples/routes/slow-page/slow-page.routes.ts","external":true,"children":[{"t":"text","text":"slow-page.routes.ts"}]},{"t":"text","text":"."}]},{"t":"paragraph","children":[{"t":"text","text":"Full details — the phase diagram, per-route overrides, view transitions and the"},{"t":"text","text":" "},{"t":"text","text":"DI check on skeletons — are on"},{"t":"text","text":" "},{"t":"link","href":"/craft/guide/routing/pending-ui","external":false,"children":[{"t":"text","text":"Non-blocking navigation"}]},{"t":"text","text":"."}]}]},{"t":"heading","level":2,"id":"let-the-cli-write-it","children":[{"t":"text","text":"Let the CLI write it"}]},{"t":"paragraph","children":[{"t":"text","text":"Hand-writing these pieces gets old. The CLI does it for you and the output stays"},{"t":"text","text":" "},{"t":"text","text":"ordinary, editable TypeScript:"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft","kind":"string"},{"text":" "},{"text":"route","kind":"string"},{"text":" "},{"text":"add","kind":"string"},{"text":" "},{"text":"/tasks","kind":"string"},{"text":" "},{"text":"--create-component","kind":"string"},{"text":" "},{"text":"tasks/tasks","kind":"string"}]}],"filename":"","language":"shell","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"It picks the right collection, creates a lazy routes file per feature, adds the"},{"t":"text","text":" "},{"t":"text","text":"loader, the check block and the registry entry, then runs ESLint and "},{"t":"code","text":"tsc"},{"t":"text","text":". Use"},{"t":"text","text":" "},{"t":"code","text":"--dry-run"},{"t":"text","text":" first."}]},{"t":"heading","level":2,"id":"what-you-gained","children":[{"t":"text","text":"What you gained"}]},{"t":"paragraph","children":[{"t":"text","text":"Routing where a forgotten provider, a misspelled input, an unhandled exception or"},{"t":"text","text":" "},{"t":"text","text":"a route pointing at nothing stops the build instead of reaching production — and"},{"t":"text","text":" "},{"t":"text","text":"architecture tests keep those proofs from quietly disappearing."}]},{"t":"details","summary":"The parts you'll want later","children":[{"t":"paragraph","children":[{"t":"text","text":"Route-scoped providers, guards as bare generators and centralised exception"},{"t":"text","text":" "},{"t":"text","text":"handling all live under "},{"t":"link","href":"/craft/guide/routing/setup","external":false,"children":[{"t":"text","text":"Routing"}]},{"t":"text","text":". Splitting a growing collection across lazy"},{"t":"text","text":" "},{"t":"text","text":"child files is "},{"t":"link","href":"/craft/guide/routing/scaling","external":false,"children":[{"t":"text","text":"Scaling routes"}]},{"t":"text","text":". Architecture tests that keep the DI proofs"},{"t":"text","text":" "},{"t":"text","text":"armed are "},{"t":"link","href":"/craft/guide/testing/architecture","external":false,"children":[{"t":"text","text":"Architecture rules"}]},{"t":"text","text":"."}]}]},{"t":"row","layout":"between","children":[{"t":"paragraph","children":[{"t":"link","href":"/craft/learn/08-forms","external":false,"children":[{"t":"text","text":"← 8. Build a form"}]}]},{"t":"paragraph","children":[{"t":"link","href":"/craft/learn/10-testing","external":false,"children":[{"t":"text","text":"10. Test what you wrote →"}]}]}]}],"outline":[{"level":2,"id":"declare-the-route","text":"Declare the route"},{"level":2,"id":"register-the-paths","text":"Register the paths"},{"level":2,"id":"navigating","text":"Navigating"},{"level":2,"id":"the-check-that-pays-for-all-of-this","text":"The check that pays for all of this"},{"level":2,"id":"prove-the-exceptions-are-handled","text":"Prove the exceptions are handled"},{"level":2,"id":"wire-it-into-the-app","text":"Wire it into the app"},{"level":2,"id":"make-the-di-contract-enforceable","text":"Make the DI contract enforceable"},{"level":2,"id":"what-the-user-sees-while-a-route-loads","text":"What the user sees while a route loads"},{"level":3,"id":"changing-the-pending-component","text":"Changing the pending component"},{"level":2,"id":"let-the-cli-write-it","text":"Let the CLI write it"},{"level":2,"id":"what-you-gained","text":"What you gained"}]}