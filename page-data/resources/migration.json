{"kind":"doc","route":"/resources/migration","title":"Migrating an existing application","blocks":[{"t":"heading","level":1,"id":"migrating-an-existing-application","children":[{"t":"text","text":"Migrating an existing application"}]},{"t":"paragraph","children":[{"t":"code","text":"craft-migrate"},{"t":"text","text":" runs the CraftTS codemods in a safe, explicit order:"}]},{"t":"list","ordered":true,"items":[[{"t":"paragraph","children":[{"t":"text","text":"primitive migration points"}]}],[{"t":"paragraph","children":[{"t":"text","text":"service composition"}]}],[{"t":"paragraph","children":[{"t":"text","text":"typed route collections and dependency checks"}]}],[{"t":"paragraph","children":[{"t":"text","text":"legacy "},{"t":"code","text":"component(...)"},{"t":"text","text":" factories to "},{"t":"code","text":"craftComponent(name, meta, template)"},{"t":"text","text":","},{"t":"text","text":" "},{"t":"text","text":"folding a logic factory into the template generator"}]}],[{"t":"paragraph","children":[{"t":"text","text":"baseline architecture tests"}]}]]},{"t":"paragraph","children":[{"t":"text","text":"The migration is intentionally conservative. Deterministic transformations are"},{"t":"text","text":" "},{"t":"text","text":"written automatically; code requiring a business or lifecycle decision is"},{"t":"text","text":" "},{"t":"text","text":"reported as a manual diagnostic."}]},{"t":"heading","level":2,"id":"install-the-migration-tool","children":[{"t":"text","text":"Install the migration tool"}]},{"t":"code","lines":[{"tokens":[{"text":"npm","kind":"function"},{"text":" "},{"text":"install","kind":"string"},{"text":" "},{"text":"@craft-ts/core","kind":"string"}]},{"tokens":[{"text":"npm","kind":"function"},{"text":" "},{"text":"install","kind":"string"},{"text":" "},{"text":"--save-dev","kind":"string"},{"text":" "},{"text":"@craft-ts/dev-tools@beta","kind":"string"}]}],"filename":"","language":"shell","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The migration binaries are available from the "},{"t":"code","text":"beta"},{"t":"text","text":" tag. Verify the resolved"},{"t":"text","text":" "},{"t":"text","text":"version before starting:"}]},{"t":"code","lines":[{"tokens":[{"text":"npm","kind":"function"},{"text":" "},{"text":"ls","kind":"string"},{"text":" "},{"text":"@craft-ts/dev-tools","kind":"string"}]}],"filename":"","language":"shell","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Point the coding agent at "},{"t":"link","href":"/craft/resources/ai-agents","external":false,"children":[{"t":"text","text":"coding agents"}]},{"t":"text","text":" so it uses"},{"t":"text","text":" "},{"t":"code","text":"craft-migrate"},{"t":"text","text":" through the "},{"t":"code","text":"migrate-to-craft-ts"},{"t":"text","text":" skill. The final step"},{"t":"text","text":" "},{"t":"text","text":"scaffolds the "},{"t":"link","href":"/craft/guide/testing/architecture","external":false,"children":[{"t":"text","text":"architecture suite"}]},{"t":"text","text":" as the graph"},{"t":"text","text":" "},{"t":"text","text":"contract. Do not add one architecture rule per migrated feature."}]},{"t":"paragraph","children":[{"t":"text","text":"Commit or stash the current application changes before writing a migration."},{"t":"text","text":" "},{"t":"text","text":"The codemod does not revert unrelated local changes."}]},{"t":"heading","level":2,"id":"preview-the-migration","children":[{"t":"text","text":"Preview the migration"}]},{"t":"paragraph","children":[{"t":"text","text":"Run the command from the application workspace:"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-migrate","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--project","kind":"string"},{"text":" "},{"text":"tsconfig.app.json","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--root","kind":"string"},{"text":" "},{"text":"src","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--dry-run","kind":"string"}]}],"filename":"","language":"shell","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Use a JSON report when diagnostics need to be reviewed or archived:"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-migrate","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--project","kind":"string"},{"text":" "},{"text":"tsconfig.app.json","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--root","kind":"string"},{"text":" "},{"text":"src","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--dry-run","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--json","kind":"string"},{"text":" "},{"text":"migration-report.json","kind":"string"}]}],"filename":"","language":"shell","numbered":false,"firstLine":1},{"t":"heading","level":2,"id":"apply-the-migration","children":[{"t":"text","text":"Apply the migration"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-migrate","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--project","kind":"string"},{"text":" "},{"text":"tsconfig.app.json","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--root","kind":"string"},{"text":" "},{"text":"src","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--write","kind":"string"}]}],"filename":"","language":"shell","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"--write"},{"t":"text","text":" runs ESLint fixes on files touched by the primitive and service"},{"t":"text","text":" "},{"t":"text","text":"migrations. Use "},{"t":"code","text":"--no-eslint"},{"t":"text","text":" only when linting is managed separately."}]},{"t":"paragraph","children":[{"t":"text","text":"The specialized commands remain available when a migration must be applied or"},{"t":"text","text":" "},{"t":"text","text":"debugged one stage at a time:"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-migrate-primitives","kind":"string"},{"text":" "},{"text":"--project","kind":"string"},{"text":" "},{"text":"tsconfig.app.json","kind":"string"},{"text":" "},{"text":"--root","kind":"string"},{"text":" "},{"text":"src","kind":"string"},{"text":" "},{"text":"--write","kind":"string"}]},{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-migrate-services","kind":"string"},{"text":" "},{"text":"--project","kind":"string"},{"text":" "},{"text":"tsconfig.app.json","kind":"string"},{"text":" "},{"text":"--root","kind":"string"},{"text":" "},{"text":"src","kind":"string"},{"text":" "},{"text":"--write","kind":"string"}]},{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-migrate-streams","kind":"string"},{"text":" "},{"text":"--project","kind":"string"},{"text":" "},{"text":"tsconfig.app.json","kind":"string"},{"text":" "},{"text":"--root","kind":"string"},{"text":" "},{"text":"src","kind":"string"},{"text":" "},{"text":"--write","kind":"string"}]},{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-migrate-routes","kind":"string"},{"text":" "},{"text":"--project","kind":"string"},{"text":" "},{"text":"tsconfig.app.json","kind":"string"},{"text":" "},{"text":"--root","kind":"string"},{"text":" "},{"text":"src","kind":"string"},{"text":" "},{"text":"--write","kind":"string"}]},{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-migrate-components","kind":"string"},{"text":" "},{"text":"--project","kind":"string"},{"text":" "},{"text":"tsconfig.app.json","kind":"string"},{"text":" "},{"text":"--root","kind":"string"},{"text":" "},{"text":"src","kind":"string"},{"text":" "},{"text":"--write","kind":"string"}]},{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-migrate-architecture","kind":"string"},{"text":" "},{"text":"--project","kind":"string"},{"text":" "},{"text":"tsconfig.app.json","kind":"string"},{"text":" "},{"text":"--root","kind":"string"},{"text":" "},{"text":"src","kind":"string"},{"text":" "},{"text":"--write","kind":"string"}]}],"filename":"","language":"shell","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"code","text":"craft-migrate-streams"},{"t":"text","text":" rewrites RxJS pipelines to "},{"t":"link","href":"/craft/guide/reactivity/streams#migrating-from-rxjs","external":false,"children":[{"t":"code","text":"@craft-ts/stream"}]},{"t":"text","text":"."},{"t":"text","text":" "},{"t":"text","text":"It is not part of the aggregate "},{"t":"code","text":"craft-migrate"},{"t":"text","text":" run: it is all-or-nothing per file and leaves"},{"t":"text","text":" "},{"t":"text","text":"any file it cannot fully migrate untouched, with a diagnostic."}]},{"t":"paragraph","children":[{"t":"text","text":"For a pasted HTML or Web Component snippet, use the standalone template"},{"t":"text","text":" "},{"t":"text","text":"converter:"}]},{"t":"code","lines":[{"tokens":[{"text":"printf","kind":"function"},{"text":" "},{"text":"'<section><h2>Hello</h2></section>'","kind":"punctuation"},{"text":" "},{"text":"|","kind":"keyword"},{"text":" "},{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-migrate-template","kind":"string"}]}],"filename":"","language":"shell","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"The generated callback can be pasted as the third argument of"},{"t":"text","text":" "},{"t":"code","text":"craftComponent(...)"},{"t":"text","text":". The interactive "},{"t":"link","href":"/craft/guide/components/template-migrator","external":false,"children":[{"t":"text","text":"template converter"}]},{"t":"text","text":" "},{"t":"text","text":"uses the same converter."}]},{"t":"heading","level":2,"id":"work-remaining-after-the-codemod","children":[{"t":"text","text":"Work remaining after the codemod"}]},{"t":"paragraph","children":[{"t":"text","text":"Search the generated report and source code for migration diagnostics. Complete"},{"t":"text","text":" "},{"t":"text","text":"the following before considering the migration done:"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"Consume every primitive invocation inside a generator with "},{"t":"code","text":"yield*"},{"t":"text","text":", or use"},{"t":"text","text":" "},{"t":"code","text":"craftUse(...)"},{"t":"text","text":" at a synchronous boundary."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Map synchronous validators to "},{"t":"code","text":"cRequired"},{"t":"text","text":", "},{"t":"code","text":"cMaxLength"},{"t":"text","text":", and the other Craft"},{"t":"text","text":" "},{"t":"text","text":"validators."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Replace asynchronous validation with "},{"t":"code","text":"query"},{"t":"text","text":" and "},{"t":"code","text":"cAsyncValidate"},{"t":"text","text":"."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Replace form submission workflows with "},{"t":"code","text":"mutation"},{"t":"text","text":" and "},{"t":"code","text":"insertFormSubmit"},{"t":"text","text":"."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Resolve every "},{"t":"code","text":"CRAFT_IMPLEMENTATION_REQUIRED"},{"t":"text","text":" companion service."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Review service scopes and move "},{"t":"code","text":"provideX(...)"},{"t":"text","text":" close to the route or feature"},{"t":"text","text":" "},{"t":"text","text":"that owns the instance."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Resolve imperative workflow diagnostics instead of only removing comments."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Migrate guards, dynamic redirects, nested route collections, inherited route"},{"t":"text","text":" "},{"t":"text","text":"providers, and other route diagnostics that could not be inferred safely."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Confirm "},{"t":"code","text":"componentDeps"},{"t":"text","text":", route provider names, and file-level DI checks."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Review HTTP mutations and subscriptions whose lifecycle semantics could not be"},{"t":"text","text":" "},{"t":"text","text":"moved automatically."}]}],[{"t":"paragraph","children":[{"t":"text","text":"Add app-specific graph lookups in "},{"t":"code","text":"architecture.spec.ts"},{"t":"text","text":"."}]}]]},{"t":"heading","level":2,"id":"verify-the-result","children":[{"t":"text","text":"Verify the result"}]},{"t":"paragraph","children":[{"t":"text","text":"First make remaining migration work fail CI:"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"craft-migrate","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--project","kind":"string"},{"text":" "},{"text":"tsconfig.app.json","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--root","kind":"string"},{"text":" "},{"text":"src","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--check","kind":"string"},{"text":" "},{"text":"\\"}]},{"tokens":[{"text":"  "},{"text":"--fail-on-manual","kind":"string"}]}],"filename":"","language":"shell","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Then run the normal project verification:"}]},{"t":"code","lines":[{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"eslint","kind":"string"},{"text":" "},{"text":"\"src/**/*.ts\"","kind":"punctuation"}]},{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"tsc","kind":"string"},{"text":" "},{"text":"--noEmit","kind":"string"},{"text":" "},{"text":"-p","kind":"string"},{"text":" "},{"text":"tsconfig.app.json","kind":"string"}]},{"tokens":[{"text":"npx","kind":"function"},{"text":" "},{"text":"vitest","kind":"string"},{"text":" "},{"text":"run","kind":"string"},{"text":" "},{"text":"--config","kind":"string"},{"text":" "},{"text":"vitest.architecture.config.ts","kind":"string"}]}],"filename":"","language":"shell","numbered":false,"firstLine":1},{"t":"paragraph","children":[{"t":"text","text":"Use the workspace-specific lint, test, and build commands when they differ."},{"t":"text","text":" "},{"t":"text","text":"Finally, exercise forms, navigation, pending/error UI, and write operations in"},{"t":"text","text":" "},{"t":"text","text":"the browser: those lifecycle behaviours cannot be fully established by a"},{"t":"text","text":" "},{"t":"text","text":"structural codemod."}]}],"outline":[{"level":2,"id":"install-the-migration-tool","text":"Install the migration tool"},{"level":2,"id":"preview-the-migration","text":"Preview the migration"},{"level":2,"id":"apply-the-migration","text":"Apply the migration"},{"level":2,"id":"work-remaining-after-the-codemod","text":"Work remaining after the codemod"},{"level":2,"id":"verify-the-result","text":"Verify the result"}]}