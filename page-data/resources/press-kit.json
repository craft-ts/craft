{"kind":"doc","route":"/resources/press-kit","title":"Press Kit","blocks":[{"t":"heading","level":1,"id":"press-kit","children":[{"t":"text","text":"Press Kit"}]},{"t":"paragraph","children":[{"t":"text","text":"Resources and information about "},{"t":"code","text":"@craft-ts/core"},{"t":"text","text":" for articles, presentations,"},{"t":"text","text":" "},{"t":"text","text":"and sharing."}]},{"t":"heading","level":2,"id":"project-description","children":[{"t":"text","text":"Project description"}]},{"t":"heading","level":3,"id":"short-description","children":[{"t":"text","text":"Short description"}]},{"t":"paragraph","children":[{"t":"code","text":"@craft-ts/core"},{"t":"text","text":" is a reactive TypeScript toolkit for URL, client, and server"},{"t":"text","text":" "},{"t":"text","text":"state. Its primitives make dependencies explicit and keep application code"},{"t":"text","text":" "},{"t":"text","text":"fully type-safe."}]},{"t":"heading","level":3,"id":"long-description","children":[{"t":"text","text":"Long description"}]},{"t":"paragraph","children":[{"t":"code","text":"@craft-ts/core"},{"t":"text","text":" brings state, asynchronous work, services, forms, routing, and"},{"t":"text","text":" "},{"t":"text","text":"testing into one composable model. Named generators and typed insertions make"},{"t":"text","text":" "},{"t":"text","text":"the dependency graph visible to both the compiler and development tools. The"},{"t":"text","text":" "},{"t":"text","text":"result is granular reactivity, typed failures, optimistic updates, persistence,"},{"t":"text","text":" "},{"t":"text","text":"and predictable loading states without repetitive coordination code."}]},{"t":"heading","level":2,"id":"key-features","children":[{"t":"text","text":"Key features"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":"✅ "},{"t":"strong","children":[{"t":"text","text":"Type-safe"}]},{"t":"text","text":" — TypeScript inference minimizes manual declarations"}]}],[{"t":"paragraph","children":[{"t":"text","text":"✅ "},{"t":"strong","children":[{"t":"text","text":"Composable"}]},{"t":"text","text":" — primitives and insertions share one composition model"}]}],[{"t":"paragraph","children":[{"t":"text","text":"✅ "},{"t":"strong","children":[{"t":"text","text":"Granular"}]},{"t":"text","text":" — updates target the readers that actually depend on them"}]}],[{"t":"paragraph","children":[{"t":"text","text":"✅ "},{"t":"strong","children":[{"t":"text","text":"Declarative"}]},{"t":"text","text":" — state, effects, forms, and routes are explicit data"}]}],[{"t":"paragraph","children":[{"t":"text","text":"✅ "},{"t":"strong","children":[{"t":"text","text":"Observable"}]},{"t":"text","text":" — the same graph powers logging, tracing, and diagnostics"}]}],[{"t":"paragraph","children":[{"t":"text","text":"✅ "},{"t":"strong","children":[{"t":"text","text":"Testable"}]},{"t":"text","text":" — services, components, and architecture contracts can be tested independently"}]}]]},{"t":"heading","level":2,"id":"logo-and-brand-assets","children":[{"t":"text","text":"Logo and brand assets"}]},{"t":"paragraph","children":[{"t":"image","src":"/craft/assets/craft-ts-logo.png","alt":"craft-ts Logo"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"link","href":"/craft/assets/craft-ts-logo.png","external":false,"children":[{"t":"text","text":"Download logo"}]}]}]]},{"t":"heading","level":2,"id":"installation","children":[{"t":"text","text":"Installation"}]},{"t":"code","lines":[{"tokens":[{"text":"npm","kind":"function"},{"text":" "},{"text":"i","kind":"string"},{"text":" "},{"text":"@craft-ts/core@beta","kind":"string"}]}],"filename":"","language":"shell","numbered":false,"firstLine":1},{"t":"heading","level":2,"id":"links","children":[{"t":"text","text":"Links"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"GitHub"}]},{"t":"text","text":": "},{"t":"link","href":"https://github.com/craft-ts/craft-ts","external":true,"children":[{"t":"text","text":"github.com/craft-ts/craft-ts"}]}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Documentation"}]},{"t":"text","text":": "},{"t":"link","href":"https://craft-ts.github.io/craft/","external":true,"children":[{"t":"text","text":"craft-ts.github.io/craft/"}]}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"NPM"}]},{"t":"text","text":": "},{"t":"link","href":"https://npmjs.com/package/@craft-ts/core","external":true,"children":[{"t":"text","text":"npmjs.com/package/@craft-ts/core"}]}]}]]},{"t":"heading","level":2,"id":"social-media","children":[{"t":"text","text":"Social media"}]},{"t":"heading","level":3,"id":"linkedin","children":[{"t":"text","text":"LinkedIn"}]},{"t":"code","lines":[{"tokens":[{"text":"Excited to share @craft-ts/core — a type-safe toolkit for state, services,"}]},{"tokens":[{"text":"forms, routing, and asynchronous work."}]},{"tokens":[]},{"tokens":[{"text":"Craft makes dependencies explicit and gives every primitive a predictable"}]},{"tokens":[{"text":"lifecycle, typed failures, and composable behaviour:"}]},{"tokens":[]},{"tokens":[{"text":"• Reactive local and server state"}]},{"tokens":[{"text":"• URL state with typed codecs"}]},{"tokens":[{"text":"• Optimistic mutations"}]},{"tokens":[{"text":"• Typed forms and validation"}]},{"tokens":[{"text":"• Explicit service composition"}]},{"tokens":[{"text":"• Architecture checks and observability"}]},{"tokens":[]},{"tokens":[{"text":"Check it out: [link]"}]},{"tokens":[]},{"tokens":[{"text":"#TypeScript #WebDevelopment #OpenSource"}]}],"filename":"","language":"","numbered":false,"firstLine":1},{"t":"heading","level":2,"id":"license","children":[{"t":"text","text":"License"}]},{"t":"paragraph","children":[{"t":"text","text":"MIT License — free for personal and commercial use."}]},{"t":"heading","level":2,"id":"credits","children":[{"t":"text","text":"Credits"}]},{"t":"paragraph","children":[{"t":"text","text":"Created and maintained by Romain Geffrault."}]},{"t":"heading","level":2,"id":"contact","children":[{"t":"text","text":"Contact"}]},{"t":"list","ordered":false,"items":[[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Issues"}]},{"t":"text","text":": "},{"t":"link","href":"https://github.com/craft-ts/craft-ts/issues","external":true,"children":[{"t":"text","text":"GitHub Issues"}]}]}],[{"t":"paragraph","children":[{"t":"text","text":""},{"t":"strong","children":[{"t":"text","text":"Discussions"}]},{"t":"text","text":": "},{"t":"link","href":"https://github.com/craft-ts/craft-ts/discussions","external":true,"children":[{"t":"text","text":"GitHub Discussions"}]}]}]]}],"outline":[{"level":2,"id":"project-description","text":"Project description"},{"level":3,"id":"short-description","text":"Short description"},{"level":3,"id":"long-description","text":"Long description"},{"level":2,"id":"key-features","text":"Key features"},{"level":2,"id":"logo-and-brand-assets","text":"Logo and brand assets"},{"level":2,"id":"installation","text":"Installation"},{"level":2,"id":"links","text":"Links"},{"level":2,"id":"social-media","text":"Social media"},{"level":3,"id":"linkedin","text":"LinkedIn"},{"level":2,"id":"license","text":"License"},{"level":2,"id":"credits","text":"Credits"},{"level":2,"id":"contact","text":"Contact"}]}